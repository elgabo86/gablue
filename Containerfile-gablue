# Arguments pour configurer l'image de base et ses variantes, tous fournis par le workflow
ARG VARIANT
ARG SOURCE_IMAGE
ARG FEDORA_VERSION
ARG ARCH="${ARCH:-x86_64}"
ARG KERNEL_VERSION="${KERNEL_VERSION:-7.3.1-ogc6.1.fc${FEDORA_VERSION}.${ARCH}}"
ARG KERNEL_FLAVOR
ARG NVIDIA_FLAVOR="nvidia-open"
ARG DX_MODE
ARG IMAGE_DATE

# Étape intermédiaire : scripts de build (bind-mountés dans chaque RUN, jamais dans l'image finale)
FROM scratch AS ctx
COPY --chmod=755 files/scripts /

# Étape intermédiaire : récupération du kernel et des akmods depuis ublue-os
FROM ghcr.io/ublue-os/akmods:${KERNEL_FLAVOR}-${FEDORA_VERSION}-${KERNEL_VERSION} AS akmods
FROM ghcr.io/ublue-os/akmods-extra:${KERNEL_FLAVOR}-${FEDORA_VERSION}-${KERNEL_VERSION} AS akmods-extra

# Étape intermédiaire : récupération des pilotes NVIDIA (nvidia-lts ou nvidia-open)
# Monté conditionnellement selon la variante, toujours tiré pour résoudre les mounts
FROM ghcr.io/ublue-os/akmods-${NVIDIA_FLAVOR}:${KERNEL_FLAVOR}-${FEDORA_VERSION}-${KERNEL_VERSION} AS akmods-nvidia

# Étape intermédiaire : fichiers spécifiques NVIDIA (communs aux variantes nvidia et nvidia-open)
FROM scratch AS nvidia-common-files
COPY files/system/nvidia-common /

# Étape intermédiaire : image Homebrew pré-construite par ublue-os (aligné Bazzite ea2770f)
# Remplace l'ancien RPM ublue-brew (déprécié upstream, COPR plus rebuildé depuis 11/2025)
# NOTE : le tarball ne contient PAS node/npm — npm est installé à la demande via
# `brew install node` (opencode2-install), ou présent si l'utilisateur l'a ajouté
# Digest épinglé, à bumper ponctuellement vers le dernier build de :latest
FROM ghcr.io/ublue-os/brew:latest@sha256:9e0492dbc471258657564c94dae18b58dd96ddb998a06f2b15e8209efb48042b AS brew

# Étape intermédiaire : compilation du démon Gablue Share (Rust).
# La toolchain (rust + cargo, ~300 Mo) reste ici ; l'étape finale ne reçoit que
# le binaire. Même image de base que l'étape finale : mêmes blobs partagés et
# même glibc que le runtime (une fedora:XX distincte risquait un décalage).
FROM quay.io/fedora-ostree-desktops/${SOURCE_IMAGE}:${FEDORA_VERSION} AS share-build
# CARGO_HOME hors de /root : dans une image ostree /root est un lien vers
# var/roothome, absent de l'image, et un cache monté sous /root/.cargo échoue
# au build ("stat /root: no such file or directory", vu en CI le 14/11/2026).
ENV CARGO_HOME=/cargo
# Copies explicites : le target/ local (centaines de Mo) ne doit jamais entrer
# dans le contexte ni dans la couche.
COPY src/gablue-share/daemon/Cargo.toml /build/Cargo.toml
COPY src/gablue-share/daemon/Cargo.lock /build/Cargo.lock
COPY src/gablue-share/daemon/src /build/src
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=cache,dst=/cargo \
    --mount=type=cache,dst=/build/target \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/build-share-daemon

# Étape intermédiaire : icône de barre d'état de Gablue Manager (Rust,
# StatusNotifierItem). Même raison d'être que ci-dessus : la toolchain reste
# ici, l'étape finale ne reçoit qu'un binaire de ~3 Mo (l'icône Qt pèse 110 Mo).
FROM quay.io/fedora-ostree-desktops/${SOURCE_IMAGE}:${FEDORA_VERSION} AS manager-tray-build
ENV CARGO_HOME=/cargo
COPY src/gablue-manager/tray/Cargo.toml /build/Cargo.toml
COPY src/gablue-manager/tray/Cargo.lock /build/Cargo.lock
COPY src/gablue-manager/tray/src /build/src
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=cache,dst=/cargo \
    --mount=type=cache,dst=/build/target \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/build-manager-tray

# Étape intermédiaire : overlay manette (Rust). Même raison d'être que les deux
# précédentes : la toolchain reste ici, l'étape finale ne reçoit que `gpad`.
FROM quay.io/fedora-ostree-desktops/${SOURCE_IMAGE}:${FEDORA_VERSION} AS gpad-build
ENV CARGO_HOME=/cargo
COPY src/gablue-pad/gpad/Cargo.toml /build/Cargo.toml
COPY src/gablue-pad/gpad/Cargo.lock /build/Cargo.lock
COPY src/gablue-pad/gpad/src /build/src
COPY src/gablue-pad/gpad/assets /build/assets
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=cache,dst=/cargo \
    --mount=type=cache,dst=/build/target \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/build-gpad

# Étape intermédiaire : enregistreur / replay d'écran (C, capture KMS + VAAPI).
# Les en-têtes de développement ffmpeg/libdrm/libcap restent ici : l'image
# finale ne reçoit que le binaire (~50 Ko). La file capability est posée par
# post-install (COPY --from la perdrait).
FROM quay.io/fedora-ostree-desktops/${SOURCE_IMAGE}:${FEDORA_VERSION} AS gablue-rec-build
COPY src/gablue-rec /build
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/build-rec

# Étape intermédiaire : launcher de jeux (Rust, iced). Même raison d'être que
# les précédentes : la toolchain reste ici, l'étape finale ne reçoit que le
# binaire. `assets/` est copié avec les sources : glyphes de manette, étoile des
# favoris, icône et cover d'exemple sont embarqués par `include_bytes!`.
FROM quay.io/fedora-ostree-desktops/${SOURCE_IMAGE}:${FEDORA_VERSION} AS glauncher-build
ENV CARGO_HOME=/cargo
COPY src/glauncher/Cargo.toml /build/Cargo.toml
COPY src/glauncher/Cargo.lock /build/Cargo.lock
COPY src/glauncher/src /build/src
COPY src/glauncher/assets /build/assets
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=cache,dst=/cargo \
    --mount=type=cache,dst=/build/target \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/build-glauncher

# Étape intermédiaire : GTracker, lecteur et arrangeur de bandes-son rétro
# (Rust, egui, Wayland natif).
# Même raison d'être que les précédentes : la toolchain reste ici, l'étape
# finale ne reçoit que le binaire. `assets/` est copié (icône embarquée par
# `include_bytes!`) ; les en-têtes ALSA de `cpal` sont installés par le script.
FROM quay.io/fedora-ostree-desktops/${SOURCE_IMAGE}:${FEDORA_VERSION} AS gtracker-build
ENV CARGO_HOME=/cargo
COPY src/gtracker/Cargo.toml /build/Cargo.toml
COPY src/gtracker/Cargo.lock /build/Cargo.lock
COPY src/gtracker/crates /build/crates
COPY src/gtracker/assets /build/assets
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=cache,dst=/cargo \
    --mount=type=cache,dst=/build/target \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/build-gtracker

# Étape intermédiaire : vgmstream-cli, décodeur des sets `.txtp`/`.fsb`/`.bfstm`
# de joshw.info que zxtune ne lit pas. Pas de paquet Fedora : compilation depuis
# une archive épinglée (empreinte vérifiée dans le script).
FROM quay.io/fedora-ostree-desktops/${SOURCE_IMAGE}:${FEDORA_VERSION} AS vgmstream-build
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/build-vgmstream

# Étape intermédiaire : gate BPF (clang + libbpf). L'étape finale garde libbpf
# au runtime (petit paquet), pas la chaîne de compilation.
FROM quay.io/fedora-ostree-desktops/${SOURCE_IMAGE}:${FEDORA_VERSION} AS gpad-gate-build
COPY src/gablue-pad/gate /w
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/build-gpad-gate

# Image de base pour la construction finale
FROM quay.io/fedora-ostree-desktops/${SOURCE_IMAGE}:${FEDORA_VERSION}
# Redéfinition des arguments après le FROM pour les rendre disponibles
ARG VARIANT
ARG SOURCE_IMAGE
ARG DX_MODE
ARG KERNEL_FLAVOR
ARG KERNEL_VERSION
ARG IMAGE_DATE

# Copie des sources pour compilation et assemblage
# gablue-pad : copies explicites, composant par composant. `gpad/` (Rust) arrive
# par COPY --from=gpad-build, `gpad/target/` (centaines de Mo) et les bancs
# `evgrab/` ne doivent jamais entrer dans le contexte ni dans la couche.
COPY src/gablue-pad/Makefile /src/gablue-pad/Makefile
COPY src/gablue-pad/trigger /src/gablue-pad/trigger
COPY src/gablue-pad/mouse /src/gablue-pad/mouse
COPY src/gablue-pad/inhibit /src/gablue-pad/inhibit
COPY src/gablue-pad/rumble /src/gablue-pad/rumble
COPY src/gablue-pad/login /src/gablue-pad/login
COPY src/gablue-pad/shot /src/gablue-pad/shot
COPY src/gablue-pad/gate /src/gablue-pad/gate
COPY src/gablue-pad/kwin /src/gablue-pad/kwin
COPY src/gablue-pad/scripts /src/gablue-pad/scripts
COPY src/gablue-pad/sounds /src/gablue-pad/sounds
COPY src/gablue-pad/recorder.sh src/gablue-pad/replay.sh src/gablue-pad/screenshot.sh \
     src/gablue-pad/vrr.sh src/gablue-pad/mangohud.sh src/gablue-pad/booster.sh /src/gablue-pad/
COPY src/ds2xbox /src/ds2xbox
COPY src/gablue-dualsense /src/gablue-dualsense
COPY src/gablue-isomount /src/gablue-isomount
COPY src/gwine-launcher /src/gwine-launcher
# Copies explicites : `tray/target/` (centaines de Mo) ne doit jamais entrer
# dans le contexte ni dans la couche, comme pour Gablue Share ci-dessous.
COPY src/gablue-manager/gablue_manager /src/gablue-manager/gablue_manager
COPY src/gablue-manager/gablue-manager /src/gablue-manager/gablue-manager
# Gablue Share : paquet + lanceur seulement (jamais daemon/target/, centaines de Mo)
COPY src/gablue-share/gablue_share /src/gablue-share/gablue_share
COPY src/gablue-share/gablue-share /src/gablue-share/gablue-share
COPY src/tvqt /src/tvqt
COPY src/gablue-apk-installer /src/gablue-apk-installer
COPY src/lgplaunch /src/lgplaunch
COPY src/composefs-fix /src/composefs-fix
COPY src/cpuid-fault /src/cpuid-fault

# Copie des fichiers Homebrew pré-construits (tarball /usr/share/homebrew.tar.zst,
# services brew-setup/update/upgrade, preset, intégration shell — contenu identique à l'ancien RPM ublue-brew)
# Placé avant files/system/all pour profiter du cache (ce layer ne rebuilde que si le digest change)
COPY --from=brew /system_files/ /

# Copie des fichiers système dans l'image
COPY files/system/all /

# Supprimer le plugin natif dolphin-plugins mountisoaction (bug KDE #471487)
# Remplace par gablue-isomount (compilation dans build-c)
RUN rm -f /usr/lib64/qt6/plugins/kf6/kfileitemaction/mountisoaction.so

# Définition des variables d'environnement pour les scripts
ENV VARIANT=${VARIANT}
ENV SOURCE_IMAGE=${SOURCE_IMAGE}
ENV DX_MODE=${DX_MODE}
ENV KERNEL_FLAVOR=${KERNEL_FLAVOR}
ENV KERNEL_VERSION=${KERNEL_VERSION}
ENV IMAGE_DATE=${IMAGE_DATE}

# Configuration des dépôts Copr (avant le kernel pour fournir les dépendances des kmods)
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/copr && \
    /ctx/cleanup

# Installation du kernel ogc avec akmods
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=bind,from=akmods,src=/kernel-rpms,dst=/tmp/kernel-rpms \
    --mount=type=bind,from=akmods,src=/rpms/common,dst=/tmp/rpms/common \
    --mount=type=bind,from=akmods,src=/rpms/kmods,dst=/tmp/rpms/kmods \
    --mount=type=bind,from=akmods,src=/rpms/ublue-os,dst=/tmp/rpms/ublue-os \
    --mount=type=bind,from=akmods-extra,src=/rpms/extra,dst=/tmp/rpms/extra \
    --mount=type=bind,from=akmods-extra,src=/rpms/kmods,dst=/tmp/rpms/kmods-extra \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/kernel && \
    /ctx/cleanup

# Compilation du module cpuid_fault_emulation (émulation CPUID faulting pour AMD AM4/Steam Deck)
RUN --mount=type=secret,id=gablue-kmod-key \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/cpuid-fault && \
    /ctx/cleanup

# Installation Mesa Terra
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/mesa && \
    /ctx/cleanup

# Installation des pilotes NVIDIA (uniquement pour les variantes nvidia et nvidia-open)
# Monte aussi les fichiers nvidia-common (modprobe, SELinux, CDI, distrobox)
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=bind,from=akmods-nvidia,src=/rpms,dst=/tmp/rpms/nvidia \
    --mount=type=bind,from=nvidia-common-files,src=/,dst=/tmp/nvidia-files \
    --mount=type=tmpfs,dst=/tmp \
    if [ "$VARIANT" = "nvidia" ] || [ "$VARIANT" = "nvidia-open" ]; then \
        cp -r /tmp/nvidia-files/* / && \
        /ctx/nvidia; \
    fi && \
    /ctx/cleanup

# Installation des paquets RPM
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/rpm && \
    /ctx/cleanup

# Installation de packages Python depuis PyPI (sans équivalent RPM)
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/pypi && \
    /ctx/cleanup

# Compilation des sources C
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build-c && \
    /ctx/cleanup

# Overlay (Rust, étape gpad-build) et gate BPF (étape gpad-gate-build).
# Le démon cherche `gpad-gate.bpf.o` à côté de son binaire : même dossier.
COPY --from=gablue-rec-build /out/usr/bin/gpad-rec /usr/bin/gpad-rec
COPY src/gablue-rec/grec /usr/bin/grec
COPY --from=gpad-build /out/gpad /usr/bin/gpad
COPY --from=gpad-gate-build /out/gpad-gate /out/gpad-gate.bpf.o /usr/libexec/gablue-pad/

# Launcher de jeux (binaire Rust de l'étape glauncher-build) ; `.desktop` et
# icône arrivent avec `files/system/all`.
COPY --from=glauncher-build /out/glauncher /usr/bin/glauncher

# GTracker (binaire Rust de l'étape gtracker-build) ; `.desktop` et icône
# arrivent avec `files/system/all`.
COPY --from=gtracker-build /out/gtracker /usr/bin/gtracker

# vgmstream-cli : décodeur des conteneurs PS1/PS2/PS3/Switch/Wii U
# (`.txtp`, `.fsb`, `.bfstm`, `.btsnd`…) que zxtune ne lit pas. Les libs
# runtime (`libvorbis`, `mpg123-libs`) sont celles de l'image.
COPY --from=vgmstream-build /out/vgmstream-cli /usr/bin/vgmstream-cli

# Assemblage du script gwine standalone
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build-gwine && \
    /ctx/cleanup

# Gablue Manager : paquet Python dans /usr/lib/gablue-manager + lanceur /usr/bin
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build-manager && \
    /ctx/cleanup
# Icône de barre d'état : binaire Rust compilé dans l'étape manager-tray-build
# (aucun Qt chargé en permanence, la fenêtre n'est lancée qu'au clic)
COPY --from=manager-tray-build /out/gablue-manager-tray /usr/libexec/gablue-manager-tray

# Gablue Share : démon Rust (copié depuis l'étape de build) + GUI Python
COPY --from=share-build /out/gablue-shared /usr/libexec/gablue-shared
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build-share && \
    /ctx/cleanup

# Gablue TV : paquet Python dans /usr/lib/tvqt + lanceur /usr/bin/tvqt
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build-tvqt && \
    /ctx/cleanup

# Installateur APK : paquet Python dans /usr/lib/gablue-apk-installer + lanceur
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build-apk-installer && \
    /ctx/cleanup

# lgplaunch : modules lib/*.sh assemblés en /usr/bin/lgplaunch (comme gwine)
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build-lgplaunch && \
    /ctx/cleanup

# Règle polkit des bureaux distants gremote (sessions SANS siège) : la liste des
# actions qu'une session locale ACTIVE obtient sans mot de passe est dérivée de
# l'image elle-même, donc elle suit les paquets. Génération ici et non dans le
# JavaScript de polkit : polkit 127 n'expose plus ces valeurs aux règles, et une
# règle qui les demande à polkitd (polkit.spawn) se bloque — « Terminating
# runaway script after 15 seconds », puis retour du dialogue après 10-15 s
# (vécu 04/11/2026).
RUN python3 /usr/libexec/gablue-polkit-active-list \
        > /usr/share/polkit-1/rules.d/70-gremote-seatless-active.rules

# Post-installation : configuration finale
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/systemd && \
    /ctx/post-install && \
    /ctx/initramfs && \
    /ctx/finalize

# Valider l'image bootc
RUN --mount=type=tmpfs,target=/run --network=none bootc container lint
