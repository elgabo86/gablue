#!/usr/bin/bash
# grec - enregistreur d'écran de Gablue, sans la manette.
#
#   grec                 enregistre AU PREMIER PLAN : Ctrl-C arrête et finalise
#   grec toggle          démarre / arrête sans rester attaché (menu, script)
#   grec start | stop    démarrage / arrêt explicite
#   grec status          état (enregistrement, replay, fichier en cours)
#   grec save            sauvegarde le buffer de replay (Replay_<date>.mp4)
#   grec replay start    démarre / arrête le buffer
#   grec replay stop
#   grec replay status
#   grec dir             ouvre le dossier des captures dans Dolphin
#
# C'est la MÊME chaîne que l'overlay et le déclencheur : `recorder.sh` et
# `replay.sh` de gablue-pad, qui parlent à la socket de `gpad-rec`. Aucun état
# propre ici, donc pas de risque de divergence (deux « qui enregistre ? »).
#
# Pendant un enregistrement, l'icône de Gablue Manager passe au rouge dans la
# barre d'état : un clic dessus arrête la capture. Aucune bulle de notification
# n'est affichée — elle se retrouverait dans le clip suivant.
set -uo pipefail

# Aucun bip : lancé au clavier ou depuis le menu, on voit l'écran (le son de
# démarrage ne sert qu'à la manette). L'icône du tray passe au rouge, c'est le
# retour visuel.
export GPAD_SANS_BIP=1

HERE="$(dirname "$(readlink -f "$0")")"
# Image : les scripts du pad sont dans /usr/libexec/gablue-pad. Banc : ils sont
# à côté de ce fichier, ou dans le dépôt (`GPAD_PAD_DIR`).
DIR=${GPAD_PAD_DIR:-/usr/libexec/gablue-pad}
[[ -x "$DIR/recorder.sh" ]] || DIR="$HERE"
REC="$DIR/recorder.sh"
REP="$DIR/replay.sh"

usage() {
    sed -n '2,/^set /p' "$0" | sed -e 's/^# \{0,1\}//' -e '/^set /d'
}

# Dossier des captures : la clé `dossier` de recorder.conf fait foi (même
# fichier que l'overlay et Gablue Manager), sinon le défaut du démon.
dossier() {
    local conf="${XDG_CONFIG_HOME:-$HOME/.config}/gablue/recorder.conf"
    local d=""
    [[ -f "$conf" ]] && d=$(sed -n 's/^dossier=//p' "$conf" | tail -1)
    printf '%s\n' "${d:-$HOME/Vidéos/Captures}"
}

[[ -x "$REC" ]] || { echo "ECHEC: $REC absent" >&2; exit 1; }

SOCK=${GPAD_REC_SOCK:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gablue/gpad-rec.sock}

# Réponse JSON de la socket (vide si le démon n'est pas là). Même protocole que
# recorder.sh/replay.sh : une ligne, une réponse, aucun fichier d'état.
etat() {
    timeout 10 python3 - "$SOCK" <<'PY' 2>/dev/null
import socket, sys
try:
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(8)
    s.connect(sys.argv[1])
except OSError:
    sys.exit(1)
s.sendall(b'{"cmd":"status"}\n')
print(s.makefile().readline().strip())
PY
}

champ() { sed -n "s/.*\"$2\":\"\{0,1\}\([^\",}]*\).*/\1/p" <<< "$1"; }

chrono() {
    local t=${1%%.*} h m sec
    t=${t:-0}
    h=$((t / 3600)); m=$((t % 3600 / 60)); sec=$((t % 60))
    if (( h )); then printf '%d:%02d:%02d' "$h" "$m" "$sec"
    else printf '%02d:%02d' "$m" "$sec"; fi
}

# Enregistrement au premier plan : démarre (ou rejoint l'enregistrement en
# cours) et attend. Ctrl-C passe par `recorder.sh stop`, qui ne rend la main
# qu'une fois le mp4 finalisé (moov écrit) : on ne perd rien à l'arrêt.
suivre() {
    local r; r=$(etat)
    if [[ "$r" != *'"recording":true'* ]]; then
        "$REC" start || return 1
        r=$(etat)
    else
        printf 'enregistrement déjà en cours — Ctrl-C pour arrêter\n'
    fi
    local fichier; fichier=$(champ "$r" file)
    local stop=0
    trap 'stop=1' INT TERM HUP
    while [[ $stop == 0 ]]; do
        r=$(etat) || { printf '\nle démon ne répond plus\n' >&2; return 1; }
        [[ "$r" == *'"recording":true'* ]] || break
        if [[ -t 1 ]]; then
            printf '\rREC  %s  — Ctrl-C pour arrêter ' "$(chrono "$(champ "$r" t)")"
        fi
        sleep 1
    done
    if [[ $stop == 1 ]]; then
        # un second Ctrl-C ne doit pas couper la finalisation
        trap '' INT TERM HUP
        [[ -t 1 ]] && printf '\n'
        "$REC" stop
        return 130
    fi
    [[ -t 1 ]] && printf '\n'
    printf 'enregistrement terminé : %s\n' "${fichier:-?}"
}

case "${1:-}" in
    "") suivre ;;
    start|stop|toggle) exec "$REC" "$@" ;;
    status)
        # les deux états d'un coup, plus l'application des réglages
        "$REC" status
        printf 'replay : %s\n' "$("$REP" status)"
        printf 'réglage : %s\n' "$("$REC" pending)"
        ;;
    save) exec "$REP" save ;;
    replay) shift; exec "$REP" "${1:-status}" ;;
    dir)
        d="$(dossier)"
        mkdir -p "$d" 2>/dev/null || true
        setsid dolphin "$d" </dev/null >/dev/null 2>&1 &
        echo "$d" ;;
    -h|--help|help) usage ;;
    *)
        echo "option inconnue : $1" >&2
        echo "usage : grec [start|stop|toggle|status|save|replay start|stop|status|dir]" >&2
        exit 2 ;;
esac
