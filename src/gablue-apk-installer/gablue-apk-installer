#!/usr/bin/python3

"""Lanceur de l'installateur APK Gablue.

Le paquet Python vit dans /usr/lib/gablue-apk-installer (installé par
`files/scripts/build-apk-installer`) ; en développement, ce lanceur trouve le
paquet juste à côté de lui, si bien que
`src/gablue-apk-installer/gablue-apk-installer` marche directement depuis le
dépôt.
"""

import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent
for _candidate in (_HERE, Path("/usr/lib/gablue-apk-installer")):
    if (_candidate / "gablue_apk_installer").is_dir():
        sys.path.insert(0, str(_candidate))
        break

from gablue_apk_installer.app import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
