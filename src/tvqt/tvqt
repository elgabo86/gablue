#!/usr/bin/python3

"""Lanceur de Gablue TV (tvqt).

Le paquet Python vit dans /usr/lib/tvqt (installé par
`files/scripts/build-tvqt`) ; en développement, ce lanceur trouve le paquet
juste à côté de lui, si bien que `src/tvqt/tvqt` marche directement depuis le
dépôt.
"""

import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent
for _candidate in (_HERE, Path("/usr/lib/tvqt")):
    if (_candidate / "gablue_tv").is_dir():
        sys.path.insert(0, str(_candidate))
        break

from gablue_tv.app import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
