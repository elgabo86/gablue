// gablue-session-mode : basculer entre la session console et le bureau depuis
// le menu Home de la manette, sans mot de passe.
//
// Le helper écrit /etc/plasmalogin.conf.d/zz-gablue-session.conf et redémarre
// plasmalogin : deux opérations root. Sans cette règle, chaque appui sur
// « MODE JEU » / « MODE BUREAU » demanderait une authentification — impossible
// en session console, où il n'y a ni clavier ni agent PolicyKit (l'appui
// échouerait en silence).
//
// Restreint au programme EXACT, au groupe wheel et à une session locale : un
// compte wheel connecté à distance ne peut pas changer la session de la
// machine.
polkit.addRule(function(action, subject) {
    if (action.id != "org.freedesktop.policykit.exec") {
        return;
    }
    if (action.lookup("program") != "/usr/libexec/gablue-session-mode") {
        return;
    }
    if (!subject.local || !subject.isInGroup("wheel")) {
        return;
    }
    return polkit.Result.YES;
});
