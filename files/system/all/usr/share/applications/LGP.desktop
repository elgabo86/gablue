[Desktop Entry]
Comment=Exécute les Linux Game Packs
Exec=/usr/share/ublue-os/gablue/scripts/lgplaunch.sh %f
Icon=tux
Keywords[fr_CH]=lgp;linux;game;jeu;pack;
Keywords=lgp;linux;game;jeu;pack;
MimeType=application/x-lgp;
Name=LGP
NoDisplay=true
Path=
StartupWMClass=lgplaunch
Terminal=false
TerminalOptions=
Type=Application
X-GNOME-UsesNotifications=true
X-KDE-SubstituteUID=false
X-KDE-Username=
X-KDE-StartupNotify=false
