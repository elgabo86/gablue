#!/usr/bin/bash

# Exécuter toutes les commandes en arrière-plan en regroupant les tâches indépendantes
{
  # Recherche et kill tous les processus Windows (xbox360 inclus)
  # Exclure gwine pour permettre le cleanup des locks
  # Exclure opencode.exe : binaire du CLI opencode (build Bun npm) qui garde
  # l'extension .exe même sur Linux — kill du serveur = reboot du service
  for pid in $(pgrep -u "$USER" -f -i "\\.exe|\\.bat"); do
    comm=$(ps -p $pid -o comm= 2>/dev/null)
    if [[ "$comm" != "gwine" ]] && [[ "$comm" != "bash" ]] && [[ "$comm" != "opencode.exe" ]] && [ "$pid" != "$$" ]; then
      kill -9 $pid 2>/dev/null
    fi
  done

  # Kill tous les processus wgp/wine sauf squashfuse (nettoyage complet jeu sans casser gwine)
  pgrep -u "$USER" -f "wgpackmount" | grep -v squashfuse | xargs -r kill -9 2>/dev/null &

  # Kill processus Wine en mode non-wgp (chemin Z:)
  pgrep -u "$USER" -f "Z:" | xargs -r kill -9 2>/dev/null &

  # Gestion des processus bottles (spécifique avec vérification bwrap)
  pgrep -u "$USER" -f bottles | xargs -I {} sh -c 'ps -p {} -o comm= | grep -q "^bwrap$" && kill -9 {}' &

   # Kill des émulateurs (tous en parallèle)
  for emu in azahar suyu eden sudachi dolphin-emu yuzu retroarch xemu rpcs3 duckstation pcsx2 lime3ds ryujinx Cemu flycast shadps4 PokeMMO PPSSPP xenia_edge; do
    pgrep -u "$USER" -f "$emu" | xargs -n1 kill -9 &
  done

  # Commande spécifique pour eden et citron avec fusermount
  (pgrep -u "$USER" -f mount_eden | xargs -r -n1 kill -9 && fusermount -uz /tmp/.mount_eden*) &
  (pgrep -u "$USER" -f citron | xargs -r -n1 kill -9 && fusermount -uz /tmp/.mount_citro*) &
  (pgrep -u "$USER" -f xenia_edge | xargs -r -n1 kill -9 && fusermount -uz /tmp/.mount_xenia*) &

  # Kill des processus sober
  pkill -u "$USER" -9 sober &

  # Kill x2go
  pkill -u "$USER" -9 x2goclient &

  # Kill Gablue TV et Jellyfin uniquement s'ils ont été lancés depuis ES-DE
  # (variable GABLUE_ES_LAUNCH exportée par les lanceurs Tools d'ES-DE)
  # tvqt : kill direct du processus
  pgrep -u "$USER" -f "/usr/bin/tvqt" | while read -r pid; do
    grep -zq "GABLUE_ES_LAUNCH=1" /proc/$pid/environ 2>/dev/null && kill -9 "$pid" 2>/dev/null
  done &

  # Jellyfin Desktop : kill du sandbox complet si lancé depuis ES-DE
  # (le wrapper "flatpak run" n'existe plus une fois l'app lancée et l'env GABLUE_ES_LAUNCH
  # n'est visible que dans le processus applicatif du sandbox, pas dans les bwrap ;
  # flatpak kill ne termine pas le sous-sandbox WebEngine, d'où le pkill des bwrap restants)
  for pid in $(pgrep -u "$USER" -f "jellyfin-desktop"); do
    if grep -zq "GABLUE_ES_LAUNCH=1" /proc/$pid/environ 2>/dev/null; then
      kill -9 "$pid" 2>/dev/null
      flatpak kill org.jellyfin.JellyfinDesktop 2>/dev/null
      pkill -9 -u "$USER" -f "bwrap .*jellyfin-desktop" 2>/dev/null
      break
    fi
  done &

  # VacuumTube (YouTube) : kill du sandbox complet si lancé depuis ES-DE
  # (GABLUE_ES_LAUNCH n'est visible que dans le bash wrapper startvacuumtube du
  # sandbox — Electron et bwrap la filtrent ; kill direct du wrapper interdit :
  # il rend le sandbox incohérent et fait suspendre flatpak kill, d'où le timeout)
  for pid in $(pgrep -u "$USER" -f "startvacuumtube"); do
    if grep -zq "GABLUE_ES_LAUNCH=1" /proc/$pid/environ 2>/dev/null; then
      timeout 10 flatpak kill rocks.shy.VacuumTube 2>/dev/null || true
      break
    fi
  done &

  # LGP : tuer tout ce qui tourne depuis les packs montés + démonter
  # Ancre = chemin de montage /tmp/lgpackmount (porté par la cmdline de
  # squashfuse, du `bash -c` du lanceur et de tous les binaires du jeu).
  # L'ancien kill "enfants de lgplaunch" ne descendait que de 2 niveaux :
  # en mode overlay kernel (jeu dans unshare -U -m), il tuait bash -c +
  # unshare et orphelinait l'arbre du jeu → reparenté à systemd --user,
  # sans plus aucun "lgplaunch" en cmdline → invisible aux runs suivants
  # (vécu : Glover-R.lgp 10/2026). L'ancre mount est insensible à la mort
  # du lanceur et à la profondeur du namespace ; un lanceur vivant voit
  # son jeu mourir et sort proprement avec son cleanup.
  pgrep -u "$USER" -f "/tmp/lgpackmount" | xargs -r -n1 kill -9 2>/dev/null &

  # Démontage des packs non-overlay (kernel overlay : le mount vit dans le
  # namespace et meurt avec lui — fusermount est un no-op sans danger)
  (fusermount -uz /tmp/lgpackmount-* 2>/dev/null) &
} > /dev/null 2>&1 &

# Attendre que toutes les tâches en arrière-plan soient terminées (optionnel)
wait
