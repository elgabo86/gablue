[Unit]
Description=Remote desktop session for %i (gremote)
Documentation=man:gremote(1)
After=systemd-user-sessions.service
Conflicts=shutdown.target

[Service]
Type=simple
User=%i
# PAMName=login donne une vraie session logind (siège + VT), pas un service
# détaché : sans ça KWin n'a pas les droits DRM et krdpserver n'a rien à
# capturer. Une règle polkit autorise chaque utilisateur à démarrer SA propre
# unité (cf. 50-gremote-session.rules), donc aucun mot de passe n'est demandé.
PAMName=login
# KWin exige ces variables pour peindre un bureau complet (sans elles
# plasmashell démarre mais reste noir).
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=KDE
Environment=XDG_SESSION_DESKTOP=KDE
Environment=KDE_FULL_SESSION=true
Environment=DESKTOP_SESSION=plasma
# VT dédiée aux sessions à distance : celle du greeter (VT1) et d'un
# utilisateur local restent libres. Une seule session à distance à la fois,
# cf. la limite documentée dans README.md.
Environment=XDG_SEAT=seat0
Environment=XDG_VTNR=3
# --no-lockscreen : une session sans connexion PAM « classique » arrive
# verrouillée (LockedHint=yes) et l'écran de verrouillage de KDE ignore
# l'entrée synthétique de KRdp — clavier et souris paraissent morts
# (vécu 02/11/2026). Elle est déjà protégée par SSH puis par le mot de
# passe RDP éphémère, donc pas d'écran de verrouillage ici.
# Un compositeur rescapé d'une session précédente tiendrait ce socket : deux
# KWin sur la même VT et le même nom D-Bus, donc un client qui streame
# l'ancienne session. On refuse de démarrer dans ce cas (message clair)
# plutôt que d'en empiler un second (vécu 02/11/2026).
# KWin n'obtient la carte DRM que si sa VT est ACTIVE au moment où il démarre :
# sinon le compositeur n'a aucune sortie (wl_output absent), le screencast de
# KRdp n'a rien à capturer et le client RDP reste noir (vécu 02/11/2026). On
# active donc la VT de la session avant de lancer KWin - en root (+) parce que
# loginctl activate-session n'est pas accordé à une session distante.
ExecStartPre=+/bin/sh -c 'for s in $$(loginctl show-user %i -p Sessions --value); do if [ "$$(loginctl show-session $$s -p VTNr --value 2>/dev/null)" = 3 ] && [ "$$(loginctl show-session $$s -p State --value 2>/dev/null)" = online ]; then loginctl activate $$s || true; break; fi; done; /bin/chvt 3 || true; sleep 1'
ExecStartPre=/bin/sh -c 'test ! -S "$XDG_RUNTIME_DIR/gremote-session"'
ExecStart=/usr/bin/kwin_wayland --no-lockscreen --socket gremote-session -- plasma_session
# Les processus vivent dans le scope logind, hors du cgroup de l'unité :
# sans ce nettoyage, `systemctl stop` laisse un KWin qui garde le socket ET le
# nom D-Bus `org.kde.KWin` (unique par bus utilisateur), et le prochain client
# streame l'ancienne session - souvent verrouillée, d'où un écran de connexion
# qui ne répond pas (vécu 02/11/2026). Ciblage strict : seuls les KWin de cet
# utilisateur dont la ligne de commande porte notre socket.
ExecStopPost=-/bin/sh -c 'for p in $(pgrep -x -u %i kwin_wayland); do grep -qa -- "--socket gremote-session" /proc/$p/cmdline 2>/dev/null && kill -KILL $p; done; true'
# La session survit à la déconnexion SSH : c'est le but (on s'y rattache).
Restart=no

[Install]
WantedBy=multi-user.target
