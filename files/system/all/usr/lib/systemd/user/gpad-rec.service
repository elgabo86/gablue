[Unit]
Description=Gablue Rec (enregistreur / replay d'écran, socket de contrôle)
Documentation=file:///usr/share/ublue-os/gablue/AGENTS.md
# Session graphique : le démon ouvre /dev/dri et le monitor audio du compte.
# Il ne sert QUE la socket ; il capture seulement sur demande (enregistrement,
# replay, ou replay automatique d'un jeu LGP/WGP) et libère le moteur au repos.
#
# PAS de `PartOf=graphical-session.target` (retiré le 27/11/2026) : un passage
# bureau ⇄ console arrête les cibles plasma, donc le démon avec elles — et la
# session console ne redémarre jamais `graphical-session.target`, d'où un
# enregistreur mort jusqu'au prochain lancement manuel (constaté sur gen1 :
# service arrêté à 14:32, toutes les captures suivantes servies par un démon
# jetable lancé par `recorder.sh`). La capture est du KMS, elle ne dépend pas
# du compositeur ; `WantedBy=` suffit à la lancer avec la session.
After=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/gpad-rec --daemon
# `gpad-rec` porte une file capability (cap_sys_admin+p, posée par l'image)
# pour drmModeGetFB2 : pas de root, pas de démon privilégié, le drapeau n'est
# monté que le temps de l'appel.
Restart=on-failure
RestartSec=2
# Arrêt propre : finalise un enregistrement en cours (moov) avant de sortir.
TimeoutStopSec=15

[Install]
WantedBy=graphical-session.target
