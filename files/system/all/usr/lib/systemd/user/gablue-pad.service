[Unit]
Description=Gablue Pad (overlay manette : Home, combos, menu système)
After=graphical-session.target
PartOf=graphical-session.target
# comme l'ancien service manette : relance sans fin, pas de limite de tentatives
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=/usr/bin/gpad-trigger /usr/bin/gpad
# chemins installés : le déclencheur et l'overlay résolvent tout par variable
# (au banc ils sont relatifs au binaire). Sons de gpad-mouse : chemins absolus,
# sinon `clic.wav` est cherché dans le dossier courant.
Environment=RECORDER=/usr/libexec/gablue-pad/recorder.sh
Environment=SCREENSHOT=/usr/libexec/gablue-pad/screenshot.sh
Environment=GPAD_SHOT=/usr/bin/gpad-shot
Environment=REPLAY=/usr/libexec/gablue-pad/replay.sh
Environment=VRR=/usr/libexec/gablue-pad/vrr.sh
Environment=MANGOHUD=/usr/libexec/gablue-pad/mangohud.sh
Environment=BOOSTER=/usr/libexec/gablue-pad/booster.sh
Environment=SCRIPTS=/usr/libexec/gablue-pad/scripts
Environment=MOUSE=/usr/bin/gpad-mouse
Environment=KBDNAV=/usr/bin/gpad-kbd
Environment=INHIBIT=/usr/bin/gpad-inhibit
Environment=RUMBLE=/usr/bin/gpad-rumble
Environment=PADNODES=/usr/libexec/gablue-pad/gate/padnodes.sh
Environment=KWIN_SCRIPTS=/usr/libexec/gablue-pad/kwin
Environment=CLIC_WAV=/usr/libexec/gablue-pad/sounds/clic.wav
Environment=NOCLIC_WAV=/usr/libexec/gablue-pad/sounds/noclic.wav
Environment=KILLTHEMALL=/usr/share/ublue-os/gablue/scripts/killthemall
Environment=FERMERAPPLIS=/usr/libexec/gablue-pad/scripts/fermer-applis
Environment=GPAD_GATE=/run/gablue-pad/gate.sock
Restart=always
RestartSec=1
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
