# Serveur de fond OpenCode — démarrage au boot (unité utilisateur)
# Activation : ujust opencode-service-enable / désactivation : ujust opencode-service-disable
# Désactivé par défaut : le serveur démarre normalement à la première utilisation (TUI/Desktop)

[Unit]
Description=Serveur de fond OpenCode
Documentation=https://opencode.ai/v2/docs/troubleshooting
# Unité sautée sans erreur si OpenCode n'est pas installé
ConditionExecutable=%h/.local/bin/opencode

[Service]
Type=oneshot
# start : exit 0 sans action si le serveur tourne déjà (idempotent), sinon le daemonise
ExecStart=%h/.local/bin/opencode service start
ExecStop=/usr/bin/bash -c '%h/.local/bin/opencode service stop || true'
RemainAfterExit=yes

[Install]
WantedBy=default.target
