#!/bin/bash

# Script pour installer/mettre à jour OpenCode 2 (@opencode/cli) via npm + l'app OpenCode Desktop
# Remplace les anciens alias opencode-install (V1) et opencode2-install (script curl)
# - Désinstalle OpenCode 1 si présent (npm @opencode-ai/opencode ou install curl)
# - Désinstalle OpenCode 2 s'il n'est pas installé via npm (install curl ou brew)
# - Installe npm via Homebrew si absent
# - Installe @opencode/cli en global npm
# - Crée le symlink ~/.local/bin/opencode vers le binaire npm (opencode2)
# - Installe l'app OpenCode Desktop (AppImage intégrée via GearLever, ~/AppImages/opencode.appimage)
# - Installe l'entrée « Ouvrir avec OpenCode » pour les dossiers dans Dolphin
#   (deep-link opencode:// vers l'app desktop, plus le lancement terminal)

# Dépendances : homebrew (fourni par Gablue, requis seulement si npm absent), timeout (coreutils),
#               curl, flatpak avec GearLever (it.mijorus.gearlever, requis pour la GUI),
#               python3 (encodage URL, fallback sed si absent)

set -e

NPM_PACKAGE="@opencode/cli"
LOCAL_BIN="$HOME/.local/bin"

echo "=== OpenCode 2 : installation via npm ==="

# Homebrew (requis uniquement pour installer npm au besoin)
BREW="$(command -v brew || true)"
if [ -z "$BREW" ] && [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    BREW="/home/linuxbrew/.linuxbrew/bin/brew"
fi

# --- Étape 1 : désinstaller OpenCode 1 (V1) si existant ---
if command -v npm &>/dev/null && npm list -g --depth=0 @opencode-ai/opencode &>/dev/null; then
    echo "Désinstallation d'OpenCode 1 (npm @opencode-ai/opencode)..."
    npm uninstall -g @opencode-ai/opencode && echo "✓ OpenCode 1 (npm) désinstallé."
fi

# --- Étape 2 : désinstaller OpenCode 2 s'il n'est pas installé via npm ---
# (installation par script curl : binaire dans ~/.opencode/bin + ligne PATH dans le shell)
if ! (command -v npm &>/dev/null && npm list -g --depth=0 "$NPM_PACKAGE" &>/dev/null); then
    echo "Recherche d'une installation OpenCode non-npm à désinstaller..."

    # Arrêter proprement le service qui tourne sur l'ancien binaire
    if command -v opencode &>/dev/null; then
        timeout 15 opencode service stop &>/dev/null || true
    fi

    # Formula brew éventuelle
    if [ -n "$BREW" ] && "$BREW" list --formula 2>/dev/null | grep -qx "opencode"; then
        echo "Désinstallation de la formula brew opencode..."
        "$BREW" uninstall --ignore-dependencies opencode || true
    fi

    # Binaire(s) de l'installation curl : ~/.opencode/bin/
    if [ -d "$HOME/.opencode/bin" ]; then
        echo "Suppression de $HOME/.opencode/bin (installation curl)..."
        rm -rf "$HOME/.opencode/bin"
    fi

    # Ligne PATH ajoutée par le script curl (sinon elle masque l'installation npm)
    for RC in "$HOME/.bashrc" "$HOME/.profile" "$HOME/.bash_profile"; do
        if [ -f "$RC" ]; then
            sed -i -E '\|^[[:space:]]*#?[[:space:]]*(export[[:space:]]+)?PATH=.*\.opencode/bin.*$|d' "$RC" 2>/dev/null || true
        fi
    done

    echo "✓ Ancienne installation non-npm désinstallée."
else
    echo "✓ OpenCode 2 déjà installé via npm."
fi

# --- Étape 3 : installer npm via Homebrew si absent ---
if command -v npm &>/dev/null; then
    echo "✓ npm déjà installé ($(npm --version))."
else
    if [ -z "$BREW" ]; then
        echo "✗ Erreur : npm absent et Homebrew introuvable (impossible d'installer npm)."
        exit 1
    fi
    echo "npm absent : installation de Node.js (npm) via Homebrew..."
    "$BREW" install node
    echo "✓ npm installé ($(npm --version))."
fi

# --- Étape 4 : installer OpenCode 2 via npm ---
echo "Installation de $NPM_PACKAGE via npm..."
# Version CLI avant install : sert à ne redémarrer le service de fond qu'en cas
# de vraie MAJ (un restart inconditionnel rebondit toutes les sessions ouvertes,
# CLI et desktop, puisque tout le monde est connecté au même serveur)
CLI_VERSION_BEFORE="$(timeout 10 opencode --version 2>/dev/null | grep -oE '[0-9]+(\.[0-9]+)+' || true)"
# --allow-scripts : exécute le postinstall officiel (npm récent le bloque par défaut)
# Le tarball npm ne contient qu'un stub de 229 octets : c'est le postinstall qui
# télécharge le vrai binaire (paquet plateforme) — sans lui, binaire non matérialisé.
# Persisté aussi en config npm utilisateur car l'updater interne d'OpenCode
# (« Update OpenCode » / `opencode upgrade`) réinstalle le paquet via npm SANS
# passer --allow-scripts : sans cet allowScripts global, le postinstall est bloqué,
# le stub reste en place et la mise à jour échoue en silence sur les machines
# sans allowlist npm.
npm config set allow-scripts="$NPM_PACKAGE" --location=user 2>/dev/null || true
npm install -g --allow-scripts="$NPM_PACKAGE" "$NPM_PACKAGE" \
    || npm install -g "$NPM_PACKAGE"
echo "✓ OpenCode $(timeout 10 opencode --version 2>/dev/null || echo "2") installé via npm."
CLI_VERSION_AFTER="$(timeout 10 opencode --version 2>/dev/null | grep -oE '[0-9]+(\.[0-9]+)+' || true)"

# --- Étape 5 : symlink ~/.local/bin/opencode vers le binaire npm (opencode2) ---
NPM_BIN="$(npm prefix -g)/bin"
mkdir -p "$LOCAL_BIN"
if [ "$(readlink -f "$LOCAL_BIN/opencode" 2>/dev/null)" != "$(readlink -f "$NPM_BIN/opencode2" 2>/dev/null)" ]; then
    ln -sfn "$NPM_BIN/opencode2" "$LOCAL_BIN/opencode"
    echo "✓ Symlink créé : $LOCAL_BIN/opencode -> $NPM_BIN/opencode2"
fi

# --- Étape 6 : installation/mise à jour de l'app OpenCode Desktop (AppImage + GearLever) ---
# L'app desktop suit le versionnage du CLI (ex. 2.0.16 des deux côtés).
# Source : https://opencode.ai/download/stable/linux-x64-appimage
# (redirection vers https://opencode.ai/files/bin/<version>/opencode-desktop-linux-x86_64.AppImage)
# Intégrée via GearLever dans ~/AppImages/opencode.appimage (même pattern que eden-install)
DESKTOP_APPIMAGE="$HOME/AppImages/opencode.appimage"
DESKTOP_ENTRY="$HOME/.local/share/applications/opencode.desktop"
STABLE_URL="https://opencode.ai/download/stable/linux-x64-appimage"

# Patch de l'entrée .desktop générée par GearLever :
# - nom sans numéro de version
# - --no-sandbox requis par Electron sur Kinoite (chrome-sandbox SUID absent)
# Idempotent ; appelé aussi quand l'app est déjà à jour, pour réparer les
# installations précédentes restées non patchées.
patch_desktop_entry() {
    if [ -f "$DESKTOP_ENTRY" ]; then
        sed -i 's/^Name=OpenCode\s*(.*)$/Name=OpenCode/' "$DESKTOP_ENTRY"
        if grep -q '^Exec=' "$DESKTOP_ENTRY" && ! grep -q '^Exec=.*--no-sandbox' "$DESKTOP_ENTRY"; then
            if grep -q '^Exec=.*%[fFuU]' "$DESKTOP_ENTRY"; then
                sed -i 's|^\(Exec=.*\)\(%[fFuU]\)$|\1--no-sandbox \2|' "$DESKTOP_ENTRY"
            else
                sed -i 's|^Exec=\(.*\)$|Exec=\1 --no-sandbox|' "$DESKTOP_ENTRY"
            fi
        fi
        chmod u+rw "$DESKTOP_ENTRY"
    fi
}

echo "=== OpenCode Desktop : vérification de la dernière version ==="
# Version cible : extraite de la redirection du lien stable, fallback version npm
LATEST_VERSION="$(curl -sIL -o /dev/null -w '%{url_effective}' --max-time 30 "$STABLE_URL" 2>/dev/null \
    | sed -n 's|.*/bin/\([^/]*\)/.*|\1|p')"
if ! echo "$LATEST_VERSION" | grep -qE '^[0-9]+(\.[0-9]+)+'; then
    LATEST_VERSION="$(npm view @opencode/cli version 2>/dev/null || true)"
fi

# Version installée : champ X-AppImage-Version posé par GearLever dans l'entrée .desktop
INSTALLED_VERSION=""
if [ ! -f "$DESKTOP_ENTRY" ]; then
    # Fallback : GearLever nomme l'entrée d'après l'app ; on cherche par X-AppImage-Name
    DESKTOP_ENTRY="$(grep -rl '^X-AppImage-Name=OpenCode$' "$HOME/.local/share/applications" 2>/dev/null | head -1 || true)"
fi
if [ -f "$DESKTOP_ENTRY" ]; then
    INSTALLED_VERSION="$(sed -n 's/^X-AppImage-Version=//p' "$DESKTOP_ENTRY" | head -1)"
fi

if [ -f "$DESKTOP_APPIMAGE" ] && [ -n "$INSTALLED_VERSION" ] && [ -n "$LATEST_VERSION" ] \
    && [ "$INSTALLED_VERSION" = "$LATEST_VERSION" ]; then
    echo "✓ OpenCode Desktop $INSTALLED_VERSION déjà installé (à jour)."
    patch_desktop_entry
else
    # GearLever requis pour l'intégration : vérifié AVANT le téléchargement (245 Mo)
    if ! flatpak list 2>/dev/null | grep -q "it.mijorus.gearlever"; then
        echo "✗ Erreur : GearLever (flatpak it.mijorus.gearlever) n'est pas installé."
        echo "  Installez-le d'abord : flatpak install flathub it.mijorus.gearlever"
        exit 1
    fi

    if [ -n "$LATEST_VERSION" ]; then
        echo "Mise à jour d'OpenCode Desktop : ${INSTALLED_VERSION:-absent} -> $LATEST_VERSION"
    else
        echo "! Version desktop introuvable, réinstallation forcée..."
    fi

    CACHE_DIR="$HOME/.cache/opencode-desktop"
    mkdir -p "$CACHE_DIR"
    CACHE_FILE="$CACHE_DIR/opencode.appimage"

    echo "Téléchargement de l'AppImage OpenCode Desktop (~245 Mo)..."
    # -f : échoue sur HTTP 404/5xx au lieu d'écrire une page d'erreur dans le fichier
    curl -fL --progress-bar --retry 3 "$STABLE_URL" -o "$CACHE_FILE"

    if [ ! -s "$CACHE_FILE" ]; then
        echo "✗ Erreur : le fichier téléchargé est vide ou absent."
        exit 1
    fi
    chmod +x "$CACHE_FILE"

    # Désintégration de l'ancienne version (GearLever, fallback nettoyage manuel)
    if [ -f "$DESKTOP_APPIMAGE" ]; then
        echo "Suppression de l'ancienne version via GearLever (30-60 s possibles)..."
        if timeout 120s bash -c "yes | flatpak run it.mijorus.gearlever --remove '$DESKTOP_APPIMAGE'" 2>/dev/null; then
            echo "✓ Ancienne version supprimée via GearLever."
        else
            echo "! GearLever a échoué, nettoyage manuel..."
            rm -f "$DESKTOP_APPIMAGE"
            rm -f "$DESKTOP_ENTRY"
            find "$HOME/.local/share/icons" -name "opencode*" -delete 2>/dev/null || true
            command -v update-desktop-database &>/dev/null \
                && update-desktop-database "$HOME/.local/share/applications" &>/dev/null || true
        fi
    fi

    echo "Intégration de l'AppImage avec GearLever..."
    yes | flatpak run it.mijorus.gearlever --integrate "$CACHE_FILE" 2>/dev/null || true

    # Re-détection de l'entrée .desktop APRÈS l'intégration : le fallback
    # initial a tourné AVANT, quand rien n'existait encore (première
    # installation) — DESKTOP_ENTRY peut être vide ou pointé vers un fichier
    # disparu lors du remove/integrate.
    if [ ! -f "$DESKTOP_ENTRY" ]; then
        DESKTOP_ENTRY="$(grep -rl '^X-AppImage-Name=OpenCode$' "$HOME/.local/share/applications" 2>/dev/null | head -1 || true)"
    fi

    # Correction de l'entrée .desktop générée par GearLever :
    # - nom sans numéro de version
    # - --no-sandbox requis par Electron sur Kinoite (chrome-sandbox SUID absent)
    patch_desktop_entry

    if [ -f "$DESKTOP_ENTRY" ]; then
        echo "✓ OpenCode Desktop installé : $DESKTOP_APPIMAGE"
    else
        echo "✗ Erreur : entrée .desktop GearLever introuvable (${DESKTOP_ENTRY:-aucune candidate détectée})."
        rm -f "$CACHE_FILE"
        exit 1
    fi

    # GearLever déplace normalement le fichier, nettoyage du cache au cas où
    rm -f "$CACHE_FILE"
    rmdir --ignore-fail-on-non-empty "$CACHE_DIR" 2>/dev/null || true
fi

# --- Étape 7 : entrée « Ouvrir avec OpenCode » pour les dossiers dans Dolphin ---
# Wrapper : ouvre le dossier directement dans la GUI, comme si l'utilisateur
# venait de le sélectionner. Le desktop ne consomme pas les deep-links en 2.0.16
# (plumbing câblé, UI sans consommateur, PRs upstream #15479/#45103 ouvertes) et
# ne lit son store qu'au démarrage de la fenêtre — on fait donc ce que fait la
# GUI elle-même, à sa place :
#   1. crée une session API dans le dossier cible (POST /api/session,
#      location.directory — la session vit sur le serveur de fond partagé)
#   2. arrête proprement le desktop s'il tourne (les sessions ne sont PAS
#      perdues : elles sont sur le serveur de fond, la GUI n'est qu'un client)
#   3. écrit son store (drafts.sqlite, table state) : projet ajouté à
#      projects.local, lastProject pointé, session ajoutée aux tabs de chaque
#      fenêtre et focalisée (tabs.recent — schéma key « sidecar\n/server/<b64
#      'sidecar'>/session/<id> » relevé dans le store réel)
#   4. relance la GUI via le deep-link opencode://open-project?directory=...
#      (lance la fenêtre ; consommera le directory tout seul quand upstream
#      livrera le consommateur)
cat > "$LOCAL_BIN/opencode-open" <<'WRAPPER'
#!/bin/bash

# Ouvre un dossier dans OpenCode : mode --cli (TUI dans le dossier, comme
# « opencode <dossier> ») ou mode GUI par défaut (session du dossier mise en
# tab focalisée dans le store du desktop, GUI relancée dessus si nécessaire).

CLI_MODE=0
if [ "$1" = "--cli" ]; then
    CLI_MODE=1
    shift
fi

DIR="${1:-$PWD}"
if [ -d "$DIR" ]; then
    DIR="$(cd "$DIR" && pwd)" || exit 1
else
    # Fichier passé par erreur : ouvrir son dossier parent
    DIR="$(cd "$(dirname "$DIR")" && pwd)" || exit 1
fi

# --- Mode CLI : TUI directement dans le dossier (comportement historique) ---
if [ "$CLI_MODE" = 1 ]; then
    # Fallback chemin explicite : le PATH de session Dolphin peut manquer ~/.local/bin
    OC_BIN="$(command -v opencode || true)"
    if [ -z "$OC_BIN" ] && [ -x "$HOME/.local/bin/opencode" ]; then
        OC_BIN="$HOME/.local/bin/opencode"
    fi
    if [ -z "$OC_BIN" ]; then
        echo "✗ Erreur : binaire opencode introuvable." >&2
        exit 1
    fi
    cd "$DIR" || exit 1
    exec "$OC_BIN" "$DIR"
fi

DESKTOP_CFG="$HOME/.config/ai.opencode.desktop"
DESKTOP_DB="$DESKTOP_CFG/drafts.sqlite"

# --- Lecture du store : session existante pour ce dossier + tab active ? ---
STORE_INFO="$(timeout 10 python3 - "$DESKTOP_DB" "$DIR" <<'PY' 2>/dev/null || true
import json, sqlite3, sys, base64
db, directory = sys.argv[1], sys.argv[2].rstrip("/") or "/"
try:
    con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    row = con.execute("SELECT value FROM state WHERE name='opencode.global.dat' AND key='server'").fetchone()
    data = json.loads(row[0]) if row else {}
    b64 = base64.b64encode(b"sidecar").decode()
    r = con.execute("SELECT name, value FROM state WHERE key='tabs.info'").fetchall()
    found = ""
    for name, val in r:
        info = json.loads(val)
        for k, v in info.items():
            if str(v.get("directory", "")).rstrip("/") == directory and "/session/" in k:
                found = k.rsplit("/session/", 1)[1]
                break
        if found:
            break
    # tab actuellement focalisée (toutes fenêtres, la première trouvée)
    recent_dir = ""
    r = con.execute("SELECT value FROM state WHERE key='tabs.recent'").fetchone()
    if r:
        key = json.loads(r[0]).get("key", "")
        sid = key.rsplit("/session/", 1)[-1] if "/session/" in key else ""
        for name, val in con.execute("SELECT name, value FROM state WHERE key='tabs.info'").fetchall():
            v = json.loads(val).get(key)
            if v:
                recent_dir = str(v.get("directory", "")).rstrip("/")
                break
    running = "yes"
    print(json.dumps({"sid": found, "recent_dir": recent_dir}))
    con.close()
except Exception:
    print(json.dumps({"sid": "", "recent_dir": ""}))
PY
)"
RECENT_DIR="$(printf '%s' "$STORE_INFO" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("recent_dir",""))' 2>/dev/null || true)"

APP_RUNNING=0
if pgrep -f 'AppImages/opencode\.appimage' >/dev/null 2>&1 \
    || pgrep -f '/tmp/\.mount_[A-Za-z0-9]+/ai\.opencode\.desktop' >/dev/null 2>&1; then
    APP_RUNNING=1
fi

# Dossier déjà affiché par la fenêtre active : simple focus via deep-link
if [ "$APP_RUNNING" = 1 ] && [ "$(printf '%s' "$RECENT_DIR" | sed 's:/*$::')" = "$(printf '%s' "$DIR" | sed 's:/*$::')" ]; then
    ENC="$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$DIR")"
    exec xdg-open "opencode://open-project?directory=$ENC"
fi

# --- Session : toujours CRÉER une session fraîche dans le dossier (best-effort).
# Pourquoi pas de réutilisation : au boot, si le projet cible n'est pas le projet
# « actif le plus récent » côté serveur (/api/project, tri par time.active), la GUI
# retombe sur un autre projet (fallback c()[0] du composant Home). Créer une session
# fraîche met time.active du projet à NOW → la GUI retombe toujours sur NOTRE dossier.
# C'est exactement ce que fait l'app quand on ouvre un projet (newDraft).
SID=""
URL=""
OC_BIN="$(command -v opencode || true)"
if [ -z "$OC_BIN" ] && [ -x "$HOME/.local/bin/opencode" ]; then
    OC_BIN="$HOME/.local/bin/opencode"
fi
if [ -n "$OC_BIN" ]; then
    URL="$(timeout 10 "$OC_BIN" service status 2>/dev/null | grep -oE 'http://[0-9.]+:[0-9]+' | head -1 || true)"
fi
if [ -n "$URL" ] && command -v python3 &>/dev/null && [ -f "$HOME/.config/opencode/service.json" ]; then
    SID="$(timeout 20 python3 - "$HOME/.config/opencode/service.json" "$URL" "$DIR" <<'PY' 2>/dev/null || true
import json, sys, base64, urllib.request
pw_file, url, directory = sys.argv[1], sys.argv[2], sys.argv[3]
pw = json.load(open(pw_file)).get("password", "")
body = json.dumps({
    "location": {"directory": directory},
    "title": directory.rsplit("/", 1)[-1] or directory,
}).encode()
req = urllib.request.Request(url.rstrip("/") + "/api/session", data=body,
                             headers={"Content-Type": "application/json"})
req.add_header("Authorization", "Basic " + base64.b64encode(f"opencode:{pw}".encode()).decode())
try:
    with urllib.request.urlopen(req, timeout=10) as r:
        print(json.load(r)["data"]["id"])
except Exception:
    pass
PY
)"
fi

# --- Arrêt propre du desktop s'il tourne (client seul : sessions préservées
#        sur le serveur de fond) ---
# SIGTERM UNIQUEMENT au process principal (Electron le gère : killSidecar +
# app.exit(0) → il ferme ses enfants lui-même). Tuer l'arbre en bloc provoque
# des SIGBUS en cascade : le squashfs AppImage (/tmp/.mount_*) est démonté
# pendant que zygote/gpu/renderer/crashpad ont encore leurs pages mappées
# dessus (coredumps constatés). JAMAIS le serveur de fond
# (~/.config/ai.opencode.desktop/cli/*/opencode-cli serve --service).
if [ "$APP_RUNNING" = 1 ]; then
    # 1) SIGTERM au(x) process principal(aux) : binaire .mount sans --type=
    #    (les enfants ont --type=zygote/gpu/renderer/utility, crashpad a son
    #    propre binaire chrome_crashpad_handler) + runtime AppImage si monté
    for p in $(pgrep -f '/tmp/\.mount_[A-Za-z0-9]+/ai\.opencode\.desktop' 2>/dev/null); do
        PCMD="$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null)" || continue
        case "$PCMD" in
            *"--type="*|*crashpad*) continue ;;
        esac
        kill -TERM "$p" 2>/dev/null || true
    done
    # Runtime AppImage : si aucun process .mount n'existe (app en cours de
    # lancement, mount pas encore apparu), c'est lui le principal
    if ! pgrep -f '/tmp/\.mount_[A-Za-z0-9]+/ai\.opencode\.desktop' >/dev/null 2>&1; then
        pkill -TERM -f 'AppImages/opencode\.appimage' 2>/dev/null || true
    fi
    # 2) Attente de l'arbre COMPLET : enfants .mount + crashpad + runtime
    #    (jusqu'à ~20 s — un SIGKILL prématuré démonte le squashfs sous les
    #    survivants = SIGBUS)
    for _ in $(seq 1 40); do
        APP_ALIVE=0
        pgrep -f '/tmp/\.mount_[A-Za-z0-9]+/ai\.opencode\.desktop' >/dev/null 2>&1 && APP_ALIVE=1
        pgrep -f 'AppImages/opencode\.appimage' >/dev/null 2>&1 && APP_ALIVE=1
        pgrep -f '/tmp/\.mount_[A-Za-z0-9]+/chrome_crashpad_handler' >/dev/null 2>&1 && APP_ALIVE=1
        [ "$APP_ALIVE" = 0 ] && break
        sleep 0.5
    done
    # 3) SIGKILL en dernier recours (processus récalcitrants uniquement)
    if [ "$APP_ALIVE" = 1 ]; then
        pkill -KILL -f '/tmp/\.mount_[A-Za-z0-9]+/ai\.opencode\.desktop' 2>/dev/null || true
        pkill -KILL -f '/tmp/\.mount_[A-Za-z0-9]+/chrome_crashpad_handler' 2>/dev/null || true
        pkill -KILL -f 'AppImages/opencode\.appimage' 2>/dev/null || true
        sleep 1
    fi
fi

# --- Store du desktop : projet + lastProject + tab (ré) focalisée ---
# sqlite3.connect(timeout=...) : busy-handler — l'app qui vient de s'arrêter
# peut encore tenir le verrou WAL quelques instants. L'écriture est vérifiée
# (relecture de tabs.recent) et retentée : une écriture ratée silencieusement
# = l'app repart sur l'ancien tab (bug constaté).
if command -v python3 &>/dev/null && [ -f "$DESKTOP_DB" ]; then
    timeout 40 python3 - "$DESKTOP_DB" "$DIR" "$SID" <<'PY' >/dev/null 2>&1 || true
import json, sqlite3, sys, time, base64
db, directory, sid = sys.argv[1], sys.argv[2].rstrip("/") or "/", sys.argv[3] or ""
now = int(time.time() * 1000)
b64 = base64.b64encode(b"sidecar").decode()
tab_key = f"sidecar\n/server/{b64}/session/{sid}" if sid else ""
expected_recent = json.dumps({"key": tab_key}) if tab_key else None

def apply(con):
    def put(name, key, value):
        con.execute(
            "INSERT INTO state(name,key,value,updated_at) VALUES(?,?,?,?) "
            "ON CONFLICT(name,key) DO UPDATE SET value=excluded.value, updated_at=excluded.updated_at",
            (name, key, value, now),
        )
    # projets + dernier projet + sélection home (liste affichée dans la GUI).
    # Au démarrage, l'app pré-sélectionne : home.selection (layout) PUIS
    # projects.last (store server) — ils écrasent tabs.recent s'ils pointent
    # ailleurs. Les trois doivent viser le dossier cible.
    row = con.execute("SELECT value FROM state WHERE name='opencode.global.dat' AND key='server'").fetchone()
    data = json.loads(row[0]) if row else {}
    projects = data.setdefault("projects", {}).setdefault("local", [])
    if not any(str(p.get("worktree", "")).rstrip("/") == directory for p in projects):
        projects.append({"worktree": directory, "expanded": True})
    data.setdefault("lastProject", {})["local"] = directory
    put("opencode.global.dat", "server", json.dumps(data, ensure_ascii=False))
    row = con.execute("SELECT value FROM state WHERE name='opencode.global.dat' AND key='layout'").fetchone()
    layout = json.loads(row[0]) if row else {}
    layout.setdefault("home", {})["selection"] = {"server": "sidecar", "directory": directory}
    put("opencode.global.dat", "layout", json.dumps(layout, ensure_ascii=False))
    # tabs : session ajoutée + focalisée dans chaque fenêtre connue
    if sid:
        names = [r[0] for r in con.execute("SELECT DISTINCT name FROM state WHERE name LIKE 'opencode.window.%'")]
        for name in names:
            r = con.execute("SELECT value FROM state WHERE name=? AND key='tabs'", (name,)).fetchone()
            tabs = json.loads(r[0]) if r else []
            if not any(t.get("sessionId") == sid for t in tabs):
                tabs.append({"type": "session", "server": "sidecar", "sessionId": sid})
            put(name, "tabs", json.dumps(tabs))
            put(name, "tabs.recent", expected_recent)
            r = con.execute("SELECT value FROM state WHERE name=? AND key='tabs.info'", (name,)).fetchone()
            info = json.loads(r[0]) if r else {}
            info.setdefault(tab_key, {})
            info[tab_key].setdefault("title", directory.rsplit("/", 1)[-1])
            info[tab_key]["directory"] = directory
            put(name, "tabs.info", json.dumps(info, ensure_ascii=False))
    con.commit()

def verify(con):
    if not expected_recent:
        return True
    for _name, val in con.execute("SELECT name, value FROM state WHERE key='tabs.recent'").fetchall():
        if val == expected_recent:
            return True
    return False

# 3 tentatives : verrou WAL de l'app qui vient de s'arrêter, flush tardif…
for attempt in range(3):
    try:
        con = sqlite3.connect(db, timeout=10)
        try:
            apply(con)
            if verify(con):
                break
        finally:
            con.close()
    except Exception:
        pass
    time.sleep(2)
PY
fi

# --- Écriture du localStorage Electron (LevelDB) : la VRAIE clé du démarrage ---
# La route restaurée par la GUI au lancement = localStorage
# « opencode.desktop.window.<id>.last-active-url » (function gie/X9 du bundle),
# prioritaire sur tout le store SQLite. Format LevelDB log :
#   blocs 32 Ko, records [header 7o: crc32c masqué(4) len(2) type(1)] + payload
#   types Full=1/First=2/Middle=3/Last=4 (batch long = fragments, jamais à
#   cheval sur deux blocs) ; batch = [seq(8) count(4) entries] avec
#   entry = [type=1][varint klen][key][varint vlen][value]
#   key = "_oc://renderer\x00\x01" + nom-clé, value = \x01 + texte
# ATTENTION : le champ count est en offset 8-12 du batch (offset 4-8 = poids
# fort du seq — bug historique qui écrivait count=1 → « WriteBatch has wrong
# count » au boot → batch JETÉ → route perdue, l'app restaurait l'ancienne).
# Stratégie : (1) réparer les batchs dont count ne correspond pas au nombre
# d'entries parsées, (2) écrire la route en NOUVEAU batch en fin de log
# (seq = max(seq+count)+1, count=1) — aucun batch de l'app n'est modifié et le
# dernier batch appliqué gagne. L'app doit être arrêtée (LevelDB verrouillé).
if command -v python3 &>/dev/null && [ -d "$HOME/.config/ai.opencode.desktop/Local Storage/leveldb" ]; then
    timeout 30 python3 - "$HOME/.config/ai.opencode.desktop/Local Storage/leveldb" "$DIR" <<'PY' >/dev/null 2>&1 || true
import glob, json, os, re, sqlite3, struct, sys

ldb_dir, directory = sys.argv[1], sys.argv[2].rstrip("/") or "/"
db = os.path.expanduser("~/.config/ai.opencode.desktop/drafts.sqlite")

BLOCK, HDR = 32768, 7

def read_varint(buf, i):
    res = shift = 0
    while True:
        if i >= len(buf):
            return None, i
        b = buf[i]
        i += 1
        res |= (b & 0x7F) << shift
        if not (b & 0x80):
            return res, i
        shift += 7
        if shift > 35:
            return None, i

def crc32c(d):
    poly = 0x82F63B78
    c = 0xFFFFFFFF
    for b in d:
        c ^= b
        for _ in range(8):
            c = (c >> 1) ^ (poly if c & 1 else 0)
    return c ^ 0xFFFFFFFF

def mask(c):
    return (((c >> 15) | (c << 17)) + 0xA282EAD8) & 0xFFFFFFFF

def varint(n):
    out = b""
    while True:
        b = n & 0x7F
        n >>= 7
        out += bytes([b | (0x80 if n else 0)])
        if not n:
            return out

def scan_records(data):
    """Records physiques : un record tient dans un bloc, jamais à cheval."""
    recs = []
    n = len(data)
    bstart = 0
    while bstart < n:
        bend = min(bstart + BLOCK, n)
        p = bstart
        while p + HDR <= bend:
            crc, length, btype = struct.unpack_from("<IHB", data, p)
            if btype == 0 and crc == 0 and length == 0:
                break
            if length > bend - p - HDR:
                break
            recs.append((p, p + HDR, length, btype))
            p += HDR + length
        bstart += BLOCK
    return recs

def group_batches(recs):
    """Assemble les fragments (Full=1, First=2, Middle=3, Last=4) en batchs."""
    batches, cur = [], None
    for hdr_off, poff, length, btype in recs:
        if btype == 1:
            cur = None
            if length >= 12:
                batches.append({"hdr": hdr_off, "poff": poff, "len": length,
                                "btype": btype, "frags": [(poff, length)]})
        elif btype == 2:
            cur = None
            if length >= 12:
                cur = {"hdr": hdr_off, "poff": poff, "len": length,
                       "btype": btype, "frags": [(poff, length)]}
        elif btype in (3, 4) and cur is not None:
            cur["frags"].append((poff, length))
            if btype == 4:
                batches.append(cur)
                cur = None
    return batches

def batch_payload(data, b):
    return b"".join(data[poff:poff + length] for poff, length in b["frags"])

def count_entries(payload):
    i, found = 12, 0
    while i < len(payload):
        tag = payload[i]
        i += 1
        klen, i = read_varint(payload, i)
        if klen is None or i + klen > len(payload):
            return -1
        i += klen
        if tag == 1:
            vlen, i = read_varint(payload, i)
            if vlen is None or i + vlen > len(payload):
                return -1
            i += vlen
        elif tag != 0:
            return -1
        found += 1
    return found

def write_record(data, hdr_off, poff, btype, payload):
    data[poff:poff + len(payload)] = payload
    data[hdr_off:hdr_off + HDR] = struct.pack(
        "<IHB", mask(crc32c(bytes([btype]) + payload)), len(payload), btype)

# --- 0) log actif : le .log au numéro le plus élevé (LevelDB réutilise le
#        même log, mais par robustesse on ne présume pas de 000003.log) ---
logs = sorted(glob.glob(os.path.join(ldb_dir, "*.log")),
              key=lambda p: int(re.sub(r"\D", "", os.path.basename(p)) or 0))
if not logs:
    sys.exit(0)
target = logs[-1]

# --- 1) route cible : session connue pour ce directory (tabs.info) ---
route = ""
try:
    con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    for _name, val in con.execute("SELECT name, value FROM state WHERE key='tabs.info'").fetchall():
        info = json.loads(val)
        for k, v in info.items():
            if str(v.get("directory", "")).rstrip("/") == directory and "/session/" in k:
                route = "/server/c2lkZWNhcg/session/" + k.rsplit("/session/", 1)[1]
                break
        if route:
            break
    con.close()
except Exception:
    pass
if not route:
    sys.exit(0)

# --- 2) fenêtre cible : uuid de la fenêtre la plus récente ---
win_uuid = ""
try:
    con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    row = con.execute(
        "SELECT name FROM state WHERE name LIKE 'opencode.window.%' "
        "ORDER BY updated_at DESC LIMIT 1").fetchone()
    if row:
        win_uuid = row[0].replace("opencode.window.", "").replace(".dat", "")
    con.close()
except Exception:
    pass
if not win_uuid:
    sys.exit(0)

key = (b"_oc://renderer\x00\x01opencode.desktop.window."
       + win_uuid.encode() + b".last-active-url")
value = b"\x01" + route.encode()

data = bytearray(open(target, "rb").read())
recs = scan_records(data)
batches = group_batches(recs)
if not recs:
    sys.exit(0)

# --- 3) réparation des batchs corrompus (count != entries parsées) ---
for b in batches:
    payload = batch_payload(data, b)
    found = count_entries(payload)
    if found < 0:
        continue
    if struct.unpack_from("<I", payload, 8)[0] != found:
        # le champ count vit dans le PREMIER fragment (payload[8:12])
        fp = bytearray(data[b["poff"]:b["poff"] + b["len"]])
        fp[8:12] = struct.pack("<I", found)
        write_record(data, b["hdr"], b["poff"], b["btype"], bytes(fp))

# --- 4) route en NOUVEAU batch en fin de log (gagnant à la restauration :
#        dernier batch appliqué + seq le plus élevé) ---
max_seq = 0
for b in batches:
    p = batch_payload(data, b)
    if len(p) >= 12:
        max_seq = max(max_seq, struct.unpack_from("<Q", p, 0)[0]
                      + struct.unpack_from("<I", p, 8)[0])
entry = bytes([1]) + varint(len(key)) + key + varint(len(value)) + value
batch = struct.pack("<Q", max_seq + 1) + struct.pack("<I", 1) + entry
hdr_off, poff, length, btype = recs[-1]
end = poff + length
block_end = (end // BLOCK + 1) * BLOCK
pos = end if end + HDR + len(batch) <= block_end else block_end
data += bytes(pos - len(data))
data += struct.pack("<IHB", mask(crc32c(bytes([1]) + batch)), len(batch), 1)
data += batch
open(target, "wb").write(bytes(data))
PY
fi

# --- Relance : deep-link encodé (lance la GUI ; consommera le directory tout
#     seul quand upstream livrera le consommateur de deep-links) ---
ENC="$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$DIR")"
exec xdg-open "opencode://open-project?directory=$ENC"
WRAPPER
chmod +x "$LOCAL_BIN/opencode-open"

# .desktop NoDisplay : invisible dans le menu des applications, proposé dans
# Dolphin → clic droit → « Ouvrir avec » sur un dossier. Terminal=false : la
# fenêtre de l'app desktop s'ouvre directement (plus de terminal). Icône : même
# chemin que l'entrée GearLever (pas d'icône hicolor nommée « opencode »).
APPS_DIR="$HOME/.local/share/applications"
mkdir -p "$APPS_DIR"
cat > "$APPS_DIR/gablue-opencode.desktop" <<EOF
[Desktop Entry]
Comment=Ouvre le dossier dans OpenCode Desktop
Exec=$LOCAL_BIN/opencode-open %f
Icon=$HOME/AppImages/.icons/opencode
MimeType=inode/directory;
Name=OpenCode
NoDisplay=true
Terminal=false
Type=Application
X-KDE-StartupNotify=false
EOF
echo "✓ Entrée « Ouvrir avec OpenCode » installée : $APPS_DIR/gablue-opencode.desktop"

# Entrée terminal « OpenCode CLI » : lance la TUI dans le dossier (comportement
# historique, conservé en plus de la GUI). Terminal=true → lancée dans le
# terminal système ; `%k` = chemin du .desktop, le wrapper s'en sert pour
# émuler l'ancien lancement direct « opencode <dossier> ».
cat > "$APPS_DIR/gablue-opencode-cli.desktop" <<EOF
[Desktop Entry]
Comment=Ouvre le dossier dans OpenCode CLI (terminal)
Exec=$LOCAL_BIN/opencode-open --cli %f
Icon=utilities-terminal
MimeType=inode/directory;
Name=OpenCode CLI
NoDisplay=true
Terminal=true
Type=Application
X-KDE-StartupNotify=false
EOF
echo "✓ Entrée « Ouvrir avec OpenCode CLI » installée : $APPS_DIR/gablue-opencode-cli.desktop"

# Rafraîchir les caches pour une prise en effet immédiate (best-effort)
command -v kbuildsycoca6 &>/dev/null && kbuildsycoca6 --noincremental &>/dev/null || true
command -v update-desktop-database &>/dev/null && update-desktop-database "$APPS_DIR" &>/dev/null || true

# Redémarrer le service de fond UNIQUEMENT si la version du CLI a changé :
# CLI, desktop et sessions sont tous connectés au même serveur — un restart
# inconditionnel rebondit toutes les sessions ouvertes (CLI + desktop) même
# sans mise à jour (best-effort)
if [ -n "$CLI_VERSION_AFTER" ] && [ "$CLI_VERSION_BEFORE" != "$CLI_VERSION_AFTER" ]; then
    echo "Version CLI changée ($CLI_VERSION_BEFORE -> $CLI_VERSION_AFTER), redémarrage du service de fond..."
    timeout 30 opencode service restart &>/dev/null || true
fi

echo "Opération terminée. OpenCode 2 est disponible via 'opencode' et 'opencode2' (CLI)"
echo "et OpenCode Desktop est disponible dans le menu des applications."
