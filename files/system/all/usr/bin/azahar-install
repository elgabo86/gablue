#!/bin/bash

# Script pour télécharger et installer/mettre à jour AzaharPlus (Linux version) avec GearLever

# Dépendances : curl, jq, flatpak (GearLever installé comme it.mijorus.gearlever), yes

set -e

REPO="AzaharPlus/AzaharPlus"
CACHE_DIR="$HOME/.cache/azahar"
APPIMAGES_DIR="$HOME/AppImages"
mkdir -p "$CACHE_DIR"

# Obtenir les infos de la dernière release via GitHub API
RELEASE_JSON=$(curl -sL "https://api.github.com/repos/$REPO/releases/latest")

# Extraire l'URL de téléchargement pour l'AppImage Linux
ASSET_NAME_PATTERN="linux.AppImage"
DOWNLOAD_URL=$(echo "$RELEASE_JSON" | jq -r --arg pattern "$ASSET_NAME_PATTERN" '.assets[] | select(.name | contains($pattern)) | .browser_download_url')

if [ -z "$DOWNLOAD_URL" ]; then
    echo "Erreur : AppImage Linux non trouvée dans la dernière release."
    exit 1
fi

# Extraire le nom du fichier
ASSET_NAME=$(basename "$DOWNLOAD_URL")

# Chemin du fichier à télécharger
APPIMAGE_FILE="$CACHE_DIR/$ASSET_NAME"

# Télécharger l'AppImage
echo "Téléchargement de $ASSET_NAME..."
curl -L -o "$APPIMAGE_FILE" "$DOWNLOAD_URL"
chmod +x "$APPIMAGE_FILE"

echo "AppImage téléchargé : $ASSET_NAME"

# Vérifier si une version est déjà installée et la supprimer
INSTALLED_APPIMAGE=$(find "$APPIMAGES_DIR" -maxdepth 1 -iname "azahar*.appimage" | head -n1 || true)

if [ -n "$INSTALLED_APPIMAGE" ]; then
    echo "Suppression de la version installée existante."
    yes | flatpak run it.mijorus.gearlever --remove "$INSTALLED_APPIMAGE" 2>/dev/null || true
fi

# Installer avec GearLever sans confirmation (comme dans le script original)
echo "Installation/Mise à jour avec GearLever..."
yes | flatpak run it.mijorus.gearlever --integrate "$APPIMAGE_FILE" 2>/dev/null || true

# Corriger le .desktop pour enlever le (hash) et mettre la première lettre en majuscule
DESKTOP_DIR="$HOME/.local/share/applications"
DESKTOP_FILE=$(find "$DESKTOP_DIR" -name "azahar*.desktop" -type f | head -n1)
if [ -n "$DESKTOP_FILE" ]; then
    sed -i 's/^Name=[Aa]zahar[Pp]lus (.*)$/Name=AzaharPlus/' "$DESKTOP_FILE"
    sed -i 's/^Name=[Aa]zahar[Pp]lus$/Name=AzaharPlus/' "$DESKTOP_FILE"
    sed -i 's/^Name=[Aa]zahar (.*)$/Name=Azahar/' "$DESKTOP_FILE"
    sed -i 's/^Name=[Aa]zahar$/Name=Azahar/' "$DESKTOP_FILE"
    sed -i '/^X-AppImage-Version=/d' "$DESKTOP_FILE"  # Optionnel: enlever la ligne version
fi

# Nettoyer le cache
rm -f "$APPIMAGE_FILE"
rmdir --ignore-fail-on-non-empty "$CACHE_DIR"

# Rafraîchir les fichiers .desktop
kbuildsycoca6

echo "Opération terminée."