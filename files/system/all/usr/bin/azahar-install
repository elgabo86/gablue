#!/bin/bash

# Azahar — coquille de compatibilité.
#
# Le téléchargement (reprise, anti-cale, contrôle ELF) et l'intégration
# GearLever vivent dans le moteur `/usr/libexec/gablue-apps`, décrit par
# `/usr/share/ublue-os/gablue/apps.toml`. Ce nom reste : CLI documentée, sonde
# d'état de Gablue Manager, habitude des utilisateurs.

set -e
exec /usr/libexec/gablue-apps install azahar "$@"
