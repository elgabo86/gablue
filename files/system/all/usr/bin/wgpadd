#!/bin/bash

# Ajoute des packs WGP dans ES-DE (EmulationStation Desktop Edition)
#
# Usage :
#   wgpadd [--windows|--xbox360] [fichier1.wgp fichier2.wgp ...]
#
# - Sans fichier en argument : traite tous les .wgp du dossier courant
# - Avec des fichiers .wgp en argument : ne traite que ceux-ci
#
# Options :
#   --windows  (défaut) : lanceur .sh dans .es-wgp + lien dans ~/Roms/windows
#                         (le système "windows" natif d'ES-DE ne connaît pas .wgp)
#   --xbox360           : lien direct du .wgp dans ~/Roms/xbox360
#                         (le système xbox360 supporte nativement l'extension .wgp
#                          via la commande "WGP Windows Game Pack", pas de .sh)
#
# Télécharge le cover dans ~/ES-DE/downloaded_media/<section>/covers
# (s'il n'existe pas déjà).

LAUNCH_SCRIPT="/usr/bin/gwine"
SECTION="windows"
FILES=()

# Analyse des arguments : options + fichiers .wgp
for arg in "$@"; do
    case "$arg" in
        --windows)  SECTION="windows" ;;
        --xbox360)  SECTION="xbox360" ;;
        *.wgp)      FILES+=("$arg") ;;
        *)          echo "Argument ignoré : $arg" ;;
    esac
done

# Sans fichier en argument, scanner le dossier courant
if [ ${#FILES[@]} -eq 0 ]; then
    shopt -s nullglob
    for f in "$(pwd)"/*.wgp; do
        FILES+=("$f")
    done
    shopt -u nullglob

    if [ ${#FILES[@]} -eq 0 ]; then
        echo "Aucun fichier .wgp trouvé dans $(pwd)"
        exit 0
    fi
fi

for wgp_file in "${FILES[@]}"; do
    if [ ! -f "$wgp_file" ]; then
        echo "Fichier introuvable : $wgp_file"
        echo "---"
        continue
    fi

    onlyapp=$(basename "$wgp_file" .wgp)
    fullpath=$(realpath "$wgp_file")

    if [ "$SECTION" = "windows" ]; then
        # Section windows : création du lanceur .sh (le système natif ES-DE
        # ne connaît pas l'extension .wgp)
        script_dir="$(dirname "$fullpath")/.es-wgp"
        script_sh="$script_dir/$onlyapp.sh"

        # Créer le dossier .es-wgp si nécessaire
        mkdir -p "$script_dir"

        # Vérifier si le .fix existe dans le pack .wgp
        MOUNT_BASE="/tmp/wgpack_check_$(date +%s)_$$"
        MOUNT_DIR="$MOUNT_BASE/mount"
        mkdir -p "$MOUNT_DIR"
        HAS_FIX=false

        if command -v squashfuse &> /dev/null; then
            squashfuse -r "$fullpath" "$MOUNT_DIR" 2>/dev/null
            if [ $? -eq 0 ]; then
                if [ -f "$MOUNT_DIR/.fix" ]; then
                    HAS_FIX=true
                fi
                fusermount -u "$MOUNT_DIR" 2>/dev/null
            fi
        fi
        rm -rf "$MOUNT_BASE"

        # Déterminer le mode
        if [ "$HAS_FIX" = true ]; then
            choice="fix"
            echo "$onlyapp: mode fix (détecté via .fix)"
        else
            choice="normal"
            echo "$onlyapp: mode normal"
        fi

        # Créer ou remplacer le script .sh
        echo "#!/bin/bash" > "$script_sh"
        if [ "$choice" = "fix" ]; then
            echo "exec \"$LAUNCH_SCRIPT\" --fix \"$fullpath\"" >> "$script_sh"
        else
            echo "exec \"$LAUNCH_SCRIPT\" \"$fullpath\"" >> "$script_sh"
        fi
        chmod +x "$script_sh"
        echo "Script créé : $script_sh"
    fi

    # Trouver le dossier Roms/<section> (insensible à la casse)
    link_dir=""
    for dir in "$HOME"/[Rr][Oo][Mm][Ss]/*/; do
        [ -d "$dir" ] || continue
        base_dirname=$(basename "$dir")
        if [ "${base_dirname,,}" = "$SECTION" ]; then
            link_dir="$dir"
            break
        fi
    done

    if [ -z "$link_dir" ]; then
        link_dir="$HOME/Roms/$SECTION"
        mkdir -p "$link_dir"
    fi

    # Créer ou mettre à jour le lien symbolique
    if [ "$SECTION" = "windows" ]; then
        link_game="$link_dir/$onlyapp.sh"
        ln -sf "$script_sh" "$link_game"
        echo "Lien symbolique : $link_game -> $script_sh"
    else
        # Section xbox360 : lien direct vers le .wgp (extension native, gwine %ROM%)
        link_game="$link_dir/$onlyapp.wgp"
        ln -sf "$fullpath" "$link_game"
        echo "Lien symbolique : $link_game -> $fullpath"
    fi

    # Trouver le dossier ES-DE (insensible à la casse)
    cover_dir=""
    for esde in "$HOME"/[Ee][Ss]-[Dd][Ee]/downloaded_media/"$SECTION"/covers; do
        if [ -d "$esde" ]; then
            cover_dir="$esde"
            break
        fi
    done

    if [ -z "$cover_dir" ]; then
        cover_dir="$HOME/ES-DE/downloaded_media/$SECTION/covers"
        mkdir -p "$cover_dir"
    fi

    # Vérifier si un cover existe déjà
    cover_exists=false
    for ext in .png .jpg .jpeg; do
        if [ -f "$cover_dir/$onlyapp$ext" ]; then
            cover_exists=true
            echo "Cover existant : $cover_dir/$onlyapp$ext (pas de téléchargement)"
            break
        fi
    done

    # Télécharger le cover seulement s'il n'existe pas
    if [ "$cover_exists" = false ]; then
        encoded_name=$(echo "$onlyapp" | sed 's/ /%20/g')
        search_url="https://steamgrid.usebottles.com/api/search/$encoded_name"
        response=$(curl -s "$search_url")

        if [ -z "$response" ]; then
            echo "Erreur : impossible de contacter l'API pour $onlyapp"
            echo "---"
            continue
        fi

        image_url=$(echo "$response" | grep -o 'https://[^"]*\.\(jpg\|png\|jpeg\)' | head -n 1)
        if [ -z "$image_url" ]; then
            echo "Aucune image trouvée pour $onlyapp"
            echo "---"
            continue
        fi

        ext=$(echo "$image_url" | grep -o '\.\(jpg\|png\|jpeg\)$')
        output_cover="$cover_dir/$onlyapp$ext"

        curl -s "$image_url" -o "$output_cover"
        if [ $? -eq 0 ]; then
            echo "Cover téléchargé : $output_cover"
        else
            echo "Échec du téléchargement du cover pour $onlyapp"
            rm -f "$output_cover"
        fi
    fi

    echo "---"
done

echo "Terminé : tous les fichiers .wgp ont été traités (section : $SECTION)"
