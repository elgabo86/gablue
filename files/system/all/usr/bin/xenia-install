#!/bin/bash

# Xenia Edge — coquille de compatibilité.
#
# Le téléchargement (reprise, anti-cale, contrôle ELF) et l'intégration
# GearLever vivent dans le moteur `/usr/libexec/gablue-apps`, décrit par
# `/usr/share/ublue-os/gablue/apps.toml`. L'asset porte un nom fixe, le tag est
# un hachage de commit : le moteur lit les deux dans le flux et la page
# `expanded_assets` du tag. Ce nom reste : CLI documentée, sonde d'état de
# Gablue Manager, habitude des utilisateurs.

set -e
exec /usr/libexec/gablue-apps install xenia "$@"
