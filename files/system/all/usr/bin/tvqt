# =============================================================================
# WIDGET MPV EMBARQUÉ (libmpv + OpenGL)
# =============================================================================

class _MpvOpenGLInitParams(Structure):
    _fields_ = [("get_proc_address", c_void_p), ("get_proc_address_ctx", c_void_p)]


class _MpvOpenGLFBO(Structure):
    _fields_ = [("fbo", c_int), ("w", c_int), ("h", c_int), ("internal_format", c_int)]


class _MpvRenderParam(Structure):
    _fields_ = [("type", c_int), ("data", c_void_p)]


_GetProcAddrFn = CFUNCTYPE(c_void_p, c_void_p, c_char_p)
_UpdateCallbackFn = CFUNCTYPE(None, c_void_p)


class MpvWidget(QOpenGLWidget):
    """Widget vidéo embarquant mpv via libmpv et OpenGL."""

    # Signal émis depuis le thread mpv, reçu dans le thread GUI (QueuedConnection).
    # mpv appelle le callback de mise à jour depuis un thread interne : on ne
    # doit JAMAIS toucher à Qt directement depuis ce thread (deadlock/freeze,
    # visible surtout sous QEMU/virgl où le rendu GL est plus lent).
    _mpv_updated = Signal()

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setUpdateBehavior(QOpenGLWidget.UpdateBehavior.PartialUpdate)
        self._mpv_updated.connect(self.update, Qt.QueuedConnection)

        locale.setlocale(locale.LC_NUMERIC, "C")
        self._lib = ctypes.CDLL(_LIBMPV_PATH)
        self._setup_libmpv_api()

        self._handle = self._lib_mpv_create()
        # Python 3.14 : c_void_p devient int, wrapper explicite requis
        self._handle = c_void_p(self._handle)
        if not self._handle:
            raise RuntimeError("libmpv: mpv_create() failed")

        self._lib_mpv_set_option_string(self._handle, b"vo", b"libmpv")
        self._lib_mpv_set_option_string(self._handle, b"gpu-api", b"opengl")
        # En VM : décodage logiciel (VDPAU/virgl échoue et fige virtio-gpu)
        self._lib_mpv_set_option_string(
            self._handle, b"hwdec", b"no" if _IS_VM else b"auto-safe"
        )
        self._lib_mpv_set_option_string(self._handle, b"profile", b"fast")
        self._lib_mpv_set_option_string(self._handle, b"alang", b"fr,eng,ita,deu,spa,jpn,und")
        self._lib_mpv_set_option_string(self._handle, b"slang", b"fr,eng")
        self._lib_mpv_set_option_string(self._handle, b"keep-open", b"yes")
        self._lib_mpv_set_option_string(self._handle, b"stop-screensaver", b"yes")

        if self._lib_mpv_initialize(self._handle) < 0:
            raise RuntimeError("libmpv: mpv_initialize() failed")

        self._gl_ctx = None
        self._get_proc_addr_cb = _GetProcAddrFn(self._get_proc_address)
        self._update_cb = _UpdateCallbackFn(self._on_mpv_update)
        self._playing = False
        self._right_click_cb = None

    def _setup_libmpv_api(self):
        L = self._lib
        self._lib_mpv_create = L.mpv_create
        self._lib_mpv_create.restype = c_void_p
        self._lib_mpv_initialize = L.mpv_initialize
        self._lib_mpv_initialize.argtypes = [c_void_p]
        self._lib_mpv_initialize.restype = c_int
        self._lib_mpv_set_option_string = L.mpv_set_option_string
        self._lib_mpv_set_option_string.argtypes = [c_void_p, c_char_p, c_char_p]
        self._lib_mpv_set_option_string.restype = c_int
        self._lib_mpv_command_string = L.mpv_command_string
        self._lib_mpv_command_string.argtypes = [c_void_p, c_char_p]
        self._lib_mpv_command_string.restype = c_int
        self._lib_mpv_get_property = L.mpv_get_property
        self._lib_mpv_get_property.restype = c_int
        self._lib_mpv_terminate_destroy = L.mpv_terminate_destroy
        self._lib_mpv_terminate_destroy.argtypes = [c_void_p]
        self._lib_mpv_render_context_create = L.mpv_render_context_create
        self._lib_mpv_render_context_create.restype = c_int
        self._lib_mpv_render_context_set_update_callback = L.mpv_render_context_set_update_callback
        self._lib_mpv_render_context_set_update_callback.argtypes = [c_void_p, _UpdateCallbackFn, c_void_p]
        self._lib_mpv_render_context_render = L.mpv_render_context_render
        self._lib_mpv_render_context_render.restype = c_int
        self._lib_mpv_render_context_free = L.mpv_render_context_free
        self._lib_mpv_render_context_free.argtypes = [c_void_p]

    @staticmethod
    def _get_proc_address(_ctx, name):
        """Callback de résolution des fonctions OpenGL pour libmpv."""
        glctx = QOpenGLContext.currentContext()
        if not glctx:
            return 0
        try:
            fn = name.decode() if isinstance(name, bytes) else str(name)
            addr = glctx.getProcAddress(fn)
            return int(addr) if addr else 0
        except Exception:
            return 0

    def initializeGL(self):
        init_params = _MpvOpenGLInitParams(
            ctypes.cast(self._get_proc_addr_cb, c_void_p),
            c_void_p(0),
        )

        params = (_MpvRenderParam * 4)()
        params[0] = _MpvRenderParam(
            _MPV_RENDER_PARAM_API_TYPE,
            ctypes.cast(ctypes.c_char_p(b"opengl"), c_void_p),
        )
        params[1] = _MpvRenderParam(
            _MPV_RENDER_PARAM_OPENGL_INIT_PARAMS,
            ctypes.cast(ctypes.byref(init_params), c_void_p),
        )
        params[2] = _MpvRenderParam(_MPV_RENDER_PARAM_INVALID, c_void_p(0))

        gl_ctx = c_void_p()
        if self._lib_mpv_render_context_create(
            ctypes.byref(gl_ctx), self._handle, params
        ) < 0:
            raise RuntimeError("libmpv: render_context_create() failed")
        self._gl_ctx = gl_ctx
        self._lib_mpv_render_context_set_update_callback(
            self._gl_ctx, self._update_cb, c_void_p(0)
        )

    def paintGL(self):
        if not self._gl_ctx:
            return
        rect = self.rect()
        fbo_data = _MpvOpenGLFBO(
            self.defaultFramebufferObject(), rect.width(), rect.height(), 0
        )
        flip_y = c_int(1)

        params = (_MpvRenderParam * 3)()
        params[0] = _MpvRenderParam(
            _MPV_RENDER_PARAM_OPENGL_FBO, ctypes.cast(ctypes.byref(fbo_data), c_void_p)
        )
        params[1] = _MpvRenderParam(
            _MPV_RENDER_PARAM_FLIP_Y, ctypes.cast(ctypes.byref(flip_y), c_void_p)
        )
        params[2] = _MpvRenderParam(_MPV_RENDER_PARAM_INVALID, c_void_p(0))

        self._lib_mpv_render_context_render(self._gl_ctx, params)

    def _on_mpv_update(self, _ctx):
        self._mpv_updated.emit()

    def play(self, url):
        self._lib_mpv_command_string(self._handle, f"loadfile {url}".encode())
        self._playing = True

    def is_rendering(self):
        """Retourne True si la vidéo est effectivement en train de jouer."""
        if not self._playing:
            return False
        val = ctypes.c_double()
        fmt = c_int(5)  # MPV_FORMAT_DOUBLE
        ret = self._lib_mpv_get_property(
            self._handle, b"time-pos", fmt, ctypes.byref(val)
        )
        return ret >= 0

    def command(self, *args):
        cmd = " ".join(str(a) for a in args).encode()
        self._lib_mpv_command_string(self._handle, cmd)

    def stop(self):
        if self._gl_ctx:
            self._lib_mpv_render_context_free(self._gl_ctx)
            self._gl_ctx = None
        if self._handle:
            self._lib_mpv_terminate_destroy(self._handle)
            self._handle = None
        self._playing = False

    def mouseDoubleClickEvent(self, event):
        """Double-clic gauche : bascule plein écran sur l'écran contenant le curseur."""
        if event.button() == Qt.LeftButton:
            win = self.window()
            if win.isFullScreen():
                win.showNormal()
            else:
                screen = QApplication.screenAt(QCursor.pos())
                if screen:
                    win.setGeometry(screen.geometry())
                win.showFullScreen()

    def mouseReleaseEvent(self, event):
        """Clic droit : retour au menu."""
        if event.button() == Qt.RightButton:
            if self._right_click_cb:
                self._right_click_cb()
            return
        super().mouseReleaseEvent(event)

    def contextMenuEvent(self, event):
        """Empêche le menu contextuel par défaut."""
        pass

    def closeEvent(self, event):
        self.stop()
        super().closeEvent(event)


# =============================================================================
# ZONE DE PROGRAMMES D'UNE LIGNE DU GUIDE
# =============================================================================

class _GuideContent(QWidget):
    """Conteneur des lignes du guide (géométrie manuelle, virtualisées).

    Prévient la fenêtre quand sa largeur change (apparition de la barre
    de défilement verticale, redimensionnement) pour recaler les lignes
    déjà construites."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.on_resize = None

    def resizeEvent(self, event):
        super().resizeEvent(event)
        if self.on_resize:
            self.on_resize()


# =============================================================================
# FENÊTRE PRINCIPALE
# =============================================================================

class TVWindow(QMainWindow):
    """Interface TV Gablue avec navigation manette complète."""

    # Signal EPG émis depuis le thread de parsing, reçu dans le thread GUI.
    _epg_ready = Signal(list)

    def __init__(self):
        super().__init__()
        self.setWindowTitle("Gablue TV")
        self.setWindowIcon(QIcon.fromTheme("video-display"))
        self.resize(1120, 720)
        self.setMinimumSize(540, 400)

        # --- Paramètres persistants ---
        self._settings = self._load_settings()
        os.makedirs(LOGO_DIR, exist_ok=True)

        # --- Réseau (logos) ---
        self._net = QNetworkAccessManager(self)
        self._net.finished.connect(self._on_logo_downloaded)
        self._logo_targets = {}   # app_id -> [(widget, taille)] en attente du logo
        self._logo_pending = set()
        self._fallback_icon = QIcon.fromTheme("video-display")

        # --- Navigation ---
        self._cursor = 0
        self._cols = 5
        self._filtered = []
        self._buttons = []
        self._country_idx = 0
        self._country_pills = []
        self._countries_current = list(COUNTRIES_ORDER)  # pays des pastilles actives
        self._active_country = None   # pays du filtre effectivement appliqué
        self._guide_country_stash = None  # pays grille sans guide, restitué au retour
        self._return_view = 0  # vue d'origine (grille/guide) pour le retour vidéo

        # --- MPV embarqué (libmpv + OpenGL) ---
        # (MpvWidget créé dans _setup_ui)
        self._loading_dots = 0
        self._loading_timer = QTimer(self)
        self._loading_timer.setSingleShot(True)
        self._loading_timer.timeout.connect(self._hide_loading)

        # --- Masquage automatique du curseur pendant la lecture ---
        self._cursor_hidden = False
        self._cursor_timer = QTimer(self)
        self._cursor_timer.setSingleShot(True)
        self._cursor_timer.timeout.connect(self._hide_cursor)

        # --- Manettes : TOUTES les manettes connectées pilotent l'app ---
        # dict chemin -> evdev.InputDevice, re-scan incrémental toutes les
        # 2 s (branchement à chaud, renumérotation des nodes après une
        # reconnexion BT). État par device (hat, axes, fronts boutons) :
        # deux manettes ne se marchent pas dessus.
        self._gamepads = {}
        self._pad_states = {}
        self._last_scan = 0.0
        self._last_input = 0
        self._had_gamepad = False

        # --- Accélération navigation (maintien direction) ---
        self._hold_dir = None          # None, 'up', 'down', 'left', 'right'
        self._hold_start = 0.0         # timestamp ms début du maintien
        self._last_repeat = 0.0        # timestamp ms dernière répétition auto

        # --- Inhibition veille écran (portail freedesktop, D-Bus) ---
        self._inhibit_handle = None

        # --- Guide TV (EPG) ---
        self._epg = {}              # app_id -> [(start, stop, titre, catégorie)] triée
        self._epg_status = "⏳ Chargement du guide…"
        self._epg_failed = False
        self._epg_downloading = False
        self._card_epg_labels = {}  # app_id -> QLabel « en cours » de la carte
        self._card_epg_state = {}   # app_id -> (start, stop) du titre affiché
        self._guide_data = []       # métadonnées des lignes (chaîne + programmes)
        self._guide_row_widgets = {}  # idx -> widgets construits (lignes visibles)
        self._guide_row = 0
        self._guide_slot = 0
        self._guide_next_flip = 0.0 # timestamp du prochain changement de programme
        self._grid_dirty = False    # grille à reconstruire au prochain affichage
        self._guide_dirty = False   # guide à reconstruire au prochain affichage
        self._logo_pixmem = {}      # app_id -> QPixmap (cache mémoire des logos)
        self._net_epg = QNetworkAccessManager(self)

        # --- Construction de l'interface ---
        self._setup_ui()
        self._build_country_pills()
        self._filter_channels()
        self._find_gamepads()

        # --- Guide TV : chargement initial + horloge de rafraîchissement ---
        self._epg_ready.connect(self._on_epg_parsed)
        self._epg_init()
        self._epg_clock = QTimer(self)
        self._epg_clock.timeout.connect(self._epg_tick)
        self._epg_clock.start(30000)

        # --- Timers ---
        self._pad_timer = QTimer(self)
        self._pad_timer.timeout.connect(self._poll_gamepad)
        self._pad_timer.start(16)

        self._load_anim = QTimer(self)
        self._load_anim.timeout.connect(self._animate_loading)

    # =========================================================================
    # PERSISTANCE
    # =========================================================================

    def _load_settings(self):
        try:
            os.makedirs(CONFIG_DIR, exist_ok=True)
            with open(CONFIG_FILE) as f:
                return json.load(f)
        except (FileNotFoundError, json.JSONDecodeError):
            return {}

    def _save_settings(self):
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(CONFIG_FILE, "w") as f:
            json.dump(self._settings, f)

    # =========================================================================
    # CONSTRUCTION DE L'INTERFACE
    # =========================================================================

    def _setup_ui(self):
        """Construit toute l'arborescence de widgets."""
        central = QWidget()
        self.setCentralWidget(central)
        root = QVBoxLayout(central)
        root.setContentsMargins(0, 0, 0, 0)
        root.setSpacing(0)

        # --- Barre supérieure ---
        self._top_bar = QFrame()
        self._top_bar.setObjectName("topBar")
        self._top_bar.setFixedHeight(54)
        top_layout = QHBoxLayout(self._top_bar)
        top_layout.setContentsMargins(18, 0, 18, 0)
        top_layout.setSpacing(14)

        title = QLabel("GABLUE  TV")
        title.setObjectName("titleLabel")
        top_layout.addWidget(title)

        # --- Bascule Chaînes / Guide TV ---
        self._view_toggle = QPushButton("📅 Guide TV")
        self._view_toggle.setObjectName("viewToggle")
        self._view_toggle.setCursor(Qt.PointingHandCursor)
        self._view_toggle.setFocusPolicy(Qt.NoFocus)
        self._view_toggle.clicked.connect(self._toggle_guide)
        top_layout.addWidget(self._view_toggle)

        # Conteneur scrollable des pastilles
        self._pills_scroll = QScrollArea()
        self._pills_scroll.setFixedHeight(44)
        self._pills_scroll.setWidgetResizable(True)
        self._pills_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        self._pills_scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self._pills_scroll.setFrameShape(QFrame.NoFrame)
        self._pills_scroll.setStyleSheet("QScrollArea { background: transparent; border: none; }")

        pills_widget = QWidget()
        self._pills_layout = QHBoxLayout(pills_widget)
        self._pills_layout.setContentsMargins(0, 0, 0, 0)
        self._pills_layout.setSpacing(8)
        self._pills_layout.addStretch()
        self._pills_scroll.setWidget(pills_widget)
        top_layout.addWidget(self._pills_scroll, 1)

        self._count_label = QLabel()
        self._count_label.setObjectName("countLabel")
        top_layout.addWidget(self._count_label)

        root.addWidget(self._top_bar)

        # --- Stack : alterne entre grille et vidéo intégrée ---
        self._stack = QStackedWidget()
        self._stack.setStyleSheet("background-color: #080818;")

        # --- Zone de contenu (grille) ---
        self._scroll = QScrollArea()
        self._scroll.setWidgetResizable(True)
        self._scroll.setFrameShape(QFrame.NoFrame)
        self._scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)

        self._grid_container = QWidget()
        self._grid = QGridLayout(self._grid_container)
        self._grid.setSpacing(GRID_SPACING)
        self._grid.setContentsMargins(GRID_MARGIN, GRID_MARGIN, GRID_MARGIN, GRID_MARGIN)
        self._grid.setAlignment(Qt.AlignTop | Qt.AlignHCenter)
        self._scroll.setWidget(self._grid_container)

        self._stack.addWidget(self._scroll)  # index 0 : grille

        # --- Widget vidéo intégré (libmpv + OpenGL) ---
        self._video_widget = MpvWidget()
        self._video_widget._right_click_cb = self._stop_video
        # Suivi souris + filtre d'événements pour le masquage auto du curseur
        self._video_widget.setMouseTracking(True)
        self._video_widget.installEventFilter(self)
        self._stack.addWidget(self._video_widget)  # index 1 : vidéo

        # --- Vue Guide TV (EPG) ---
        guide_page = QWidget()
        gp_layout = QVBoxLayout(guide_page)
        gp_layout.setContentsMargins(16, 10, 16, 8)
        gp_layout.setSpacing(6)

        self._guide_status = QLabel(self._epg_status)
        self._guide_status.setObjectName("guideStatus")
        self._guide_status.setWordWrap(True)
        gp_layout.addWidget(self._guide_status)

        self._guide_scroll = QScrollArea()
        self._guide_scroll.setWidgetResizable(True)
        self._guide_scroll.setFrameShape(QFrame.NoFrame)
        self._guide_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)

        # Contenu à géométrie manuelle : seules les lignes visibles sont
        # construites (virtualisation — ~7000 widgets sinon, transitions
        # lentes). Défilement vertical natif, lignes hors écran détruites.
        self._guide_content = _GuideContent()
        self._guide_content.on_resize = self._guide_fix_widths
        self._guide_scroll.setWidget(self._guide_content)
        self._guide_scroll.verticalScrollBar().valueChanged.connect(
            self._on_guide_scrolled)
        gp_layout.addWidget(self._guide_scroll, 1)

        self._stack.addWidget(guide_page)  # index 2 : guide TV

        root.addWidget(self._stack, 1)

        # --- Barre OSD manette ---
        self._osd_bar = QFrame()
        self._osd_bar.setObjectName("osdBar")
        self._osd_bar.setFixedHeight(30)
        self._osd_bar.hide()
        osd_layout = QHBoxLayout(self._osd_bar)
        osd_layout.setContentsMargins(22, 0, 22, 0)
        self._osd_label = QLabel(
            "[A] Lancer/Pause    [B] Retour    [Select] Plein écran    [L1/R1] Pays    "
            "[D-Pad] Naviguer    [Haut/Bas] Vol.    [Gauche/Droite] Seek"
        )
        self._osd_label.setObjectName("osdLabel")
        osd_layout.addWidget(self._osd_label)
        root.addWidget(self._osd_bar)

        # --- Focus Wayland ---
        self._window_active = True  # suivi fiable via changeEvent

        # --- Overlay de chargement ---
        self._loading_overlay = QWidget(central)
        self._loading_overlay.setObjectName("loadingOverlay")
        self._loading_overlay.hide()
        load_layout = QVBoxLayout(self._loading_overlay)
        load_layout.setAlignment(Qt.AlignCenter)
        load_layout.setSpacing(8)

        self._loading_title = QLabel()
        self._loading_title.setObjectName("loadingTitle")
        self._loading_title.setAlignment(Qt.AlignCenter)
        load_layout.addWidget(self._loading_title)

        self._loading_subtitle = QLabel("Connexion au flux...")
        self._loading_subtitle.setObjectName("loadingSubtitle")
        self._loading_subtitle.setAlignment(Qt.AlignCenter)
        load_layout.addWidget(self._loading_subtitle)

        # L'overlay couvre la vidéo au démarrage : suivi souris + filtre
        # pour réafficher le curseur même pendant le chargement
        self._loading_overlay.setMouseTracking(True)
        self._loading_overlay.installEventFilter(self)

    def _build_country_pills(self, countries=None):
        """Crée les pastilles de filtrage par pays.

        La liste varie selon la vue : en guide, seuls les pays ayant au
        moins une chaîne guidée sont proposés (`_sync_pills_for_view`)."""
        if countries is None:
            countries = COUNTRIES_ORDER
        self._countries_current = list(countries)

        # Nettoie tout sauf le stretch final
        while self._pills_layout.count() > 1:
            item = self._pills_layout.takeAt(0)
            if item.widget():
                item.widget().deleteLater()

        self._country_pills = []

        # Pastille "Toutes"
        pill_all = QPushButton("Toutes")
        pill_all.setObjectName("countryPill")
        pill_all.setCursor(Qt.PointingHandCursor)
        pill_all.setFocusPolicy(Qt.NoFocus)
        pill_all.clicked.connect(lambda: self._select_country(0))
        self._pills_layout.insertWidget(0, pill_all)
        self._country_pills.append(pill_all)

        for i, country in enumerate(countries):
            pill = QPushButton(country)
            pill.setObjectName("countryPill")
            pill.setCursor(Qt.PointingHandCursor)
            pill.setFocusPolicy(Qt.NoFocus)
            idx = i + 1
            pill.clicked.connect(lambda checked, n=idx: self._select_country(n))
            self._pills_layout.insertWidget(self._pills_layout.count() - 1, pill)
            self._country_pills.append(pill)

    def _select_country(self, idx):
        """Change le filtre pays (index dans la liste des pastilles actives)."""
        self._country_idx = idx
        self._filter_channels()

    def _guide_countries(self):
        """Pays proposés en vue guide : ceux avec au moins une chaîne EPG."""
        if not self._epg:
            return []
        return [c for c in COUNTRIES_ORDER
                if any(ch[0] in self._epg for ch in CHANNELS if ch[2] == c)]

    def _sync_pills_for_view(self, force=False):
        """Adapte les pastilles pays à la vue courante.

        En guide, seuls les pays avec au moins une chaîne guidée sont
        montrés. Le pays sélectionné est conservé quand c'est possible ;
        une sélection de grille sans guide est mise de côté et restituée
        au retour en grille."""
        idx = self._stack.currentIndex()
        countries = self._guide_countries() if (idx == 2 and self._epg) else COUNTRIES_ORDER
        if countries == self._countries_current and not force:
            return

        current = (self._countries_current[self._country_idx - 1]
                   if 0 < self._country_idx <= len(self._countries_current) else None)
        self._build_country_pills(countries)

        if idx == 2:
            if current and current in countries:
                self._country_idx = countries.index(current) + 1
            else:
                self._guide_country_stash = current
                self._country_idx = 0
        else:
            if current and current in COUNTRIES_ORDER:
                self._country_idx = COUNTRIES_ORDER.index(current) + 1
            elif self._guide_country_stash in COUNTRIES_ORDER:
                self._country_idx = COUNTRIES_ORDER.index(self._guide_country_stash) + 1
            else:
                self._country_idx = 0
            self._guide_country_stash = None

        # Ne refiltre que si le filtre effectif change : d'un aller-retour
        # grille ↔ guide, la sélection (souvent « Toutes ») ne bouge pas et
        # la grille ne doit PAS être reconstruite (110 ms à chaque retour).
        new_country = (None if self._country_idx == 0
                       else self._countries_current[self._country_idx - 1])
        if new_country != self._active_country or force:
            self._filter_channels()
        else:
            self._refresh_pills()

    def _refresh_pills(self):
        """Met à jour le style actif/inactif des pastilles."""
        target_pill = (
            self._country_pills[self._country_idx]
            if self._country_idx < len(self._country_pills)
            else None
        )
        for i, pill in enumerate(self._country_pills):
            active = (i == self._country_idx)
            pill.setProperty("active", active)
            pill.style().unpolish(pill)
            pill.style().polish(pill)
        # Scroll horizontal pour rendre visible la pastille active
        # (l'utilisateur peut aussi scroller manuellement avec la souris)
        if target_pill:
            self._pills_scroll.ensureWidgetVisible(target_pill, 8, 4)

    # =========================================================================
    # GRILLE DE CHAÎNES
    # =========================================================================

    def _filter_channels(self):
        """Applique le filtre pays et reconstruit la grille."""
        if self._country_idx == 0:
            self._filtered = list(enumerate(CHANNELS))
            self._active_country = None
        else:
            country = self._countries_current[self._country_idx - 1]
            self._filtered = [
                (i, ch) for i, ch in enumerate(CHANNELS) if ch[2] == country
            ]
            self._active_country = country

        self._count_label.setText(f"{len(self._filtered)} chaînes")
        self._cursor = 0
        self._grid_dirty = True
        self._guide_dirty = True
        self._rebuild_visible_page()
        self._refresh_pills()

    def _rebuild_grid(self):
        """Reconstruit la grille de cartes."""
        # Nettoyage
        while self._grid.count():
            item = self._grid.takeAt(0)
            if item.widget():
                item.widget().setParent(None)

        self._buttons = []
        self._card_epg_labels = {}
        self._card_epg_state = {}

        # Calcul du nombre de colonnes
        vw = self._scroll.viewport().width()
        if vw < 100:
            vw = self.width() - 24
        self._cols = max(1, (vw - GRID_MARGIN * 2 + GRID_SPACING) // (CARD_W + GRID_SPACING))

        for idx, (_, (ch_id, label, country)) in enumerate(self._filtered):
            card = self._make_card(ch_id, label, country)
            row = idx // self._cols
            col = idx % self._cols
            self._grid.addWidget(card, row, col, Qt.AlignCenter)
            self._buttons.append(card)

        # Titres « en cours » (une seule passe, pas dans la boucle)
        self._update_card_epg()

        # Espaceur en bas
        if self._buttons:
            last_row = (len(self._buttons) - 1) // self._cols
            self._grid.setRowStretch(last_row + 1, 1)

        self._update_card_focus()
        self._grid_dirty = False

    def _make_card(self, ch_id, label, country):
        """Carte chaîne : logo, nom et programme « en cours » (si guide)."""
        card = QFrame()
        card.setObjectName("channelCard")
        card.setFixedSize(CARD_W, CARD_H)
        card.setCursor(Qt.PointingHandCursor)

        layout = QVBoxLayout(card)
        layout.setContentsMargins(4, 8, 4, 4)
        layout.setSpacing(2)
        layout.setAlignment(Qt.AlignCenter)

        icon_lbl = QLabel()
        icon_lbl.setFixedSize(84, 84)
        icon_lbl.setAlignment(Qt.AlignCenter)
        icon_lbl.setPixmap(self._fallback_icon.pixmap(LOGO_ICON_SIZE))
        layout.addWidget(icon_lbl, 0, Qt.AlignCenter)
        self._load_logo(ch_id, icon_lbl, LOGO_ICON_SIZE)

        text_lbl = QLabel(label)
        text_lbl.setAlignment(Qt.AlignCenter)
        text_lbl.setWordWrap(True)
        text_lbl.setStyleSheet("color: #c8c8e0; font-size: 12px; font-weight: 600; background: transparent;")
        layout.addWidget(text_lbl, 0, Qt.AlignCenter)

        # Programme en cours (rempli quand le guide est disponible)
        epg_lbl = QLabel()
        epg_lbl.setObjectName("epgNow")
        epg_lbl.setAlignment(Qt.AlignCenter)
        epg_lbl.setFixedHeight(16)
        epg_lbl.hide()
        layout.addWidget(epg_lbl, 0, Qt.AlignCenter)
        self._card_epg_labels[ch_id] = epg_lbl

        card.setToolTip(f"{label}\n{country}")

        def on_click(event=None):
            url = f"{BASE}/{ch_id}{SUFFIX}/{ch_id}.m3u8"
            self._play(url, label)

        card.mousePressEvent = lambda e: on_click() if e.button() == Qt.LeftButton else None
        return card

    def _update_card_focus(self):
        """Met à jour visuellement la carte active."""
        for i, btn in enumerate(self._buttons):
            active = (i == self._cursor)
            btn.setProperty("active", active)
            btn.style().unpolish(btn)
            btn.style().polish(btn)

    def _ensure_visible(self):
        """Scrolle pour rendre visible la carte active."""
        if not self._buttons or self._cursor >= len(self._buttons):
            return
        btn = self._buttons[self._cursor]
        self._scroll.ensureWidgetVisible(btn, 80, 80)

    def _scroll_to_top(self):
        """Remonte tout en haut de la grille."""
        sb = self._scroll.verticalScrollBar()
        if sb:
            sb.setValue(0)

    # =========================================================================
    # VUES : GRILLE / VIDÉO / GUIDE
    # =========================================================================

    def _show_view(self, idx):
        """Bascule de vue centralisée (0 grille, 1 vidéo, 2 guide)."""
        prev = self._stack.currentIndex()
        self._stack.setCurrentIndex(idx)
        self._top_bar.setVisible(idx != 1)
        self._view_toggle.setText("📺 Chaînes" if idx == 2 else "📅 Guide TV")
        if (idx == 2) != (prev == 2):
            self._sync_pills_for_view()
        self._rebuild_visible_page()
        if idx == 0:
            self._update_card_epg()
        elif idx == 2:
            self._guide_ensure_rows()  # largeurs/viewport à jour (resize caché)
        self._update_osd()

    def _rebuild_visible_page(self):
        """Ne reconstruit QUE la page visible si ses données ont changé.

        Les pages cachées sont marquées « sales » et reconstruites au
        moment de leur affichage — plus jamais de grille + guide reconstruits
        ensemble à chaque transition."""
        idx = self._stack.currentIndex()
        if idx == 0 and self._grid_dirty:
            self._rebuild_grid()
        elif idx == 2 and self._guide_dirty:
            self._rebuild_guide()

    def _toggle_guide(self):
        """Bascule grille ↔ guide TV (ignoré pendant la lecture).

        Aucune reconstruction ici : les données sont marquées sales par
        `_filter_channels`/`_apply_epg` et la page visible se reconstruit
        seule dans `_show_view`. Position de défilement conservée."""
        idx = self._stack.currentIndex()
        if idx == 1:
            return
        self._show_view(0 if idx == 2 else 2)
        # guide indisponible (échec réseau) → nouvelle tentative à l'ouverture
        if idx != 2 and self._epg_failed and not self._epg \
                and not self._epg_downloading:
            self._epg_download()

    def _guide_play_current(self):
        """Lance la chaîne de la ligne courante du guide.

        Le bloc sélectionné (en cours ou à venir) ne change rien : une
        chaîne live diffuse toujours son programme présent."""
        if not self._guide_data or self._guide_row >= len(self._guide_data):
            return
        row = self._guide_data[self._guide_row]
        url = f"{BASE}/{row['ch_id']}{SUFFIX}/{row['ch_id']}.m3u8"
        self._play(url, row["label"])

    # =========================================================================
    # GUIDE TV (construction + navigation)
    # =========================================================================

    def _rebuild_guide(self):
        """Recalcule les métadonnées du guide (lignes/programmes) puis ne
        construit que les lignes visibles (virtualisation).

        La ligne sélectionnée est restaurée par ch_id et le bloc sélectionné
        par position — le focus reste sur le programme choisi même s'il
        n'est pas celui en cours."""
        prev_ch = prev_slot = None
        if 0 <= self._guide_row < len(self._guide_data):
            prev_ch = self._guide_data[self._guide_row]["ch_id"]
            prev_slot = self._guide_slot

        self._dispose_all_guide_rows()
        self._guide_data = []
        self._guide_next_flip = 0.0

        now = time.time()
        for (i, (ch_id, label, _c)) in self._filtered:
            entries = self._epg.get(ch_id)
            if not entries:
                continue
            # premier programme non terminé
            start_idx = 0
            for j, (s, e, _t, _c2) in enumerate(entries):
                if e > now:
                    start_idx = j
                    break
            shown = entries[start_idx:start_idx + GUIDE_MAX_PROGS]
            if not shown:
                continue
            # prochain changement de programme (reconstruction du guide)
            flip = shown[0][0] if shown[0][0] > now else shown[0][1]
            self._guide_next_flip = (
                min(self._guide_next_flip, flip) if self._guide_next_flip else flip
            )
            self._guide_data.append({
                "ch_id": ch_id, "label": label, "progs": shown,
            })

        n = len(self._guide_data)
        self._guide_content.setMinimumHeight(max(1, n) * GUIDE_ROW_PITCH + 8)

        # restaure la sélection (ligne par ch_id, bloc par position)
        target = 0
        if prev_ch:
            for i, d in enumerate(self._guide_data):
                if d["ch_id"] == prev_ch:
                    target = i
                    break
        self._guide_row = target
        if n:
            slot = prev_slot if prev_slot is not None else 0
            self._guide_slot = max(
                0, min(slot, len(self._guide_data[target]["progs"]) - 1))

        self._guide_dirty = False
        self._guide_ensure_rows()
        if n:
            self._guide_reveal_row(self._guide_row)
        self._refresh_guide_status()

    def _on_guide_scrolled(self, _value):
        """Défilement vertical du guide → construit les lignes entrantes."""
        self._guide_ensure_rows()

    def _guide_ensure_rows(self):
        """Construit les lignes visibles (+ marge), détruit les lointaines.

        Le guide complet ferait ~90 widgets par chaîne × 79 : seules les
        lignes dans la fenêtre de visualisation existent réellement."""
        if self._guide_dirty or not self._guide_data:
            return
        n = len(self._guide_data)
        sb = self._guide_scroll.verticalScrollBar()
        view_h = self._guide_scroll.viewport().height()
        i0 = max(0, int(sb.value() // GUIDE_ROW_PITCH) - GUIDE_BUFFER_ROWS)
        i1 = min(n - 1, int((sb.value() + view_h) // GUIDE_ROW_PITCH)
                 + GUIDE_BUFFER_ROWS)
        for idx in [i for i in self._guide_row_widgets if i < i0 or i > i1]:
            self._dispose_guide_row(idx)
        for idx in range(i0, i1 + 1):
            if idx not in self._guide_row_widgets:
                self._build_guide_row(idx)
        self._guide_fix_widths()
        self._guide_apply_row_highlight()
        self._guide_apply_slot()

    def _guide_fix_widths(self):
        """Recale la largeur des lignes construites sur le contenu."""
        cw = self._guide_content.width()
        for w in self._guide_row_widgets.values():
            if w["frame"].width() != cw:
                self._guide_resize_row(w, cw)

    def _dispose_guide_row(self, idx):
        """Détruit les widgets d'une ligne hors écran (les données restent)."""
        w = self._guide_row_widgets.pop(idx, None)
        if w:
            w["frame"].hide()
            w["frame"].deleteLater()

    def _dispose_all_guide_rows(self):
        for idx in list(self._guide_row_widgets):
            self._dispose_guide_row(idx)

    def _build_guide_row(self, idx):
        """Construit les widgets d'une ligne du guide à géométrie manuelle."""
        d = self._guide_data[idx]
        now = time.time()
        cw = max(200, self._guide_content.width())

        frame = QFrame(self._guide_content)
        frame.setObjectName("guideRow")
        frame.setFixedHeight(GUIDE_ROW_H)
        frame.move(0, idx * GUIDE_ROW_PITCH)
        frame.resize(cw, GUIDE_ROW_H)
        # enfant créé après l'affichage du contenu → show() explicite requis
        # (sans lui, la ligne existe mais reste cachée)
        frame.show()

        # --- Cellule chaîne (cliquable) ---
        cell = QWidget(frame)
        cell.setGeometry(8, 6, GUIDE_CHAN_W, GUIDE_ROW_H - 12)
        logo_lbl = QLabel(cell)
        logo_lbl.setFixedSize(56, 38)
        logo_lbl.setAlignment(Qt.AlignCenter)
        logo_lbl.move((GUIDE_CHAN_W - 56) // 2, 2)
        logo_lbl.setPixmap(self._fallback_icon.pixmap(QSize(56, 38)))
        self._load_logo(d["ch_id"], logo_lbl, QSize(56, 38))
        logo_lbl.show()
        name_lbl = QLabel(QFontMetrics(self.font()).elidedText(
            d["label"], Qt.ElideRight, GUIDE_CHAN_W - 8))
        name_lbl.setObjectName("guideChanName")
        name_lbl.setAlignment(Qt.AlignCenter)
        name_lbl.setToolTip(d["label"])
        name_lbl.setGeometry(2, 42, GUIDE_CHAN_W - 4, 24)
        name_lbl.show()

        def on_cell(event=None, cid=d["ch_id"], lab=d["label"]):
            if event is None or event.button() == Qt.LeftButton:
                self._play(f"{BASE}/{cid}{SUFFIX}/{cid}.m3u8", lab)

        cell.mousePressEvent = on_cell
        cell.show()

        # --- Programmes : widget de clipping + blocs positionnés à la main
        # (remplace la QScrollArea par ligne : 3× moins de widgets) ---
        clip = QWidget(frame)
        clip.setGeometry(GUIDE_CHAN_W + 18, 6,
                         max(50, cw - GUIDE_CHAN_W - 26), GUIDE_ROW_H - 12)
        clip.show()

        blocks, xs, widths, bars = [], [], [], []
        x = 2
        for (s, e, title, cat) in d["progs"]:
            block, bar = self._make_prog_block(
                s, e, title, cat, now, d["ch_id"], d["label"])
            block.setParent(clip)
            block.move(x, 0)
            block.show()
            blocks.append(block)
            xs.append(x)
            widths.append(block.width())
            if bar:
                bars.append((bar, s, e))
            x += block.width() + 6

        w = {
            "frame": frame, "cell": cell, "clip": clip, "blocks": blocks,
            "xs": xs, "widths": widths, "total_w": x - 6, "hoffset": 0,
            "bars": bars,
        }

        # Molette : verticale = défile le guide en suivant la sélection (le
        # focus passe à la première ligne visible, sur son programme en
        # cours) ; horizontale (ou Maj+molette) = décale les blocs
        def on_wheel(event, row=w):
            delta = event.angleDelta()
            if event.modifiers() & Qt.ShiftModifier:
                h = delta.y() or delta.x()
            elif delta.y() == 0 and delta.x() != 0:
                h = delta.x()
            else:
                sb = self._guide_scroll.verticalScrollBar()
                sb.setValue(max(0, min(sb.maximum(), sb.value() - delta.y())))
                self._guide_follow_viewport()
                event.accept()
                return
            vis = row["clip"].width()
            max_off = max(0, row["total_w"] - vis)
            self._guide_set_offset(row, max(0, min(max_off, row["hoffset"] - h)))
            event.accept()

        frame.wheelEvent = on_wheel
        self._guide_row_widgets[idx] = w

    def _guide_set_offset(self, row, offset):
        """Décale horizontalement les blocs d'une ligne (défilement manuel)."""
        row["hoffset"] = offset
        for i, b in enumerate(row["blocks"]):
            b.move(row["xs"][i] - offset, 0)

    def _guide_resize_row(self, w, cw):
        """Met à jour la largeur d'une ligne construite (fenêtre redim.)."""
        w["frame"].resize(cw, GUIDE_ROW_H)
        clip_w = max(50, cw - GUIDE_CHAN_W - 26)
        w["clip"].resize(clip_w, GUIDE_ROW_H - 12)
        self._guide_set_offset(
            w, min(w["hoffset"], max(0, w["total_w"] - clip_w)))

    def _guide_reveal_row(self, idx):
        """Scrolle juste assez pour rendre la ligne sélectionnée visible."""
        sb = self._guide_scroll.verticalScrollBar()
        y = idx * GUIDE_ROW_PITCH
        page = self._guide_scroll.viewport().height()
        if y < sb.value():
            sb.setValue(y)
        elif y + GUIDE_ROW_H > sb.value() + page:
            sb.setValue(y + GUIDE_ROW_H - page)

    def _guide_follow_viewport(self):
        """Molette verticale : la sélection suit la première ligne visible
        et revient à son programme en cours (comme un D-pad haut/bas)."""
        if self._guide_dirty or not self._guide_data:
            return
        sb = self._guide_scroll.verticalScrollBar()
        idx = min(len(self._guide_data) - 1,
                  max(0, int((sb.value() + 4) // GUIDE_ROW_PITCH)))
        if idx != self._guide_row:
            self._guide_clear_sel(self._guide_row)
            self._guide_row = idx
            self._guide_slot = 0
            self._guide_ensure_rows()
            self._guide_apply_row_highlight()
            self._guide_apply_slot()

    def _make_prog_block(self, s, e, title, cat, now, ch_id, label):
        """Bloc programme : horaires, titre, catégorie, progression (en cours).

        Retourne (bloc, barre_de_progression|None). Le clic lance la chaîne
        quel que soit le programme (en cours ou à venir)."""
        current = s <= now < e
        block = QFrame()
        block.setObjectName("progBlock")
        if current:
            block.setProperty("now", True)
        minutes = max(1, (e - s) // 60)
        block.setFixedSize(max(116, min(300, minutes * 4)), GUIDE_BLOCK_H)

        v = QVBoxLayout(block)
        v.setContentsMargins(8, 6, 8, 6)
        v.setSpacing(2)

        t_lbl = QLabel(
            f"{time.strftime('%H:%M', time.localtime(s))} – "
            f"{time.strftime('%H:%M', time.localtime(e))}"
        )
        t_lbl.setObjectName("progTime")
        v.addWidget(t_lbl)

        title_lbl = QLabel(title)
        title_lbl.setObjectName("progTitle")
        title_lbl.setWordWrap(True)
        title_lbl.setToolTip(title)
        v.addWidget(title_lbl, 1)

        if cat:
            cat_lbl = QLabel(cat)
            cat_lbl.setObjectName("progCat")
            v.addWidget(cat_lbl)

        bar = None
        if current:
            bar = QProgressBar()
            bar.setObjectName("progBar")
            bar.setTextVisible(False)
            bar.setRange(0, 1000)
            bar.setValue(int(1000 * max(0.0, min(1.0, (now - s) / (e - s)))))
            v.addWidget(bar)

        def on_click(event=None, cid=ch_id, lab=label):
            if event is None or event.button() == Qt.LeftButton:
                self._play(f"{BASE}/{cid}{SUFFIX}/{cid}.m3u8", lab)

        block.mousePressEvent = on_click
        return block, bar

    def _guide_apply_row_highlight(self):
        """Met à jour la surbrillance des lignes construites.

        Ne re-polit que les lignes dont l'état change (le polish QSS est
        coûteux : 11 lignes × 2 à chaque défilement sinon)."""
        for idx, w in self._guide_row_widgets.items():
            active = (idx == self._guide_row)
            if w["frame"].property("active") != active:
                w["frame"].setProperty("active", active)
                w["frame"].style().unpolish(w["frame"])
                w["frame"].style().polish(w["frame"])

    def _guide_apply_slot(self):
        """Met à jour le bloc sélectionné + décale la ligne pour le garder
        visible (défilement horizontal manuel). Ne re-polit que les blocs
        dont la sélection change."""
        w = self._guide_row_widgets.get(self._guide_row)
        if w is None:
            return
        for j, b in enumerate(w["blocks"]):
            sel = (j == self._guide_slot)
            if b.property("sel") != sel:
                b.setProperty("sel", sel)
                b.style().unpolish(b)
                b.style().polish(b)
        if 0 <= self._guide_slot < len(w["blocks"]):
            x0 = w["xs"][self._guide_slot]
            x1 = x0 + w["widths"][self._guide_slot]
            vis = w["clip"].width()
            off = w["hoffset"]
            if x0 < off:              # bloc à gauche du viewport → revenir
                off = max(0, x0 - 8)
            elif x1 > off + vis:      # bloc à droite → avancer
                off = x1 - vis
            off = max(0, min(off, max(0, w["total_w"] - vis)))
            if off != w["hoffset"]:
                self._guide_set_offset(w, off)

    def _guide_set_row(self, idx):
        """Change de ligne de guide (construit au besoin + défilement).

        Le focus revient au programme en cours de la nouvelle ligne :
        monter/descendre ne doit pas conserver le décalage horizontal
        (gauche/droite, lui, le conserve tant qu'on reste sur la ligne).
        La ligne quittée perd son cadre jaune et revient à son début."""
        if not self._guide_data:
            return
        idx = max(0, min(idx, len(self._guide_data) - 1))
        if idx != self._guide_row:
            self._guide_clear_sel(self._guide_row)
        self._guide_row = idx
        self._guide_slot = 0
        self._guide_ensure_rows()
        self._guide_apply_row_highlight()
        self._guide_apply_slot()
        self._guide_reveal_row(idx)

    def _guide_clear_sel(self, idx):
        """Ligne quittée : retire le cadre jaune du bloc sélectionné et
        redécale les blocs au début (programme en cours visible)."""
        w = self._guide_row_widgets.get(idx)
        if w is None:
            return
        for b in w["blocks"]:
            if b.property("sel"):
                b.setProperty("sel", False)
                b.style().unpolish(b)
                b.style().polish(b)
        if w["hoffset"]:
            self._guide_set_offset(w, 0)

    def _guide_step(self, direction):
        """Un pas de navigation D-pad dans le guide."""
        if not self._guide_data:
            return
        if direction == "up":
            if self._guide_row > 0:
                self._guide_set_row(self._guide_row - 1)
        elif direction == "down":
            if self._guide_row + 1 < len(self._guide_data):
                self._guide_set_row(self._guide_row + 1)
        elif direction == "left":
            if self._guide_slot > 0:
                self._guide_slot -= 1
                self._guide_apply_slot()
        elif direction == "right":
            progs = self._guide_data[self._guide_row]["progs"]
            if self._guide_slot + 1 < len(progs):
                self._guide_slot += 1
                self._guide_apply_slot()

    def _refresh_guide_status(self):
        """Met à jour la ligne de statut du guide (téléchargement/erreur/compte)."""
        if not hasattr(self, "_guide_status"):
            return
        total = len(self._filtered)
        with_epg = sum(1 for (_i, (cid, _l, _c)) in self._filtered if cid in self._epg)
        suffix = f"   ·   {with_epg}/{total} chaînes filtrées avec guide"
        self._guide_status.setText(self._epg_status + suffix)
        self._guide_status.setProperty("failed", self._epg_failed)
        self._guide_status.style().unpolish(self._guide_status)
        self._guide_status.style().polish(self._guide_status)

    # =========================================================================
    # EPG : CHARGEMENT, CACHE, CYCLE DE VIE
    # =========================================================================

    def _epg_init(self):
        """Charge le guide au démarrage : cache TSV frais → direct ; sinon
        ancien cache affiché puis mise à jour téléchargée en arrière-plan."""
        progs = []
        if os.path.exists(EPG_CACHE_TSV):
            try:
                progs = _read_epg_tsv(EPG_CACHE_TSV)
            except OSError:
                progs = []
        fresh = (
            os.path.exists(EPG_CACHE_TSV)
            and (time.time() - os.path.getmtime(EPG_CACHE_TSV)) < EPG_TTL_S
        )
        if progs:
            self._apply_epg(progs)
        if fresh:
            return
        self._epg_download()

    def _epg_download(self):
        """Télécharge le fichier XMLTV (asynchrone, GUI thread)."""
        if self._epg_downloading:
            return
        self._epg_downloading = True
        self._epg_failed = False
        self._epg_status = "⏳ Téléchargement du guide…"
        self._refresh_guide_status()
        request = QNetworkRequest(QUrl(EPG_URL))
        request.setTransferTimeout(60000)
        request.setAttribute(
            QNetworkRequest.Attribute.RedirectPolicyAttribute,
            QNetworkRequest.RedirectPolicy.NoLessSafeRedirectPolicy,
        )
        request.setHeader(
            QNetworkRequest.KnownHeaders.UserAgentHeader, "GablueTV/1.0"
        )
        reply = self._net_epg.get(request)
        reply.finished.connect(self._on_epg_downloaded)

    def _on_epg_downloaded(self):
        """Fin du téléchargement XMLTV : cache brut puis parse en thread."""
        self._epg_downloading = False
        reply = self.sender()
        if reply is None:
            return
        reply.deleteLater()
        if reply.error() != QNetworkReply.NetworkError.NoError:
            self._epg_fail(f"Réseau : {reply.errorString()}")
            return
        data = bytes(reply.readAll())
        if len(data) < 1000:
            self._epg_fail(f"Réponse trop courte ({len(data)} o)")
            return
        try:
            tmp = EPG_CACHE_GZ + ".part"
            with open(tmp, "wb") as f:
                f.write(data)
            os.replace(tmp, EPG_CACHE_GZ)
        except OSError:
            pass
        self._epg_status = "⏳ Analyse du guide…"
        self._refresh_guide_status()
        threading.Thread(
            target=self._epg_parse_worker, args=(data,), daemon=True
        ).start()

    def _epg_parse_worker(self, data):
        """Parsing XMLTV hors thread GUI (~2 s sur le fichier complet)."""
        try:
            progs = parse_xmltv(data, EPG_CHANNEL_MAP)
        except Exception as exc:
            print(f"[EPG] erreur de parsing : {exc}", file=sys.stderr)
            progs = []
        self._epg_ready.emit(progs)

    def _on_epg_parsed(self, progs):
        """Réception des programmes parsés (thread GUI) : cache + application."""
        if not progs:
            self._epg_fail("Guide vide ou illisible")
            return
        try:
            tmp = EPG_CACHE_TSV + ".part"
            _write_epg_tsv(tmp, progs)
            os.replace(tmp, EPG_CACHE_TSV)
        except OSError:
            pass
        self._apply_epg(progs)

    def _epg_fail(self, msg):
        """Échec EPG : garde les anciennes données si présentes."""
        if self._epg:
            self._epg_status = f"⚠ {msg} — guide depuis le cache"
        else:
            self._epg_failed = True
            self._epg_status = f"❌ {msg}"
        self._refresh_guide_status()

    def _apply_epg(self, progs):
        """Applique les programmes : index par chaîne, tri, rafraîchissements."""
        mapping = {}
        for (cid, start, stop, title, cat) in progs:
            mapping.setdefault(cid, []).append((start, stop, title, cat))
        for lst in mapping.values():
            lst.sort(key=lambda x: x[0])
        self._epg = mapping
        self._epg_failed = False
        self._epg_status = f"📡 {len(mapping)} chaînes avec guide"
        self._guide_dirty = True
        self._update_card_epg()
        self._refresh_guide_status()
        if self._stack.currentIndex() == 2:
            # pastilles pays + guide reconstruits avec les nouvelles données
            self._sync_pills_for_view(force=True)

    def _current_programme(self, ch_id, now=None):
        """Programme en cours d'une chaîne → (start, stop, titre, catégorie)."""
        entries = self._epg.get(ch_id)
        if not entries:
            return None
        if now is None:
            now = time.time()
        for (start, stop, title, cat) in entries:
            if start <= now < stop:
                return (start, stop, title, cat)
            if start > now:
                break
        return None

    def _update_card_epg(self, now=None):
        """Met à jour la ligne « en cours » des cartes.

        Ne touche qu'aux cartes dont le programme a changé (le remplissage
        complet des 174 cartes coûte ~100 ms, inacceptable à chaque retour
        grille / tick de 30 s)."""
        if now is None:
            now = time.time()
        for ch_id, lbl in self._card_epg_labels.items():
            if not shiboken6.isValid(lbl):
                continue
            prog = self._current_programme(ch_id, now)
            key = (prog[0], prog[1]) if prog else None
            if self._card_epg_state.get(ch_id) == key:
                continue
            self._card_epg_state[ch_id] = key
            if prog:
                fm = lbl.fontMetrics()
                lbl.setText(fm.elidedText(prog[2], Qt.ElideRight, CARD_W - 24))
                nxt = self._next_programme(ch_id, prog[1])
                tip = f"Maintenant : {prog[2]}"
                if nxt:
                    tip += f"\nEnsuite ({time.strftime('%H:%M', time.localtime(nxt[0]))}) : {nxt[2]}"
                lbl.setToolTip(tip)
                lbl.show()
            else:
                lbl.hide()

    def _next_programme(self, ch_id, after):
        """Premier programme commençant après le timestamp donné."""
        for (start, stop, title, cat) in self._epg.get(ch_id, []):
            if start >= after:
                return (start, stop, title, cat)
        return None

    def _epg_tick(self):
        """Horloge EPG (30 s) : cartes, barres de progression, bascule de
        programme dans le guide (reconstruction seulement si visible)."""
        now = time.time()
        if self._guide_next_flip and now >= self._guide_next_flip:
            self._guide_next_flip = 0.0
            self._guide_dirty = True
        idx = self._stack.currentIndex()
        if idx == 0:
            self._update_card_epg(now)
        elif idx == 2:
            if self._guide_dirty:
                self._rebuild_visible_page()
            else:
                # barres des lignes construites seulement
                for w in self._guide_row_widgets.values():
                    for bar, start, stop in w["bars"]:
                        if shiboken6.isValid(bar) and stop > start:
                            bar.setValue(int(1000 * max(0.0, min(1.0, (now - start) / (stop - start)))))

    # =========================================================================
    # ACCÉLÉRATION NAVIGATION
    # =========================================================================

    def _accel_delay(self, hold_ms):
        """Délai entre répétitions selon la durée de maintien (ms).

        La navigation accélère progressivement quand on maintient une direction :
        - 0-300ms   : 180ms (délai initial avant 1ère répétition)
        - 300-600ms : 120ms
        - 600ms-1s  : 70ms
        - 1-2s      : 40ms
        - >2s       : 25ms (très rapide)
        """
        if hold_ms < 300:
            return COOLDOWN_MS
        elif hold_ms < 600:
            return 120
        elif hold_ms < 1000:
            return 70
        elif hold_ms < 2000:
            return 40
        else:
            return 25

    def _try_move_cursor(self, direction):
        """Tente de déplacer le curseur dans la direction donnée.

        Retourne True si le curseur a été déplacé avec succès.
        """
        moved = False
        if direction == "up":
            new = self._cursor - self._cols
            if new >= 0:
                self._cursor = new
                moved = True
        elif direction == "down":
            new = self._cursor + self._cols
            if new < len(self._buttons):
                self._cursor = new
                moved = True
        elif direction == "left":
            if self._cursor % self._cols > 0:
                self._cursor -= 1
                moved = True
        elif direction == "right":
            if (self._cursor % self._cols < self._cols - 1
                    and self._cursor + 1 < len(self._buttons)):
                self._cursor += 1
                moved = True
        if moved:
            self._update_card_focus()
            self._ensure_visible()
        return moved

    def _nav_step(self, direction):
        """Un pas de navigation D-pad selon la vue courante (grille ou guide)."""
        if self._stack.currentIndex() == 2:
            self._guide_step(direction)
        else:
            self._try_move_cursor(direction)

    # =========================================================================
    # LOGOS
    # =========================================================================

    def _load_logo(self, ch_id, widget, size):
        """Charge un logo (mémoire → disque → réseau), multi-cibles.

        Un même logo peut alimenter plusieurs widgets (carte + ligne du
        guide) : cibles suivies par chaîne, téléchargement dédupliqué.
        Le pixmap décodé est gardé en mémoire : les reconstructions du
        guide ne relisent plus les fichiers PNG du disque."""
        pm = self._logo_pixmem.get(ch_id)
        if pm is not None:
            self._set_logo(widget, pm, size)
            return
        cache_path = os.path.join(LOGO_DIR, f"{ch_id}.png")
        if os.path.exists(cache_path):
            pm = QPixmap(cache_path)
            if not pm.isNull():
                self._logo_pixmem[ch_id] = pm
                self._set_logo(widget, pm, size)
                return
        self._logo_targets.setdefault(ch_id, []).append((widget, size))
        if ch_id in self._logo_pending:
            return
        self._logo_pending.add(ch_id)
        self._net.get(QNetworkRequest(QUrl(f"{LOGO_BASE}/{ch_id}.png")))

    @staticmethod
    def _set_logo(widget, pixmap, size):
        """Applique un pixmap redimensionné à un QLabel cible (si vivant)."""
        if isinstance(widget, QLabel) and shiboken6.isValid(widget):
            widget.setPixmap(
                pixmap.scaled(size, Qt.KeepAspectRatio, Qt.SmoothTransformation)
            )

    def _on_logo_downloaded(self, reply):
        """Callback de téléchargement d'un logo."""
        url_path = reply.url().path()
        ch_id = os.path.splitext(os.path.basename(url_path))[0]
        if reply.error() != QNetworkReply.NetworkError.NoError:
            return
        cache_path = os.path.join(LOGO_DIR, f"{ch_id}.png")
        data = reply.readAll().data()
        try:
            with open(cache_path, "wb") as f:
                f.write(data)
        except OSError:
            return
        self._logo_pending.discard(ch_id)
        targets = self._logo_targets.pop(ch_id, [])
        pixmap = QPixmap(cache_path)
        if not pixmap.isNull():
            self._logo_pixmem[ch_id] = pixmap
        for widget, size in targets:
            self._set_logo(widget, pixmap, size)

    # =========================================================================
    # LECTURE VIDÉO (libmpv embarqué)
    # =========================================================================

    def _play(self, url, label=""):
        """Lance la lecture (conserve la taille de fenêtre actuelle).

        La vue d'origine (grille ou guide) est mémorisée pour le retour."""
        self._return_view = self._stack.currentIndex()
        self._video_widget.command("stop")
        self._show_view(1)

        self._loading_title.setText(label)
        self._loading_subtitle.setText("Connexion au flux...")
        self._loading_dots = 0
        self._loading_overlay.setGeometry(self.centralWidget().rect())
        self._loading_overlay.raise_()
        self._loading_overlay.show()
        self._load_anim.start(450)

        self._video_widget.play(url)
        self._loading_timer.start(3000)
        self._cursor_timer.start(CURSOR_HIDE_MS)

        # Empêche l'extinction d'écran pendant la lecture (portail freedesktop)
        self._inhibit_screensaver()

    def _hide_loading(self):
        self._loading_overlay.hide()
        self._load_anim.stop()
        self._loading_timer.stop()

    def _pause_toggle(self):
        self._video_widget.command("cycle", "pause")
        if self._inhibit_handle:
            self._uninhibit_screensaver()
        else:
            self._inhibit_screensaver()

    def _stop_video(self):
        """Arrête la lecture et revient à la vue d'origine (grille ou guide)."""
        self._video_widget.command("stop")
        self._show_view(self._return_view if self._return_view in (0, 2) else 0)
        self._return_view = 0
        self._hide_loading()
        self._uninhibit_screensaver()
        self._restore_cursor()
        # retour au guide : rafraîchit barres de progression / bascule de
        # programme (rebuild seulement si un programme a basculé)
        if self._stack.currentIndex() == 2:
            self._epg_tick()

    def _inhibit_screensaver(self):
        """Empêche l'extinction d'écran via org.freedesktop.PowerManagement."""
        if self._inhibit_handle is not None:
            return
        msg = QDBusMessage.createMethodCall(
            "org.freedesktop.PowerManagement",
            "/org/freedesktop/PowerManagement/Inhibit",
            "org.freedesktop.PowerManagement.Inhibit",
            "Inhibit",
        )
        msg.setArguments(["Gablue TV", "Lecture en cours"])
        reply = QDBusConnection.sessionBus().call(msg)
        if reply.type() == QDBusMessage.ReplyMessage and reply.arguments():
            self._inhibit_handle = reply.arguments()[0]

    def _uninhibit_screensaver(self):
        """Lève l'inhibition d'écran."""
        if self._inhibit_handle is None:
            return
        msg = QDBusMessage.createMethodCall(
            "org.freedesktop.PowerManagement",
            "/org/freedesktop/PowerManagement/Inhibit",
            "org.freedesktop.PowerManagement.Inhibit",
            "UnInhibit",
        )
        msg.setArguments([self._inhibit_handle])
        QDBusConnection.sessionBus().call(msg)
        self._inhibit_handle = None

    def _toggle_fullscreen(self):
        """Bascule plein écran / fenêtré (à tout moment), forcé sur l'écran du curseur."""
        if self.isFullScreen():
            self.showNormal()
        else:
            screen = QApplication.screenAt(QCursor.pos())
            if screen:
                self.setGeometry(screen.geometry())
            self.showFullScreen()

    def _volume_up(self):
        self._video_widget.command("add", "volume", "5")

    def _volume_down(self):
        self._video_widget.command("add", "volume", "-5")

    def _seek(self, seconds):
        self._video_widget.command("seek", str(seconds))

    # =========================================================================
    # OVERLAY DE CHARGEMENT
    # =========================================================================

    def _animate_loading(self):
        """Animation de chargement + détection du démarrage vidéo."""
        self._loading_dots = (self._loading_dots + 1) % 4
        dots = "." * self._loading_dots
        self._loading_subtitle.setText(f"Connexion au flux{dots}   ")
        if self._video_widget.is_rendering():
            self._hide_loading()

    # =========================================================================
    # MANETTES DE JEU (toutes les manettes pilotent l'application)
    # =========================================================================

    @staticmethod
    def _normalize_axis(value, vmin, vmax):
        """Normalise un axe brut vers [-1.0, 1.0] selon la plage réelle du
        device (0.0 au repos). Les pads virtuels ds2xbox sont en
        -32768..32767 avec repos à 0 : sans normalisation par device, leur
        repos serait lu comme -1.008 (collé haut/gauche, volume qui monte
        en boucle)."""
        if vmax <= vmin:
            return 0.0
        norm = 2.0 * (value - vmin) / (vmax - vmin) - 1.0
        return max(-1.0, min(1.0, norm))

    def _find_gamepads(self):
        """Détecte les manettes connectées (toutes, pas une seule).

        Re-scan incrémental : ouvre uniquement les nouveaux devices, garde
        les déjà suivis (leurs états hat/boutons persistent)."""
        try:
            paths = evdev.list_devices()
        except (FileNotFoundError, PermissionError, OSError):
            paths = []
        for path in paths:
            if path in self._gamepads:
                continue
            try:
                device = evdev.InputDevice(path)
                caps = device.capabilities()
            except (OSError, IOError):
                continue
            if ecodes.EV_KEY not in caps:
                device.close()
                continue
            keys = caps[ecodes.EV_KEY]
            if ecodes.BTN_A not in keys and ecodes.BTN_SELECT not in keys:
                device.close()
                continue
            state = {
                "hat_x": 0, "hat_y": 0, "phat_x": 0, "phat_y": 0,
                "axis_x": 0.0, "axis_y": 0.0,
                "xr": (0, 255), "yr": (0, 255),
                "cross": False, "circle": False,
                "l1": False, "r1": False, "select": False, "start": False,
            }
            # Plages réelles des sticks pour la normalisation
            try:
                ax = device.absinfo(ecodes.ABS_X)
                ay = device.absinfo(ecodes.ABS_Y)
                state["xr"] = (ax.min, ax.max)
                state["yr"] = (ay.min, ay.max)
            except (OSError, IOError, KeyError, IndexError, AttributeError):
                pass
            self._gamepads[path] = device
            self._pad_states[path] = state
            print(f"[INFO] Manette ajoutée : {device.name} ({path})",
                  file=sys.stderr)
        self._update_osd()

    def _drop_gamepad(self, path):
        """Retire une manette déconnectée (fermeture propre)."""
        device = self._gamepads.pop(path, None)
        self._pad_states.pop(path, None)
        if device:
            try:
                device.close()
            except (OSError, IOError):
                pass
        self._update_osd()

    @staticmethod
    def _device_direction(state):
        """Direction d'un device : hat prioritaire sur stick, priorité
        up > down > left > right (sémantique historique mono-pad)."""
        if state["hat_y"] == -1 or state["axis_y"] < -0.5:
            return "up"
        if state["hat_y"] == 1 or state["axis_y"] > 0.5:
            return "down"
        if state["hat_x"] == -1 or state["axis_x"] < -0.5:
            return "left"
        if state["hat_x"] == 1 or state["axis_x"] > 0.5:
            return "right"
        return None

    def _merged_direction(self):
        """Direction courante toutes manettes confondues.

        Même ordre d'évaluation qu'en mono-pad (up > down > left > right),
        étendu à tous les devices."""
        for direction in ("up", "down", "left", "right"):
            for state in self._pad_states.values():
                if self._device_direction(state) == direction:
                    return direction
        return None

    def _update_osd(self):
        """Met à jour texte et visibilité de la barre d'aide manette."""
        connected = bool(self._gamepads)
        self._had_gamepad = connected
        idx = self._stack.currentIndex()
        texts = {
            0: "[A] Lancer    [B] Quitter    [Start] Guide TV    [Select] Plein écran    "
               "[L1/R1] Pays    [D-Pad] Naviguer",
            2: "[A] Regarder    [B] Retour    [Start] Chaînes    [Select] Plein écran    "
               "[L1/R1] Pays    [D-Pad] Naviguer le guide",
        }
        self._osd_label.setText(texts.get(idx, ""))
        self._osd_bar.setVisible(connected and idx != 1)

    def _poll_gamepad(self):
        """Boucle principale de lecture manettes (appelée toutes les ~16ms).

        TOUTES les manettes connectées pilotent l'application : état tenu
        par device, détection de fronts par device. L'accélération
        fonctionne même sans nouveaux événements : l'état du stick/hat
        est mémorisé entre les appels. Re-scan incrémental toutes les
        2 s pour suivre les branchements à chaud.

        Les manettes sont ignorées quand tvqt n'est pas la fenêtre active
        (focus Wayland géré par changeEvent / ActivationChange).
        """
        if not self._window_active:
            return

        now = time.time() * 1000

        # Re-scan incrémental toutes les 2 s (hotplug, reconnexion BT)
        if now - self._last_scan >= 2000:
            self._last_scan = now
            self._find_gamepads()

        if not self._gamepads:
            return

        watching = self._stack.currentIndex() == 1

        # Lecture des événements de toutes les manettes
        try:
            ready, _, _ = select.select(list(self._gamepads.values()), [], [], 0)
        except (OSError, IOError, ValueError):
            # fd invalide (device disparu) : repartir d'un état propre
            for path in list(self._gamepads):
                self._drop_gamepad(path)
            return

        actions = []  # boutons pressés (fronts détectés) ce poll
        for device in ready:
            state = self._pad_states.get(device.path)
            if state is None:
                continue
            try:
                events = device.read()
            except (OSError, IOError, BlockingIOError):
                self._drop_gamepad(device.path)
                continue

            for ev in events:
                if ev.type == ecodes.EV_ABS:
                    if ev.code == ecodes.ABS_HAT0X:
                        state["hat_x"] = ev.value
                    elif ev.code == ecodes.ABS_HAT0Y:
                        state["hat_y"] = ev.value
                    elif ev.code == ecodes.ABS_X:
                        state["axis_x"] = self._normalize_axis(ev.value, *state["xr"])
                    elif ev.code == ecodes.ABS_Y:
                        state["axis_y"] = self._normalize_axis(ev.value, *state["yr"])
                elif ev.type == ecodes.EV_KEY:
                    pressed = ev.value == 1
                    if ev.code == BTN_CROSS:
                        if pressed and not state["cross"]:
                            actions.append("cross")
                        state["cross"] = pressed
                    elif ev.code == BTN_CIRCLE:
                        if pressed and not state["circle"]:
                            actions.append("circle")
                        state["circle"] = pressed
                    elif ev.code == BTN_L1:
                        if pressed and not state["l1"]:
                            actions.append("l1")
                        state["l1"] = pressed
                    elif ev.code == BTN_R1:
                        if pressed and not state["r1"]:
                            actions.append("r1")
                        state["r1"] = pressed
                    elif ev.code == BTN_SELECT:
                        if pressed and not state["select"]:
                            actions.append("select")
                        state["select"] = pressed
                    elif ev.code == BTN_START:
                        if pressed and not state["start"]:
                            actions.append("start")
                        state["start"] = pressed

        # --- Direction actuelle (toutes manettes) ---
        new_dir = self._merged_direction()

        # --- Mode grille/guide : accélération progressive au maintien ---
        if not watching:
            if new_dir is None:
                self._hold_dir = None
            elif new_dir == self._hold_dir:
                hold_ms = now - self._hold_start
                if now - self._last_repeat >= self._accel_delay(hold_ms):
                    self._last_repeat = now
                    self._nav_step(new_dir)
            else:
                self._hold_dir = new_dir
                self._hold_start = now
                self._last_repeat = now
                self._nav_step(new_dir)

        # --- Boutons (fronts par device, tir unique, pas d'accélération) ---
        if now - self._last_input >= COOLDOWN_MS:
            if "select" in actions:
                self._last_input = now
                self._toggle_fullscreen()

            elif "cross" in actions:
                self._last_input = now
                if watching:
                    self._pause_toggle()
                elif self._stack.currentIndex() == 2:
                    self._guide_play_current()
                elif self._buttons and self._cursor < len(self._filtered):
                    _, (ch_id, label, _) = self._filtered[self._cursor]
                    self._play(f"{BASE}/{ch_id}{SUFFIX}/{ch_id}.m3u8", label)
                self._hold_dir = None

            elif "circle" in actions:
                self._last_input = now
                if watching:
                    self._stop_video()
                elif self._stack.currentIndex() == 2:
                    self._show_view(0)
                else:
                    self.close()
                return

            elif "start" in actions:
                self._last_input = now
                self._toggle_guide()
                self._hold_dir = None

            elif "l1" in actions:
                self._last_input = now
                if not watching:
                    self._country_idx = (self._country_idx - 1) % (len(self._countries_current) + 1)
                    self._select_country(self._country_idx)
                    self._scroll_to_top()
                self._hold_dir = None

            elif "r1" in actions:
                self._last_input = now
                if not watching:
                    self._country_idx = (self._country_idx + 1) % (len(self._countries_current) + 1)
                    self._select_country(self._country_idx)
                    self._scroll_to_top()
                self._hold_dir = None

            # --- Mode lecture : hat = front par device (un cran = une
            #     action), stick = répétition au rythme du cooldown.
            #     Seul le device qui PRODUIT la direction est évalué :
            #     le garde phat d'une manette au repos (0) ne doit pas
            #     faire répéter la direction tenue par une autre. ---
            elif watching and new_dir is not None:
                for state in self._pad_states.values():
                    if self._device_direction(state) != new_dir:
                        continue
                    if new_dir == "up" and state["phat_y"] != -1:
                        self._last_input = now
                        self._volume_up()
                    elif new_dir == "down" and state["phat_y"] != 1:
                        self._last_input = now
                        self._volume_down()
                    elif new_dir == "left" and state["phat_x"] != -1:
                        self._last_input = now
                        self._seek(-10)
                    elif new_dir == "right" and state["phat_x"] != 1:
                        self._last_input = now
                        self._seek(10)
                    break

        # Fronts hat mémorisés par device pour le mode lecture
        for state in self._pad_states.values():
            state["phat_x"] = state["hat_x"]
            state["phat_y"] = state["hat_y"]

    # =========================================================================
    # FOCUS WAYLAND
    # =========================================================================

    def changeEvent(self, event):
        """Suit l'état d'activation de la fenêtre (fiable sous Wayland)."""
        if event.type() == QEvent.ActivationChange:
            self._window_active = self.isActiveWindow()
        super().changeEvent(event)

    # =========================================================================
    # CURSEUR (masquage automatique en lecture)
    # =========================================================================

    def eventFilter(self, obj, event):
        """Détecte l'activité souris sur la zone vidéo (curseur auto-masqué).

        Filtre installé sur le widget vidéo et l'overlay de chargement :
        tout mouvement/clic pendant la lecture réaffiche le curseur et
        reprogramme son masquage.
        """
        if event.type() in (
            QEvent.MouseMove,
            QEvent.MouseButtonPress,
            QEvent.MouseButtonRelease,
            QEvent.MouseButtonDblClick,
            QEvent.Wheel,
        ):
            self._on_user_activity()
        return super().eventFilter(obj, event)

    def _on_user_activity(self):
        """Réaffiche le curseur et reprogramme son masquage (mode lecture)."""
        if self._stack.currentIndex() != 1:
            return
        if self._cursor_hidden:
            self._restore_cursor()
        self._cursor_timer.start(CURSOR_HIDE_MS)

    def _restore_cursor(self):
        """Réaffiche le curseur et arrête le timer de masquage."""
        self._cursor_timer.stop()
        if self._cursor_hidden:
            self._cursor_hidden = False
            self._video_widget.unsetCursor()

    def _hide_cursor(self):
        """Masque le curseur après inactivité pendant la lecture."""
        if self._stack.currentIndex() == 1 and not self._cursor_hidden:
            self._cursor_hidden = True
            self._video_widget.setCursor(Qt.BlankCursor)

    # =========================================================================
    # CLAVIER
    # =========================================================================

    def keyPressEvent(self, event):
        """Raccourcis clavier (grille / guide / lecture)."""
        self._on_user_activity()  # une touche pressée réaffiche le curseur
        key = event.key()
        mode = self._stack.currentIndex()  # 0 grille, 1 vidéo, 2 guide
        watching = mode == 1
        in_guide = mode == 2

        if key == Qt.Key_Escape:
            if watching:
                self._stop_video()
            elif in_guide:
                self._show_view(0)
            else:
                self.close()

        elif key == Qt.Key_F11:
            self._toggle_fullscreen()

        elif key == Qt.Key_G:
            self._toggle_guide()

        elif key == Qt.Key_Return or key == Qt.Key_Enter:
            if watching:
                self._pause_toggle()
            elif in_guide:
                self._guide_play_current()
            elif self._buttons and self._cursor < len(self._filtered):
                # Les cartes sont des QFrame (pas de .click()) : lancer
                # directement la chaîne sous le curseur
                _, (ch_id, label, _) = self._filtered[self._cursor]
                self._play(f"{BASE}/{ch_id}{SUFFIX}/{ch_id}.m3u8", label)

        elif key == Qt.Key_Space:
            if watching:
                self._pause_toggle()
            elif in_guide:
                self._guide_play_current()
            elif self._buttons and self._cursor < len(self._filtered):
                _, (ch_id, label, _) = self._filtered[self._cursor]
                self._play(f"{BASE}/{ch_id}{SUFFIX}/{ch_id}.m3u8", label)

        elif key == Qt.Key_Backspace:
            if watching:
                self._stop_video()
            elif in_guide:
                self._show_view(0)

        elif key == Qt.Key_Up:
            if watching:
                self._volume_up()
            elif in_guide:
                self._guide_step("up")
            else:
                new = self._cursor - self._cols
                if new >= 0:
                    self._cursor = new
                    self._update_card_focus()
                    self._ensure_visible()

        elif key == Qt.Key_Down:
            if watching:
                self._volume_down()
            elif in_guide:
                self._guide_step("down")
            else:
                new = self._cursor + self._cols
                if new < len(self._buttons):
                    self._cursor = new
                    self._update_card_focus()
                    self._ensure_visible()

        elif key == Qt.Key_Left:
            if watching:
                self._seek(-10)
            elif in_guide:
                self._guide_step("left")
            elif self._cursor % self._cols > 0:
                self._cursor -= 1
                self._update_card_focus()
                self._ensure_visible()

        elif key == Qt.Key_Right:
            if watching:
                self._seek(10)
            elif in_guide:
                self._guide_step("right")
            elif (self._cursor % self._cols < self._cols - 1
                  and self._cursor + 1 < len(self._buttons)):
                self._cursor += 1
                self._update_card_focus()
                self._ensure_visible()

        elif key == Qt.Key_PageUp:
            self._country_idx = (self._country_idx - 1) % (len(self._countries_current) + 1)
            self._select_country(self._country_idx)

        elif key == Qt.Key_PageDown:
            self._country_idx = (self._country_idx + 1) % (len(self._countries_current) + 1)
            self._select_country(self._country_idx)

        elif key == Qt.Key_Home:
            if in_guide:
                self._guide_set_row(0)
                sb = self._guide_scroll.verticalScrollBar()
                if sb:
                    sb.setValue(0)
            else:
                self._cursor = 0
                self._update_card_focus()
                self._ensure_visible()

        elif key == Qt.Key_End:
            if in_guide:
                self._guide_set_row(len(self._guide_data) - 1)
            else:
                self._cursor = max(0, len(self._buttons) - 1)
                self._update_card_focus()
                self._ensure_visible()

        else:
            super().keyPressEvent(event)

    # =========================================================================
    # REDIMENSIONNEMENT
    # =========================================================================

    def resizeEvent(self, event):
        """Adapte la grille au redimensionnement."""
        super().resizeEvent(event)
        if self._loading_overlay.isVisible():
            self._loading_overlay.setGeometry(self.centralWidget().rect())
        vw = self._scroll.viewport().width()
        if vw > 100:
            new_cols = max(1, (vw - GRID_MARGIN * 2 + GRID_SPACING) // (CARD_W + GRID_SPACING))
            if new_cols != self._cols and self._buttons:
                self._cols = new_cols
                self._grid_dirty = True
                self._rebuild_visible_page()
        # guide visible → largeurs des lignes construites à jour
        if self._stack.currentIndex() == 2:
            self._guide_ensure_rows()

    # =========================================================================
    # FERMETURE
    # =========================================================================

    def closeEvent(self, event):
        """Nettoie les ressources."""
        self._stop_video()
        self._pad_timer.stop()
        self._load_anim.stop()
        self._epg_clock.stop()
        for device in list(self._gamepads.values()):
            try:
                device.close()
            except (OSError, IOError):
                pass
        self._gamepads.clear()
        self._pad_states.clear()
        super().closeEvent(event)


# =============================================================================
# POINT D'ENTRÉE
# =============================================================================

def main():
    # Forcer OpenGL desktop 3.3 core (pas GLES) pour compatibilité mpv
    fmt = QSurfaceFormat()
    fmt.setRenderableType(QSurfaceFormat.OpenGL)
    fmt.setVersion(3, 3)
    fmt.setProfile(QSurfaceFormat.CoreProfile)
    QSurfaceFormat.setDefaultFormat(fmt)

    app = QApplication(sys.argv)
    app.setApplicationName("Gablue TV")
    app.setDesktopFileName("gablue-tv")
    app.setOrganizationName("gablue")
    app.setStyle("Fusion")

    # Police légèrement agrandie pour usage TV
    font = QFont("Noto Sans", 11)
    font.setStyleStrategy(QFont.PreferAntialias)
    app.setFont(font)
    app.setStyleSheet(APP_STYLESHEET)

    win = TVWindow()
    if "--fullscreen" in sys.argv or "-f" in sys.argv:
        win.showFullScreen()
    else:
        win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
