        self.update_button.setIcon(QIcon.fromTheme("system-software-update"))
        menu = QMenu(self.update_button)
        menu.addAction(
            "Gablue (image système)…", lambda: self.update_requested.emit("gablue")
        )
        menu.addAction(
            "Flatpaks…", lambda: self.update_requested.emit("flatpak")
        )
        menu.addAction(
            "Gwine (composants)…", lambda: self.update_requested.emit("gwine")
        )
        self.update_button.setMenu(menu)
        layout.addWidget(self.update_button, 0, Qt.AlignVCenter)

        self.config_button = QPushButton("Configuration…", self)
        self.config_button.setObjectName("ghost")
        self.config_button.setCursor(Qt.PointingHandCursor)
        self.config_button.setIcon(QIcon.fromTheme("settings-configure"))
        self.config_button.setToolTip(
            "Protections du processeur et mode ERTM du Bluetooth"
        )
        self.config_button.clicked.connect(self.config_requested.emit)
        layout.addWidget(self.config_button, 0, Qt.AlignVCenter)


def ssh_capture(host: dict, command: str,
                timeout: float = 12.0) -> tuple[int, str]:
    """Exécute une commande distante et rend (code, sortie)."""
    try:
        result = subprocess.run(
            [SSH, *_ssh_opts(host), ssh_target(host), command],
            capture_output=True, text=True, timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired):
        return 255, ""
    return result.returncode, result.stdout


def remote_sudo_nopasswd(host: dict) -> bool:
    """`sudo -n` passe-t-il sur ce poste (image Gablue) ?"""
    code, _ = ssh_capture(host, "sudo -n true", timeout=10)
    return code == 0


def remote_sudo_prefix(password: str) -> str:
    """Ligne qui valide sudo une fois pour toutes (mot de passe sur stdin)."""
    if not password:
        return ""
    return "sudo -S -p '' -v || exit 1\n"


def ask_remote_password(parent, host: dict) -> str | None:
    """Mot de passe sudo du poste distant ; jamais enregistré, jamais en argv."""
    text, ok = QInputDialog.getText(
        parent, "Autorisation root",
        f"Mot de passe de « {host['user']} » sur {display_name(host)} :\n"
        "sudo le demande sur ce poste ; il n'est ni affiché ni enregistré.",
        QLineEdit.Password,
    )
    return text if ok else None


# -- réglages du noyau : état du prochain démarrage et application groupée ----

def kargs_pending() -> set[str]:
    """Paramètres du noyau du **prochain démarrage** (`rpm-ostree kargs`).

    `/proc/cmdline` ne décrit que le noyau en cours : après un changement il
    faudrait redémarrer pour voir le nouvel état, alors que `rpm-ostree kargs`
    affiche déjà la ligne de commande du déploiement à venir — en lecture, sans
    root. Repli sur `/proc/cmdline` hors système ostree.
    """
    try:
        result = subprocess.run(
            [_which("rpm-ostree"), "kargs"],
            capture_output=True, text=True, timeout=15,
        )
        if result.returncode == 0 and result.stdout.strip():
            return set(result.stdout.split())
    except (OSError, subprocess.TimeoutExpired):
        pass
    return kernel_cmdline()


# Libellé de la case, puis description affichée dessous.
CHOICE_LABELS = {
    "mitigations": (
        "Protections contre les failles du processeur",
        "Spectre, Meltdown et les autres failles du processeur sont corrigées "
        "par le noyau. Les désactiver (mitigations=off) accélère les vieux "
        "processeurs, mais laisse ces failles exploitables.",
    ),
    "ertm": (
        "Désactiver le mode ERTM du Bluetooth",
        "Le mode de retransmission ERTM fait décrocher certaines manettes et "
        "certains casques. Le désactiver (bluetooth.disable_ertm=1) les "
        "stabilise, au prix d'un débit un peu plus faible.",
    ),
}

# Mot affiché dans la confirmation, selon l'état de la case.
CHOICE_STATE = {
    "mitigations": {True: "activées", False: "désactivées"},
    "ertm": {True: "désactivé", False: "activé"},
}


def kargs_choices(kargs: set[str]) -> dict[str, bool]:
    """État des cases à cocher : coché = réglage Gablue appliqué."""
    return {
        "mitigations": KARG_MITIGATIONS_OFF not in kargs,
        "ertm": KARG_BT_ERTM in kargs,
    }


def kargs_ops(key: str, checked: bool) -> list[str]:
    """Opérations `rpm-ostree kargs` pour un choix donné."""
    if key == "mitigations":
        option = "--delete-if-present" if checked else "--append-if-missing"
        return [f"{option}={KARG_MITIGATIONS_OFF}"]
    if key == "ertm":
        option = "--append-if-missing" if checked else "--delete-if-present"
        return [f"{option}={KARG_BT_ERTM}"]
    raise ValueError(key)


def flatpak_update_script() -> str:
    """Mise à jour des Flatpaks : compte, puis système sans mot de passe.

    Sans option, `flatpak update` ne vise que l'installation système (défaut de
    flatpak) et PolicyKit demande le mot de passe ; l'image autorise
    `/usr/bin/flatpak update --system -y` dans `/etc/sudoers.d/nopasswd`
    (arguments exacts, aucun joker), donc `sudo -n` passe sans dialogue. Hors
    image Gablue la règle manque : l'appel direct reprend la main et PolicyKit
    demande l'autorisation comme avant.
    """
    return (
        "rc=0\n"
        "if [ -n \"$(flatpak --user list --columns=application 2>/dev/null)\" ]; "
        "then flatpak update --user -y || rc=$?; fi\n"
        "sudo -n flatpak update --system -y || "
        "flatpak update --system -y || rc=$?\n"
        "exit $rc\n"
    )


class SettingsDialog(QDialog):
    """Options avancées : des cases à cocher, un seul bouton « Appliquer ».

    Les deux réglages sont des paramètres du noyau : les choix sont accumulés
    puis envoyés en **un seul** `rpm-ostree kargs` — un déploiement, une
    autorisation — au lieu d'un aller-retour par case. L'état lu est celui du
    prochain démarrage, donc les cases restent justes une fois appliquées.

    La lecture et l'exécution viennent des sous-classes : machine courante
    (`LocalSettingsDialog`) ou poste distant par SSH (`RemoteSettingsDialog`).
    """

    ROWS = ("mitigations", "ertm")

    def __init__(self, parent=None, title: str = "Configuration avancée",
                 subtitle: str = ""):
        super().__init__(parent)
        self.setWindowTitle(title)
        self.setModal(True)
        self.setMinimumWidth(640)

        root_layout = QVBoxLayout(self)
        root_layout.setContentsMargins(24, 22, 24, 20)
        root_layout.setSpacing(10)

        heading = QLabel(title, self)
        heading.setObjectName("title")
        root_layout.addWidget(heading)

        note = QLabel(subtitle, self)
        note.setObjectName("subtitle")
        note.setWordWrap(True)
        root_layout.addWidget(note)

        self.rows_layout = QVBoxLayout()
        self.rows_layout.setSpacing(8)
        root_layout.addLayout(self.rows_layout, 1)
        self.checks: dict[str, QCheckBox] = {}
        for key in self.ROWS:
            label, description = CHOICE_LABELS[key]
            self._add_row(key, label, description)

        buttons = QHBoxLayout()
        buttons.setSpacing(10)
        self.hint_label = QLabel(self)
        self.hint_label.setObjectName("hostStatus")
        buttons.addWidget(self.hint_label)
        buttons.addStretch(1)
        self.close_button = QPushButton("Fermer", self)
        self.close_button.setObjectName("ghost")
        self.close_button.setCursor(Qt.PointingHandCursor)
        self.close_button.clicked.connect(self.accept)
        buttons.addWidget(self.close_button)
        self.apply_button = QPushButton("Appliquer", self)
        self.apply_button.setObjectName("accent")
        self.apply_button.setCursor(Qt.PointingHandCursor)
        self.apply_button.clicked.connect(self.apply_changes)
        buttons.addWidget(self.apply_button)
        root_layout.addLayout(buttons)

        self.state: dict = {"ok": False}
        self.initial: dict[str, bool] = {}
        self.refresh()

    def _add_row(self, key: str, label: str, description: str) -> None:
        frame = QFrame(self)
        frame.setObjectName("hostCard")
        layout = QVBoxLayout(frame)
        layout.setContentsMargins(16, 12, 16, 12)
        layout.setSpacing(6)

        check = QCheckBox(label, frame)
        check.setCursor(Qt.PointingHandCursor)
        check.toggled.connect(self._update_apply)
        layout.addWidget(check)
        self.checks[key] = check

        detail = QLabel(description, frame)
        detail.setObjectName("hostDetail")
        detail.setWordWrap(True)
        layout.addWidget(detail)

        self.rows_layout.addWidget(frame)

    # -- état ---------------------------------------------------------------
    def refresh(self) -> None:
        self.state = self.read_state()
        ok = bool(self.state.get("ok"))
        choices = kargs_choices(self.state.get("kargs", set())) if ok else {}
        self.initial = dict(choices)
        for key, check in self.checks.items():
            check.blockSignals(True)
            check.setChecked(bool(choices.get(key)))
            check.blockSignals(False)
            check.setEnabled(ok)
        self._update_apply()

    def changed(self) -> list[str]:
        """Clés dont la case diffère de l'état du noyau."""
        return [
            key for key, check in self.checks.items()
            if check.isChecked() != self.initial.get(key)
        ]

    def _update_apply(self) -> None:
        if not self.state.get("ok"):
            self.apply_button.setEnabled(False)
            self.hint_label.setText("État illisible — réglages non modifiables.")
            return
        changed = self.changed()
        self.apply_button.setEnabled(bool(changed))
        if changed:
            count = len(changed)
            self.hint_label.setText(
                f"{count} réglage{'s' if count > 1 else ''} à appliquer"
            )
        else:
            self.hint_label.setText("Aucun changement.")

    # -- application groupée ------------------------------------------------
    def apply_changes(self) -> None:
        keys = self.changed()
        if not keys:
            return
        details = "\n".join(
            f"• {CHOICE_LABELS[key][0]} : "
            f"{CHOICE_STATE[key][self.checks[key].isChecked()]}"
            for key in keys
        )
        answer = QMessageBox.question(
            self, "Réglages du noyau",
            f"Appliquer ces réglages ?\n\n{details}\n\n"
            "Ils prennent effet au prochain démarrage.",
            QMessageBox.Yes | QMessageBox.No, QMessageBox.No,
        )
        if answer != QMessageBox.Yes:
            return
        ops = [
            operation for key in keys
            for operation in kargs_ops(key, self.checks[key].isChecked())
        ]
        self.apply(ops)
        self.refresh()

    def reject(self) -> None:
        # Fermer avec des cases modifiées ne doit pas jeter les choix en
        # silence : l'application se fait uniquement par « Appliquer ».
        if self.changed():
            answer = QMessageBox.question(
                self, "Réglages non appliqués",
                "Fermer sans appliquer les réglages modifiés ?",
                QMessageBox.Yes | QMessageBox.No, QMessageBox.No,
            )
            if answer != QMessageBox.Yes:
                return
        super().reject()

    # -- à fournir par la sous-classe ---------------------------------------
    def read_state(self) -> dict:
        raise NotImplementedError

    def apply(self, ops: list[str]) -> None:
        raise NotImplementedError


class LocalSettingsDialog(SettingsDialog):
    """Options avancées de la machine courante."""

    def __init__(self, parent=None):
        super().__init__(
            parent, "Configuration avancée",
            "Réglages de cette machine, écrits dans la ligne de commande du "
            "noyau : effet au prochain démarrage. Les changements partent "
            "ensemble, en une seule opération.",
        )

    def read_state(self) -> dict:
        return {"ok": True, "kargs": kargs_pending()}

    def apply(self, ops: list[str]) -> None:
        dialog = LocalTaskDialog(
            self, title="Réglages du noyau",
            subtitle="rpm-ostree kargs — effet au prochain démarrage.",
            argv=[_which("rpm-ostree"), "kargs", *ops], root=True,
        )
        dialog.exec()


class RemoteSettingsDialog(SettingsDialog):
    """Options avancées d'un poste distant, lues et appliquées par SSH."""

    def __init__(self, parent=None, host: dict | None = None):
        self.host = dict(host or {})
        super().__init__(
            parent, f"Configuration avancée — {display_name(self.host)}",
            f"Réglages de {address_text(self.host)}, lus et appliqués par SSH : "
            "effet à son prochain démarrage. Les changements partent ensemble, "
            "en une seule opération.",
        )

    def read_state(self) -> dict:
        code, output = ssh_capture(
            self.host, "rpm-ostree kargs 2>/dev/null || cat /proc/cmdline"
        )
        if code != 0 or not output.strip():
            return {"ok": False}
        return {"ok": True, "kargs": set(output.split())}

    def apply(self, ops: list[str]) -> None:
        password = ""
        if not remote_sudo_nopasswd(self.host):
            password = ask_remote_password(self, self.host)
            if password is None:
                return
        command = (
            remote_sudo_prefix(password)
            + "sudo -n /usr/bin/rpm-ostree kargs "
            + " ".join(ops) + "\n"
        )
        dialog = RemoteTaskDialog(
            self, host=self.host, title="Réglages du noyau",
            subtitle="rpm-ostree kargs — effet au prochain démarrage.",
            command=command, password=password,
        )
        dialog.exec()


