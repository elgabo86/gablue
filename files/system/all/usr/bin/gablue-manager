#!/usr/bin/python3

"""
Gablue Manager — les postes distants et cette machine, au même endroit.

Liste les machines dont la clé SSH a été installée, vérifie régulièrement
qu'elles répondent (clé acceptée ou non), puis lance d'un clic :

  • le bureau distant  → gremote (RDP tunnelisé en SSH)
  • les fichiers       → Dolphin en sftp://
  • le terminal        → konsole -e ssh

L'ajout d'un poste copie la clé publique locale (ssh-copy-id) : le mot de passe
n'est demandé qu'une fois, pour la copie, et n'est jamais enregistré.

La carte « Ce poste » gère la machine courante : mises à jour (image Gablue,
Flatpaks, gwine) et options avancées (protections du processeur, mode ERTM du
Bluetooth) — reprise de l'ancien gablue-config.

Lancement : gablue-manager
            gablue-manager --help

Les postes sont décrits dans ~/.config/gablue/ssh-hosts.json (mode 0600).
"""

import fcntl
import getpass
import glob
import ipaddress
import json
import math
import os
import pty
