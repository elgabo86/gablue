"""


def make_qss() -> str:
    palette = QApplication.palette()
    dark = palette.color(QPalette.Window).lightness() < 128
    text = palette.color(QPalette.WindowText)
    accent = palette.color(QPalette.Highlight)
    on_accent = palette.color(QPalette.HighlightedText)
    if accent.lightness() == text.lightness():
        accent = QColor("#3daee9")
    base = palette.color(QPalette.Base)
    white = QColor(255, 255, 255)
    black = QColor(0, 0, 0)
    tint = white if dark else black
    values = {
        "@card@": _rgba(tint, 20 if dark else 9),
        "@cardHover@": _rgba(tint, 34 if dark else 16),
        "@pressed@": _rgba(tint, 46 if dark else 24),
        "@border@": _rgba(tint, 32 if dark else 26),
        "@accent@": accent.name(),
        "@accentSoft@": _rgba(accent, 170),
        "@accentHover@": (accent.lighter(112) if dark else accent.darker(108)).name(),
        "@onAccent@": on_accent.name(),
        "@text@": text.name(),
        "@dim@": _rgba(text, 160),
        "@field@": base.name(),
        "@menu@": base.name(),
        "@online@": COLOR_ONLINE,
        "@auth@": COLOR_AUTH,
    }
    qss = QSS_TEMPLATE
    for token, value in values.items():
        qss = qss.replace(token, value)
    return qss


# =============================================================================
# SECTION 5 : PASTILLE D'ÉTAT
# =============================================================================

class StatusDot(QWidget):
    """Pastille colorée ; halo qui respire quand le poste est en ligne."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setFixedSize(26, 26)
        self._state = "unknown"
        self._phase = 0.0

    def set_state(self, state: str) -> None:
        if state == self._state:
            return
        self._state = state
        self.update()

    def animated(self) -> bool:
        return self._state in ("online", "checking")

    def tick(self) -> None:
        if self.animated():
            self._phase += 0.14
            self.update()

    def paintEvent(self, event) -> None:
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)
        center = QPointF(self.width() / 2.0, self.height() / 2.0)
        color = QColor(STATE_COLOR.get(self._state, COLOR_OFFLINE))

        if self._state == "online":
            halo = QColor(color)
            halo.setAlpha(int(40 + 55 * (0.5 + 0.5 * math.sin(self._phase))))
            painter.setPen(Qt.NoPen)
            painter.setBrush(halo)
            painter.drawEllipse(center, 9.5, 9.5)
        elif self._state == "checking":
            halo = QColor(color)
            halo.setAlpha(55)
            painter.setPen(Qt.NoPen)
            painter.setBrush(halo)
            radius = 6.5 + 2.5 * (0.5 + 0.5 * math.sin(self._phase))
            painter.drawEllipse(center, radius, radius)
        elif self._state in ("auth", "hostkey", "nokey"):
            halo = QColor(color)
            halo.setAlpha(45)
            painter.setPen(Qt.NoPen)
            painter.setBrush(halo)
            painter.drawEllipse(center, 8.5, 8.5)

        painter.setPen(QPen(QColor(0, 0, 0, 60), 1))
        painter.setBrush(color)
        painter.drawEllipse(center, 5.0, 5.0)
        painter.end()


# =============================================================================
# SECTION 6 : CARTE D'UN POSTE
# =============================================================================

def _make_tool_button(parent, icon_name: str, fallback: str) -> QToolButton:
    """Bouton-icône compact, avec repli texte si le thème n'a pas l'icône."""
    button = QToolButton(parent)
    button.setObjectName("more")
    button.setCursor(Qt.PointingHandCursor)
    button.setIconSize(QSize(18, 18))
    icon = QIcon.fromTheme(icon_name)
    if icon.isNull():
        button.setText(fallback)
    else:
        button.setIcon(icon)
    return button


class HostCard(QFrame):
    """Une ligne graphique : état, identité, actions."""

    remote_requested = Signal(str)
    remote_stop_requested = Signal(str)
    files_requested = Signal(str)
    edit_requested = Signal(str)
    delete_requested = Signal(str)
    key_requested = Signal(str)
    terminal_requested = Signal(str)
    wake_requested = Signal(str)
    update_requested = Signal(str, str)   # id du poste, type de mise à jour
    settings_requested = Signal(str)
    reboot_requested = Signal(str)
    shutdown_requested = Signal(str)

    def __init__(self, host: dict, parent=None):
        super().__init__(parent)
        self.host = host
        self.setObjectName("hostCard")
        self.setAttribute(Qt.WA_Hover, True)
        self.setMinimumHeight(92)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)

        layout = QHBoxLayout(self)
        layout.setContentsMargins(18, 14, 16, 14)
        layout.setSpacing(14)

        self.dot = StatusDot(self)
        layout.addWidget(self.dot, 0, Qt.AlignVCenter)

        texts = QVBoxLayout()
        texts.setSpacing(2)
        self.name_label = QLabel(display_name(host), self)
        self.name_label.setObjectName("hostName")
        self.detail_label = QLabel(address_text(host), self)
        self.detail_label.setObjectName("hostDetail")
        self.status_label = QLabel(STATE_TEXT["unknown"], self)
        self.status_label.setObjectName("hostStatus")
        texts.addWidget(self.name_label)
        texts.addWidget(self.detail_label)
        texts.addSpacing(3)
        texts.addWidget(self.status_label)
        layout.addLayout(texts, 1)

        self.wake_button = QPushButton("Réveiller", self)
        self.wake_button.setObjectName("ghost")
        self.wake_button.setCursor(Qt.PointingHandCursor)
        self.wake_button.setToolTip(
            "Envoyer un paquet magique Wake-on-LAN à ce poste"
        )
        self.wake_button.setVisible(False)
        self.wake_button.clicked.connect(
            lambda: self.wake_requested.emit(self.host["id"])
        )
        layout.addWidget(self.wake_button, 0, Qt.AlignVCenter)

        self.key_button = QPushButton("Installer la clé", self)
        self.key_button.setObjectName("ghost")
        self.key_button.setCursor(Qt.PointingHandCursor)
        self.key_button.setVisible(False)
        self.key_button.clicked.connect(
            lambda: self.key_requested.emit(self.host["id"])
        )
        layout.addWidget(self.key_button, 0, Qt.AlignVCenter)

        self.remote_button = QPushButton("Bureau distant", self)
        self.remote_button.setObjectName("accent")
        self.remote_button.setCursor(Qt.PointingHandCursor)
        self.remote_button.setIcon(QIcon.fromTheme("computer"))
        self.remote_button.setToolTip("Ouvrir le bureau distant de ce poste")
        self.remote_button.clicked.connect(
            lambda: self.remote_requested.emit(self.host["id"])
        )
        layout.addWidget(self.remote_button, 0, Qt.AlignVCenter)
        self._remote_active = False

        self.files_button = QPushButton("Fichiers", self)
        self.files_button.setCursor(Qt.PointingHandCursor)
        self.files_button.setIcon(QIcon.fromTheme("folder-remote"))
        self.files_button.setToolTip(f'Parcourir {dolphin_url(host)}')
        self.files_button.clicked.connect(
            lambda: self.files_requested.emit(self.host["id"])
        )
        layout.addWidget(self.files_button, 0, Qt.AlignVCenter)

        self.terminal_button = QPushButton("Terminal", self)
        self.terminal_button.setCursor(Qt.PointingHandCursor)
        self.terminal_button.setIcon(QIcon.fromTheme("utilities-terminal"))
        self.terminal_button.setToolTip(
            f"Ouvrir un terminal SSH sur {ssh_target(host)}"
        )
        self.terminal_button.clicked.connect(
            lambda: self.terminal_requested.emit(self.host["id"])
        )
        layout.addWidget(self.terminal_button, 0, Qt.AlignVCenter)

        self.more_button = _make_tool_button(self, "view-more-symbolic", "⋮")
        self.more_button.setPopupMode(QToolButton.InstantPopup)
        menu = QMenu(self.more_button)
        self.remote_stop_action = menu.addAction(
            "Fermer la session de bureau distant"
        )
        self.remote_stop_action.setEnabled(False)
        self.remote_stop_action.triggered.connect(
            lambda: self.remote_stop_requested.emit(self.host["id"])
        )
        menu.addSeparator()
        self.wake_action = menu.addAction("Réveiller le poste")
        self.wake_action.triggered.connect(
            lambda: self.wake_requested.emit(self.host["id"])
        )
        menu.addSeparator()
        update_menu = menu.addMenu("Mettre à jour")
        for kind, label in (
            ("gablue", "Gablue (image système)…"),
            ("flatpak", "Flatpaks…"),
            ("gwine", "Gwine (composants)…"),
        ):
            update_menu.addAction(
                label,
                lambda _checked=False, k=kind: self.update_requested.emit(
                    self.host["id"], k
                ),
            )
        settings_action = menu.addAction("Configuration avancée…")
        settings_action.triggered.connect(
            lambda: self.settings_requested.emit(self.host["id"])
        )
        reboot_action = menu.addAction("Redémarrer…")
        reboot_action.triggered.connect(
            lambda: self.reboot_requested.emit(self.host["id"])
        )
        shutdown_action = menu.addAction("Éteindre…")
        shutdown_action.triggered.connect(
            lambda: self.shutdown_requested.emit(self.host["id"])
        )
        menu.addSeparator()
        self.key_action = menu.addAction("Installer la clé SSH…")
        self.key_action.triggered.connect(
            lambda: self.key_requested.emit(self.host["id"])
        )
        edit_action = menu.addAction("Modifier…")
        edit_action.triggered.connect(
            lambda: self.edit_requested.emit(self.host["id"])
        )
        menu.addSeparator()
        delete_action = menu.addAction("Supprimer…")
        delete_action.triggered.connect(
            lambda: self.delete_requested.emit(self.host["id"])
        )
        self.more_button.setMenu(menu)
        layout.addWidget(self.more_button, 0, Qt.AlignVCenter)

        self.set_state("unknown", "")

    # -- état ---------------------------------------------------------------
    @property
    def remote_active(self) -> bool:
        return self._remote_active

    def set_remote_active(self, active: bool) -> None:
        """État de la session suivie : active l'entrée « Fermer » du menu ⋯.

        Le bouton, lui, relance toujours une connexion (nouvelle fenêtre) :
        c'est le comportement attendu, un second client RDP coupant le
        précédent côté KRdp.
        """
        self._remote_active = active
        self.remote_stop_action.setEnabled(active)

    def set_state(self, state: str, detail: str = "",
                  latency: float = 0.0) -> None:
        self.dot.set_state(state)
        text = STATE_TEXT.get(state, state)
        if state == "error" and detail:
            text = f"Erreur : {detail}"
        if state == "online" and latency:
            text = f"{text} · {latency:.0f} ms"
        self.status_label.setText(text)
        color = STATE_COLOR.get(state, COLOR_OFFLINE)
        self.status_label.setStyleSheet(f"color: {color};")
        self.key_button.setVisible(state in KEY_STATES)
        self.wake_button.setVisible(
            state in ("refused", "timeout", "noroute", "dns", "error")
            and bool(self.host.get("mac"))
        )
        self.wake_action.setEnabled(bool(self.host.get("mac")))
        if state == "nokey":
            self.key_button.setText("Créer la clé")
        elif state == "hostkey":
            self.key_button.setText("Accepter et installer")
        else:
            self.key_button.setText("Installer la clé")
        self.key_action.setText(
            "Réinstaller la clé SSH…" if self.host.get("key_added")
            else "Installer la clé SSH…"
        )
        if detail:
            self.setToolTip(f"{display_name(self.host)}\n{detail}")
        else:
            self.setToolTip("")

    # -- survol -------------------------------------------------------------
    def _set_hover(self, hovered: bool) -> None:
        self.setProperty("hover", hovered)
        self.style().unpolish(self)
        self.style().polish(self)

    def enterEvent(self, event) -> None:
        self._set_hover(True)
        super().enterEvent(event)

    def leaveEvent(self, event) -> None:
        self._set_hover(False)
        super().leaveEvent(event)


# =============================================================================
# SECTION 7 : DIALOGUE AJOUT / MODIFICATION
# =============================================================================

class HostDialog(QDialog):
    """Saisie d'un poste ; en ajout, propose la copie de la clé."""

    def __init__(self, parent=None, host: dict | None = None,
                 existing: list[dict] | None = None):
        super().__init__(parent)
        self._host = host
        self._existing = existing or []
        self._install = False
        self._password = ""

        self.setWindowTitle(
            "Modifier le poste" if host else "Ajouter un poste SSH"
        )
        self.setModal(True)
        self.setMinimumWidth(480)

        root = QVBoxLayout(self)
        root.setContentsMargins(24, 22, 24, 20)
        root.setSpacing(12)

        title = QLabel(
            "Modifier le poste" if host else "Ajouter un poste SSH"
        )
        title.setObjectName("title")
        root.addWidget(title)

        subtitle = QLabel(
            "La clé publique sera copiée sur la machine pour éviter le mot de "
            "passe à chaque connexion. Si elle est déjà en place, aucun mot de "
            "passe n'est demandé."
            if not host else
            "Le mot de passe et la clé ne sont pas modifiés ici."
        )
        subtitle.setObjectName("subtitle")
        subtitle.setWordWrap(True)
        root.addWidget(subtitle)
        root.addSpacing(6)

        form = QVBoxLayout()
        form.setSpacing(10)

        form.addWidget(self._field_label("Nom (facultatif)"))
        self.label_edit = QLineEdit(self)
        self.label_edit.setPlaceholderText("Salon, atelier, portable…")
        form.addWidget(self.label_edit)

        form.addWidget(self._field_label("Utilisateur"))
        self.user_edit = QLineEdit(self)
        self.user_edit.setPlaceholderText("gab")
        form.addWidget(self.user_edit)

        form.addWidget(self._field_label("Hôte ou adresse IP"))
        self.host_edit = QLineEdit(self)
        self.host_edit.setPlaceholderText("sucina.local ou 192.168.1.42")
        form.addWidget(self.host_edit)

        form.addWidget(self._field_label("Port SSH"))
        self.port_spin = QSpinBox(self)
        self.port_spin.setRange(1, 65535)
        self.port_spin.setValue(22)
        self.port_spin.setMaximumWidth(140)
        form.addWidget(self.port_spin)

        form.addWidget(self._field_label(
            "Adresse MAC (Wake-on-LAN, facultatif)"
        ))
        mac_row = QHBoxLayout()
        mac_row.setSpacing(8)
        self.mac_edit = QLineEdit(self)
        self.mac_edit.setPlaceholderText("AA:BB:CC:DD:EE:FF")
        mac_row.addWidget(self.mac_edit, 1)
        self.mac_button = QPushButton("Détecter", self)
        self.mac_button.setObjectName("ghost")
        self.mac_button.setCursor(Qt.PointingHandCursor)
        self.mac_button.clicked.connect(self._detect_mac)
        mac_row.addWidget(self.mac_button)
        form.addLayout(mac_row)
        self.mac_hint = QLabel(
            "Capturée automatiquement au premier contact réussi ; utile pour "
            "réveiller un poste éteint.", self,
        )
        self.mac_hint.setObjectName("hint")
        self.mac_hint.setWordWrap(True)
        form.addWidget(self.mac_hint)

        if not host:
            self.password_label = self._field_label(
                "Mot de passe SSH (une seule fois)"
            )
            self.password_edit = QLineEdit(self)
            self.password_edit.setEchoMode(QLineEdit.Password)
            self.password_edit.setPlaceholderText(
                "utilisé pour copier la clé, jamais enregistré"
            )
            form.addWidget(self.password_label)
            form.addWidget(self.password_edit)
        else:
            # Aucun champ mot de passe en modification : un widget enfant non
            # ajouté au layout s'afficherait quand même dans le coin du dialogue.
            self.password_edit = None
        root.addLayout(form)

        hint = QLabel(
            "Le mot de passe ne sert qu'à déposer la clé publique dans "
            "~/.ssh/authorized_keys du poste (ssh-copy-id). Il n'est écrit nulle part."
        )
        hint.setObjectName("hint")
        hint.setWordWrap(True)
        if not host:
            root.addWidget(hint)

        self.error_label = QLabel(self)
        self.error_label.setObjectName("error")
        self.error_label.setWordWrap(True)
        self.error_label.setVisible(False)
        root.addWidget(self.error_label)

        root.addSpacing(4)

        buttons = QHBoxLayout()
        buttons.setSpacing(8)
        buttons.addStretch(1)
        cancel = QPushButton("Annuler", self)
        cancel.setObjectName("ghost")
        cancel.clicked.connect(self.reject)
        buttons.addWidget(cancel)

        if host:
            save = QPushButton("Enregistrer", self)
            save.setObjectName("accent")
            save.setDefault(True)
            save.clicked.connect(lambda: self._submit(False))
            buttons.addWidget(save)
        else:
            plain = QPushButton("Ajouter", self)
            plain.clicked.connect(lambda: self._submit(False))
            buttons.addWidget(plain)

            self.key_button = QPushButton("Ajouter et copier la clé", self)
            self.key_button.setObjectName("accent")
            self.key_button.setDefault(True)
            self.key_button.clicked.connect(lambda: self._submit(True))
            buttons.addWidget(self.key_button)
        root.addLayout(buttons)

        if host:
            self.label_edit.setText(host.get("label", ""))
            self.user_edit.setText(host["user"])
            self.host_edit.setText(host["host"])
            self.port_spin.setValue(host["port"])
            self.mac_edit.setText(host.get("mac", ""))
        else:
            self.user_edit.setText(getpass.getuser())
        self.host_edit.textChanged.connect(self._sync_placeholder)
        self._sync_placeholder(self.host_edit.text())

    @staticmethod
    def _field_label(text: str) -> QLabel:
        label = QLabel(text)
        label.setObjectName("hostDetail")
        return label

    def _sync_placeholder(self, text: str) -> None:
        if not self.label_edit.text():
            self.label_edit.setPlaceholderText(text.strip() or "Salon, atelier…")

    def _detect_mac(self) -> None:
        address = self.host_edit.text().strip()
        if not address:
            self.mac_hint.setText("Indiquez d'abord l'hôte.")
            return
        mac = detect_mac({"host": address})
        if mac:
            self.mac_edit.setText(mac)
            self.mac_hint.setText("Adresse MAC lue dans la table ARP locale.")
        else:
            self.mac_hint.setText(
                "Introuvable pour l'instant : le poste doit avoir communiqué "
                "récemment sur le réseau. Elle sera capturée à la prochaine "
                "connexion réussie."
            )

    def _show_error(self, message: str) -> None:
        self.error_label.setText(message)
        self.error_label.setVisible(True)

    def _submit(self, install: bool) -> None:
        self.error_label.setVisible(False)
        host = self.host_edit.text().strip()
        user = self.user_edit.text().strip()
        label = self.label_edit.text().strip()
        port = int(self.port_spin.value())
        mac_text = self.mac_edit.text().strip()
        mac = normalize_mac(mac_text)

        if not host:
            return self._show_error("Indiquez l'hôte ou l'adresse IP du poste.")
        if any(ch.isspace() for ch in host) or "/" in host:
            return self._show_error("L'hôte ne doit contenir ni espace ni « / ».")
        if "@" in host:
            return self._show_error(
                "Mettez l'utilisateur dans le champ « Utilisateur », pas dans l'hôte."
            )
        if not user:
            return self._show_error("Indiquez le nom d'utilisateur SSH.")
        if any(ch.isspace() for ch in user) or any(ch in user for ch in "@:/"):
            return self._show_error("Nom d'utilisateur invalide.")
        if mac_text and not mac:
            return self._show_error(
                "Adresse MAC invalide (format attendu : AA:BB:CC:DD:EE:FF)."
            )

        for other in self._existing:
            if self._host and other["id"] == self._host["id"]:
                continue
            if (other["user"], other["host"], other["port"]) == (user, host, port):
                return self._show_error(
                    f'{display_name(other)} utilise déjà {user}@{host}:{port}.'
                )

        self._install = install
        self._password = (
            self.password_edit.text()
            if install and self.password_edit is not None else ""
        )
        self.result_record = {
            "id": (self._host or {}).get("id") or uuid.uuid4().hex,
            "label": label,
            "user": user,
            "host": host,
            "port": port,
            "mac": mac,
            "key_added": bool((self._host or {}).get("key_added", False)),
            "added_at": int((self._host or {}).get("added_at") or time.time()),
        }
        self.accept()

    def install_requested(self) -> bool:
        return self._install

    def password(self) -> str:
        return self._password


# =============================================================================
# SECTION 8 : DIALOGUE D'INSTALLATION DE LA CLÉ
# =============================================================================

class KeyInstallDialog(QDialog):
    """Copie la clé publique, avec invite de mot de passe et journal."""

    installed = Signal()

    def __init__(self, parent=None, host: dict | None = None,
                 password: str = ""):
        super().__init__(parent)
        self._host = dict(host or {})
        self._worker: KeyInstallWorker | None = None
        self._success = False

        self.setWindowTitle(f"Clé SSH — {display_name(self._host)}")
        self.setModal(True)
        self.setMinimumWidth(520)

        root = QVBoxLayout(self)
        root.setContentsMargins(24, 22, 24, 20)
        root.setSpacing(12)

        title = QLabel(f"Copier la clé vers {display_name(self._host)}")
        title.setObjectName("title")
        root.addWidget(title)

        explanation = QLabel(
            f'La clé publique {PUBLIC_KEY.name} sera ajoutée à '
            f'~/.ssh/authorized_keys sur {address_text(self._host)}. '
            "Ensuite, plus de mot de passe : connexion, bureau distant et "
            "fichiers passent par la clé."
        )
        explanation.setObjectName("subtitle")
        explanation.setWordWrap(True)
        root.addWidget(explanation)
        root.addSpacing(4)

        root.addWidget(HostDialog._field_label("Mot de passe SSH"))
        self.password_edit = QLineEdit(self)
        self.password_edit.setEchoMode(QLineEdit.Password)
        self.password_edit.setPlaceholderText(
            "mot de passe du compte distant (jamais enregistré)"
        )
        self.password_edit.setText(password)
        root.addWidget(self.password_edit)

        hint = QLabel(
            "Le mot de passe sert uniquement à ssh-copy-id, il n'est ni écrit "
            "sur le disque ni stocké dans la configuration."
        )
        hint.setObjectName("hint")
        hint.setWordWrap(True)
        root.addWidget(hint)

        self.result_label = QLabel(self)
        self.result_label.setWordWrap(True)
        self.result_label.setVisible(False)
        root.addWidget(self.result_label)

        self.log_view = QPlainTextEdit(self)
        self.log_view.setReadOnly(True)
        self.log_view.setFixedHeight(150)
        self.log_view.setVisible(False)
        root.addWidget(self.log_view)

        buttons = QHBoxLayout()
        buttons.addStretch(1)
        self.close_button = QPushButton("Fermer", self)
        self.close_button.setObjectName("ghost")
        self.close_button.clicked.connect(self.reject)
        buttons.addWidget(self.close_button)

        self.install_button = QPushButton("Installer la clé", self)
        self.install_button.setObjectName("accent")
        self.install_button.setDefault(True)
        self.install_button.clicked.connect(self._start)
        buttons.addWidget(self.install_button)
        root.addLayout(buttons)

        self.password_edit.returnPressed.connect(self._start)

    def _start(self) -> None:
        if self._worker is not None and self._worker.isRunning():
            return
        password = self.password_edit.text()
        self.password_edit.setEnabled(False)
        self.install_button.setEnabled(False)
        self.install_button.setText("Installation…")
        self.result_label.setVisible(False)
        self.log_view.setVisible(True)
        self.log_view.clear()
        self.log_view.appendPlainText(
            f"→ {address_text(self._host)}\n"
        )

        worker = KeyInstallWorker(self._host, password, self)
        worker.log.connect(self._append_log)
        worker.confirm_host_key.connect(self._ask_host_key)
        worker.done.connect(self._finished)
        self._worker = worker
        worker.start()

    def _ask_host_key(self, name: str, fingerprints: list) -> None:
        """Premier contact : montrer l'empreinte, ne jamais l'accepter en douce."""
        details = "\n".join(f"    {item}" for item in fingerprints) or "    (aucune)"
        text = (
            f"Le poste « {name} » n'est pas encore dans ~/.ssh/known_hosts.\n\n"
            f"Empreintes annoncées par la machine :\n{details}\n\n"
            "Vérifiez-les sur le poste, par exemple :\n"
            "    ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub\n\n"
            "Accepter cette empreinte pour les prochaines connexions ?"
        )
        answer = QMessageBox.question(
            self, "Premier contact — vérifier l'empreinte", text,
            QMessageBox.Yes | QMessageBox.No, QMessageBox.No,
        )
        worker = self._worker
        if worker is not None:
            worker.trust_answer = answer == QMessageBox.Yes
            worker.trust_event.set()

    def _append_log(self, text: str) -> None:
        self.log_view.insertPlainText(text)
        bar = self.log_view.verticalScrollBar()
        bar.setValue(bar.maximum())

    def _finished(self, ok: bool, message: str) -> None:
        self._success = ok
        self.result_label.setVisible(True)
        if ok:
            self.result_label.setObjectName("ok")
            self.result_label.setText(f"Clé installée — {message}.")
            self.install_button.setVisible(False)
            self.close_button.setText("Fermer")
            self.close_button.setDefault(True)
            self.installed.emit()
        else:
            self.result_label.setObjectName("warn")
            self.result_label.setText(f"Échec — {message}.")
            self.password_edit.setEnabled(True)
            self.install_button.setEnabled(True)
            self.install_button.setText("Réessayer")
        self.result_label.style().unpolish(self.result_label)
        self.result_label.style().polish(self.result_label)
        # Succès : le secret n'a plus d'utilité, on le jette. Échec : on le
        # laisse en place (masqué) pour que « Réessayer » ne le redemande pas.
        if ok:
            self.password_edit.setText("")

    def reject(self) -> None:
        if self._worker is not None and self._worker.isRunning():
            self._worker.cancel.set()
            self._worker.trust_event.set()   # débloque l'attente d'empreinte
            self._worker.wait(3000)
        super().reject()

    def key_installed(self) -> bool:
        return self._success


class RemoteTaskDialog(QDialog):
    """Commande distante avec journal en direct (arrêt, redémarrage, mise à jour)."""

    def __init__(self, parent=None, host: dict | None = None, title: str = "",
                 subtitle: str = "", command: str = "",
                 ok_if_disconnect: bool = False, hint_from_output=None,
                 password: str = ""):
        super().__init__(parent)
        self._host = dict(host or {})
        self._command = command
        self._password = password
        self._ok_if_disconnect = ok_if_disconnect
        self._hint_from_output = hint_from_output
        self._worker: SshTaskWorker | None = None
        self._output: list[str] = []
        self._cancelled = False
        self._running = True

        self.setWindowTitle(title or f"Action — {display_name(self._host)}")
        self.setModal(True)
        self.setMinimumWidth(560)

        root = QVBoxLayout(self)
        root.setContentsMargins(24, 22, 24, 20)
        root.setSpacing(10)

        heading = QLabel(title or display_name(self._host), self)
        heading.setObjectName("title")
        root.addWidget(heading)

        if subtitle:
            detail = QLabel(subtitle, self)
            detail.setObjectName("subtitle")
            detail.setWordWrap(True)
            root.addWidget(detail)

        self.log_view = QPlainTextEdit(self)
        self.log_view.setReadOnly(True)
        self.log_view.setMinimumHeight(260)
        self.log_view.setMaximumBlockCount(5000)
        root.addWidget(self.log_view, 1)

        self.result_label = QLabel(self)
        self.result_label.setWordWrap(True)
        self.result_label.setVisible(False)
        root.addWidget(self.result_label)

        buttons = QHBoxLayout()
        buttons.addStretch(1)
        self.cancel_button = QPushButton("Annuler", self)
        self.cancel_button.setObjectName("ghost")
        self.cancel_button.clicked.connect(self._cancel)
        buttons.addWidget(self.cancel_button)

        self.close_button = QPushButton("Fermer", self)
        self.close_button.setObjectName("accent")
        self.close_button.setVisible(False)
        self.close_button.clicked.connect(self.accept)
        buttons.addWidget(self.close_button)
        root.addLayout(buttons)

        self.log_view.appendPlainText(
            f"→ {ssh_target(self._host)} (port {self._host['port']})\n"
            f"$ {command}\n\n"
        )
        QTimer.singleShot(60, self._start)

    def _start(self) -> None:
        worker = SshTaskWorker(
            self._host, self._command, self, password=self._password
        )
        worker.log.connect(self._append)
        worker.done.connect(self._finished)
        self._worker = worker
        worker.start()

    def _append(self, text: str) -> None:
        self._output.append(text)
        self.log_view.insertPlainText(text)
        bar = self.log_view.verticalScrollBar()
        bar.setValue(bar.maximum())

    def _cancel(self) -> None:
        if not self._running or self._worker is None:
            return
        self._cancelled = True
        self.cancel_button.setEnabled(False)
        self._worker.cancel.set()

    def _finished(self, code: int) -> None:
        self._running = False
        output = "".join(self._output)
        ok = code == 0
        if not ok and self._ok_if_disconnect and code == 255:
            low = output.lower()
            if any(mark in low for mark in (
                "closed by remote", "connection reset", "broken pipe",
                "disconnected", "connection to",
            )):
                ok = True

        self.result_label.setVisible(True)
        if self._cancelled:
            self.result_label.setObjectName("warn")
            self.result_label.setText("Action annulée.")
        elif ok:
            extra = ""
            if self._hint_from_output is not None:
                extra = self._hint_from_output(output) or ""
            self.result_label.setObjectName("ok")
            self.result_label.setText(
                "Terminé." + (f" {extra}" if extra else "")
            )
        else:
            self.result_label.setObjectName("warn")
            self.result_label.setText(f"Échec (code {code}).")
        self.result_label.style().unpolish(self.result_label)
        self.result_label.style().polish(self.result_label)

        self.cancel_button.setVisible(False)
        self.close_button.setVisible(True)
        self.close_button.setDefault(True)

    def reject(self) -> None:
        if self._running and self._worker is not None:
            answer = QMessageBox.question(
                self, "Action en cours",
                "L'action n'est pas terminée. L'annuler et fermer ?",
                QMessageBox.Yes | QMessageBox.No, QMessageBox.No,
            )
            if answer != QMessageBox.Yes:
                return
            self._cancelled = True
            self._worker.cancel.set()
            self._worker.wait(3000)
        super().reject()


class AvahiWorker(QThread):
    """Recherche mDNS des services SSH du réseau local."""

    found = Signal(object)

    def __init__(self, parent=None):
        super().__init__(parent)
        self.stop = threading.Event()

    def run(self) -> None:
        try:
            self.found.emit(avahi_scan(stop=self.stop))
        except Exception:
            self.found.emit([])


class CandidateDialog(QDialog):
    """Liste à cocher de postes à ajouter (découverte mDNS ou ssh_config)."""

    def __init__(self, parent=None, title: str = "", subtitle: str = "",
                 candidates: list[dict] | None = None,
                 existing: list[dict] | None = None):
        super().__init__(parent)
        known = {
            (host["user"], host["host"], host["port"]) for host in (existing or [])
        }
        self._candidates = [
            item for item in (candidates or [])
            if (item["user"], item["host"], item["port"]) not in known
        ]
        self.selected: list[dict] = []

        self.setWindowTitle(title or "Postes à ajouter")
        self.setModal(True)
        self.setMinimumWidth(540)
        self.setMinimumHeight(420)

        root = QVBoxLayout(self)
        root.setContentsMargins(24, 22, 24, 20)
        root.setSpacing(10)

        heading = QLabel(title or "Postes à ajouter", self)
        heading.setObjectName("title")
        root.addWidget(heading)

        detail = QLabel(subtitle, self)
        detail.setObjectName("subtitle")
        detail.setWordWrap(True)
        root.addWidget(detail)

        self.list_widget = QListWidget(self)
        for candidate in self._candidates:
            text = (
                f'{candidate.get("label") or candidate["host"]} — '
                f'{candidate["user"]}@{candidate["host"]}:{candidate["port"]}'
            )
            item = QListWidgetItem(text, self.list_widget)
            item.setData(Qt.UserRole, candidate)
            item.setFlags(item.flags() | Qt.ItemIsUserCheckable)
            # Rien n'est coché d'avance : la découverte propose, elle n'ajoute
            # pas. Sinon la touche Entrée (bouton par défaut) suffirait à
            # inscrire tous les postes trouvés sans regarder la liste.
            item.setCheckState(Qt.Unchecked)
        root.addWidget(self.list_widget, 1)

        tools = QHBoxLayout()
        tools.setSpacing(8)
        self.all_button = QPushButton("Tout cocher", self)
        self.all_button.setObjectName("ghost")
        self.all_button.setCursor(Qt.PointingHandCursor)
        self.all_button.setEnabled(bool(self._candidates))
        self.all_button.clicked.connect(self._toggle_all)
        tools.addWidget(self.all_button)
        tools.addStretch(1)
        self.count_label = QLabel(self)
        self.count_label.setObjectName("hint")
        tools.addWidget(self.count_label)
        root.addLayout(tools)

        self.note = QLabel(
            "La clé SSH n'est pas encore installée : utilisez « Installer la "
            "clé » sur la carte une fois le poste ajouté."
            if self._candidates else
            "Aucun nouveau poste à ajouter.",
            self,
        )
        self.note.setObjectName("hint")
        self.note.setWordWrap(True)
        root.addWidget(self.note)

        buttons = QHBoxLayout()
        buttons.addStretch(1)
        cancel = QPushButton("Annuler", self)
        cancel.setObjectName("ghost")
        cancel.clicked.connect(self.reject)
        buttons.addWidget(cancel)

        self.add_button = QPushButton("Ajouter", self)
        self.add_button.setObjectName("accent")
        self.add_button.setDefault(True)
        self.add_button.clicked.connect(self._accept)
        buttons.addWidget(self.add_button)
        root.addLayout(buttons)

        self.list_widget.itemChanged.connect(self._sync_selection)
        self._sync_selection()

    def _checked(self) -> list[dict]:
        chosen = []
        for index in range(self.list_widget.count()):
            item = self.list_widget.item(index)
            if item.checkState() == Qt.Checked:
                chosen.append(item.data(Qt.UserRole))
        return chosen

    def _toggle_all(self) -> None:
        target = Qt.Unchecked if self._checked() else Qt.Checked
        for index in range(self.list_widget.count()):
            self.list_widget.item(index).setCheckState(target)

    def _sync_selection(self) -> None:
        count = len(self._checked())
        total = self.list_widget.count()
        self.all_button.setText("Tout décocher" if count == total and total
                                else "Tout cocher")
        self.count_label.setText(
            f"{count} sélectionné{'s' if count > 1 else ''} sur {total}"
        )
        self.add_button.setEnabled(count > 0)
        self.add_button.setText(f"Ajouter ({count})" if count else "Ajouter")

    def _accept(self) -> None:
        chosen = self._checked()
        if not chosen:
            self.note.setText("Cochez au moins un poste.")
            return
        self.selected = chosen
        self.accept()


class LocalTaskDialog(QDialog):
    """Commande locale en streaming (mises à jour, options système).

    Même déroulé que `RemoteTaskDialog`, mais via `QProcess` sur CETTE machine :
    sortie fusionnée en direct, annulation possible, et `sudo -n` / `pkexec`
    choisi automatiquement pour les commandes qui exigent root.
    """

    def __init__(self, parent=None, title: str = "", subtitle: str = "",
                 argv: list[str] | None = None, root: bool = False,
                 hint_from_output=None):
        super().__init__(parent)
        self._argv = list(argv or [])
        self._root = root
        self._hint_from_output = hint_from_output
        self._process: QProcess | None = None
        self._output: list[str] = []
        self._cancelled = False
        self._running = True

        self.setWindowTitle(title or "Action sur ce poste")
        self.setModal(True)
        self.setMinimumWidth(620)

        root_layout = QVBoxLayout(self)
        root_layout.setContentsMargins(24, 22, 24, 20)
        root_layout.setSpacing(10)

        heading = QLabel(title or "Action sur ce poste", self)
        heading.setObjectName("title")
        root_layout.addWidget(heading)

        if subtitle:
            detail = QLabel(subtitle, self)
            detail.setObjectName("subtitle")
            detail.setWordWrap(True)
            root_layout.addWidget(detail)

        self.log_view = QPlainTextEdit(self)
        self.log_view.setReadOnly(True)
        self.log_view.setMinimumHeight(280)
        self.log_view.setMaximumBlockCount(20000)
        root_layout.addWidget(self.log_view, 1)

        self.result_label = QLabel(self)
        self.result_label.setWordWrap(True)
        self.result_label.setVisible(False)
        root_layout.addWidget(self.result_label)

        buttons = QHBoxLayout()
        buttons.addStretch(1)
        self.cancel_button = QPushButton("Annuler", self)
        self.cancel_button.setObjectName("ghost")
        self.cancel_button.clicked.connect(self._cancel)
        buttons.addWidget(self.cancel_button)

        self.close_button = QPushButton("Fermer", self)
        self.close_button.setObjectName("accent")
        self.close_button.setVisible(False)
        self.close_button.clicked.connect(self.accept)
        buttons.addWidget(self.close_button)
        root_layout.addLayout(buttons)

        QTimer.singleShot(60, self._start)

    def _start(self) -> None:
        argv = list(self._argv)
        if self._root:
            prefix = privileged_prefix()
            if prefix == ["pkexec"] and shutil.which("pkexec") is None:
                self._append(
                    "Ni sudo sans mot de passe ni pkexec : action impossible.\n"
                )
                self._finished(127)
                return
            argv = [*prefix, *argv]

        self.log_view.appendPlainText("$ " + " ".join(argv) + "\n\n")
        process = QProcess(self)
        process.setProcessChannelMode(QProcess.MergedChannels)
        process.setProgram(argv[0])
        process.setArguments(argv[1:])
        process.readyReadStandardOutput.connect(self._drain)
        process.finished.connect(self._finished)
        process.errorOccurred.connect(self._start_failed)
        if hasattr(process, "setChildProcessModifier"):
            # Propre session : l'annulation emporte les enfants (bootc, ssh…).
            process.setChildProcessModifier(os.setsid)
        self._process = process
        process.start()

    def _drain(self) -> None:
        if self._process is None:
            return
        chunk = bytes(self._process.readAllStandardOutput())
        if chunk:
            self._append(chunk.decode("utf-8", "replace"))

    def _append(self, text: str) -> None:
        if not text:
            return
        self._output.append(text)
        self.log_view.insertPlainText(text)
        bar = self.log_view.verticalScrollBar()
        bar.setValue(bar.maximum())

    def _cancel(self) -> None:
        if not self._running or self._process is None:
            return
        self._cancelled = True
        self.cancel_button.setEnabled(False)
        self._append("\n[annulation…]\n")
        self._process.kill()

    def _start_failed(self, error) -> None:
        # finished() n'est pas émis quand le programme n'a pas pu démarrer.
        if error != QProcess.FailedToStart:
            return
        self._append(f"\nLancement impossible ({self._argv[0]}).\n")
        self._finished(127)

    def _finished(self, code: int) -> None:
        self._running = False
        output = "".join(self._output)
        ok = code == 0
        self.result_label.setVisible(True)
        if self._cancelled:
            self.result_label.setObjectName("warn")
            self.result_label.setText("Action annulée.")
        elif ok:
            extra = ""
            if self._hint_from_output is not None:
                extra = self._hint_from_output(output) or ""
            self.result_label.setObjectName("ok")
            self.result_label.setText("Terminé." + (f" {extra}" if extra else ""))
        else:
            self.result_label.setObjectName("warn")
            reasons = {
                126: "autorisation refusée",
                127: "non autorisé ou commande absente",
                125: "dialogue PolicyKit absent ou annulé",
            }
            detail = reasons.get(code, "")
            self.result_label.setText(
                f"Échec (code {code})" + (f" — {detail}" if detail else "") + "."
            )
        self.result_label.style().unpolish(self.result_label)
        self.result_label.style().polish(self.result_label)

        self.cancel_button.setVisible(False)
        self.close_button.setVisible(True)
        self.close_button.setDefault(True)
        self._process = None

    def reject(self) -> None:
        if self._running and self._process is not None:
            answer = QMessageBox.question(
                self, "Action en cours",
                "L'action n'est pas terminée. L'annuler et fermer ?",
                QMessageBox.Yes | QMessageBox.No, QMessageBox.No,
            )
            if answer != QMessageBox.Yes:
                return
            self._cancelled = True
            self._process.kill()
            self._process.waitForFinished(3000)
        super().reject()


class LocalCard(QFrame):
    """La machine courante : mises à jour et options avancées."""

    update_requested = Signal(str)   # "gablue" | "flatpak" | "gwine"
    config_requested = Signal()

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setObjectName("localCard")
        # Même hauteur et même amorce que les cartes de postes : la pastille
        # d'état y fait 26 px, l'icône doit occuper la même largeur, sinon le
        # texte et les boutons de cette carte sont décalés de 2 px.
        self.setMinimumHeight(92)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)

        layout = QHBoxLayout(self)
