def _which(name: str) -> str:
    """Chemin absolu d'un binaire, ou son nom si introuvable."""
    found = shutil.which(name)
    if found:
        return found
    for candidate in (f"/usr/bin/{name}", f"/usr/local/bin/{name}"):
        if os.access(candidate, os.X_OK):
            return candidate
    return name


SSH = _which("ssh")
SSH_COPY_ID = _which("ssh-copy-id")
SSH_KEYGEN = _which("ssh-keygen")
SSH_KEYSCAN = _which("ssh-keyscan")
AVAHI_BROWSE = _which("avahi-browse")
IP = _which("ip")


def ssh_target(host: dict) -> str:
    """Cible ssh : utilisateur@hôte (l'hôte IPv6 garde ses deux-points)."""
    return f'{host["user"]}@{host["host"]}'


def address_text(host: dict) -> str:
    """Adresse lisible : utilisateur@hôte, avec :port si non standard."""
    text = ssh_target(host)
    if host["port"] != 22:
        text += f':{host["port"]}'
    return text


def display_name(host: dict) -> str:
    return (host.get("label") or "").strip() or host["host"]


def dolphin_url(host: dict) -> str:
    """URL KIO sftp:// (crochets obligatoires autour d'une IPv6)."""
    addr = host["host"]
    if ":" in addr and not addr.startswith("["):
        addr = f"[{addr}]"
    url = f'sftp://{host["user"]}@{addr}'
    if host["port"] != 22:
        url += f':{host["port"]}'
    return url + "/"


def _broadcast_for(address: str) -> str:
    """Adresse de diffusion du sous-réseau qui route vers `address`."""
    try:
        route = subprocess.run(
            [IP, "route", "get", address], capture_output=True, text=True,
            timeout=4,
        )
        match = re.search(r"\bdev\s+(\S+)", route.stdout)
        if not match:
            return ""
        addr = subprocess.run(
            [IP, "-o", "-4", "addr", "show", "dev", match.group(1)],
            capture_output=True, text=True, timeout=4,
        )
        found = re.search(r"\binet\s+(\d+\.\d+\.\d+\.\d+/\d+)", addr.stdout)
        if not found:
            return ""
        return str(ipaddress.ip_interface(found.group(1)).network.broadcast_address)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return ""


def wake_on_lan(host: dict) -> tuple[bool, str]:
    """Envoie le paquet magique (broadcast global + diffusion du sous-réseau)."""
    mac = normalize_mac(host.get("mac", ""))
    if not mac:
        return False, "adresse MAC inconnue : renseignez-la dans « Modifier »"
    payload = b"\xff" * 6 + bytes.fromhex(mac.replace(":", "")) * 16
    targets = ["255.255.255.255"]
    subnet = _broadcast_for(host["host"])
    if subnet and subnet not in targets:
        targets.append(subnet)
    sent = 0
    last_error = ""
    for address in targets:
        for port in WOL_PORTS:
            try:
                with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
                    sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
                    sock.sendto(payload, (address, port))
                sent += 1
            except OSError as exc:
                last_error = str(exc)
    if sent:
        return True, ""
    return False, last_error or "envoi impossible"


def detect_mac(host: dict) -> str:
    """MAC dans la table ARP locale (gratuit, mais seulement si le poste a parlé)."""
    try:
        result = subprocess.run(
            [IP, "neigh", "show", "to", host["host"]],
            capture_output=True, text=True, timeout=4,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    match = re.search(r"lladdr\s+([0-9a-fA-F:]{17})", result.stdout)
    return normalize_mac(match.group(1)) if match else ""


def detect_mac_remote(host: dict) -> str:
    """MAC de l'interface par défaut, lue par SSH (poste en ligne, ARP vide)."""
    command = (
        "cat /sys/class/net/$(ip route show default 2>/dev/null"
        " | awk '{print $5; exit}')/address 2>/dev/null"
    )
    try:
        result = subprocess.run(
            [SSH, *_ssh_opts(host), ssh_target(host), command],
            capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return normalize_mac(result.stdout.strip()) if result.returncode == 0 else ""


def avahi_scan(timeout: float = 8.0,
               stop: threading.Event | None = None) -> list[dict]:
    """Postes SSH annoncés en mDNS sur le réseau local."""
    if AVAHI_BROWSE == "avahi-browse" and not shutil.which("avahi-browse"):
        return []
    try:
        proc = subprocess.Popen(
            [AVAHI_BROWSE, "-rtp", "_ssh._tcp"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
        )
    except OSError:
        return []
    deadline = time.monotonic() + timeout
    while proc.poll() is None:
        if ((stop is not None and stop.is_set())
                or time.monotonic() > deadline):
            proc.kill()
            proc.wait()
            return []
        time.sleep(0.1)
    output = proc.stdout.read() if proc.stdout is not None else ""
    found = []
    seen = set()
    for line in output.splitlines():
        if not line.startswith("="):
            continue
        fields = line.split(";")
        if len(fields) < 10:
            continue
        _, _iface, proto, name, service, _domain, hostname, address, port, _txt = \
            fields[:10]
        if proto != "IPv4" or service != "_ssh._tcp":
            continue
        if not address or "%" in address:
            continue
        try:
            number = int(port or 22)
        except ValueError:
            number = 22
        if (address, number) in seen:
            continue
        seen.add((address, number))
        label = re.sub(r"\s*\[[^]]*\]\s*$", "", name).strip() or hostname
        found.append({
            "label": label,
            "user": getpass.getuser(),
            "host": address,
            "port": number,
        })
    found.sort(key=lambda item: item["label"].casefold())
    return found


def _ssh_config_sources(path: Path, depth: int = 0, seen=None):
    """Lignes (clé, valeur) de ~/.ssh/config, Include compris, dans l'ordre."""
    seen = seen if seen is not None else set()
    try:
        resolved = path.resolve()
    except OSError:
        return
    if depth > 3 or resolved in seen or not resolved.is_file():
        return
    seen.add(resolved)
    try:
        text = resolved.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return
    for raw in text.splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        match = re.match(r"(?i)^include\s+(.+)$", line)
        if match:
            for pattern in match.group(1).split():
                target = Path(os.path.expanduser(pattern))
                if not target.is_absolute():
                    target = SSH_DIR / pattern
                for item in sorted(glob.glob(str(target))):
                    yield from _ssh_config_sources(Path(item), depth + 1, seen)
            continue
        if "=" in line:
            key, _, value = line.partition("=")
        else:
            key, _, value = line.partition(" ")
        yield key.strip().lower(), value.strip()


def parse_ssh_config() -> list[dict]:
    """Hôtes concrets de ~/.ssh/config ; les motifs (`*`, `?`, `!`) sont ignorés."""
    blocks = []
    defaults = {}
    current = None
    for key, value in _ssh_config_sources(SSH_DIR / "config"):
        if key == "host":
            current = {"patterns": value.split(), "opts": {}}
            blocks.append(current)
        elif key == "match":
            current = None
        elif value:
            if current is None:
                defaults.setdefault(key, value)
            else:
                current["opts"].setdefault(key, value)

    hosts = []
    seen = set()
    for block in blocks:
        for pattern in block["patterns"]:
            if not pattern or any(ch in pattern for ch in "*?!"):
                continue
            options = block["opts"]
            address = options.get("hostname", pattern)
            user = options.get("user", defaults.get("user", getpass.getuser()))
            try:
                port = int(options.get("port", defaults.get("port", 22)))
            except ValueError:
                port = 22
            if not (1 <= port <= 65535) or not address or "%" in address:
                continue
            if any(ch in address for ch in "@/") or "@" in user:
                continue
            key = (user, address, port)
            if key in seen:
                continue
            seen.add(key)
            hosts.append({
                "label": pattern, "user": user, "host": address, "port": port,
            })
    return hosts


def normalize_mac(value: object) -> str:
    """MAC sous forme AA:BB:CC:DD:EE:FF, ou chaîne vide si invalide."""
    digits = re.sub(r"[^0-9A-Fa-f]", "", str(value or ""))
    if len(digits) != 12:
        return ""
    return ":".join(digits[i:i + 2] for i in range(0, 12, 2)).upper()


def normalize_record(item: object) -> dict | None:
    """Valide une entrée du registre ; None si elle est inutilisable."""
    if not isinstance(item, dict):
        return None
    try:
        user = str(item["user"]).strip()
        name = str(item["host"]).strip()
        port = int(item.get("port", 22))
    except (KeyError, TypeError, ValueError):
        return None
    if not user or not name or not (1 <= port <= 65535):
        return None
    return {
        "id": str(item.get("id") or uuid.uuid4().hex),
        "label": str(item.get("label") or "").strip(),
        "user": user,
        "host": name,
        "port": port,
        "mac": normalize_mac(item.get("mac", "")),
        "key_added": bool(item.get("key_added", False)),
        "added_at": int(item.get("added_at") or time.time()),
    }


def load_hosts() -> list[dict]:
    """Lit le registre ; un fichier illisible est écarté, pas écrasé."""
    try:
        raw = HOSTS_FILE.read_text(encoding="utf-8")
    except FileNotFoundError:
        return []
    except OSError as exc:
        print(f"gablue-manager : {HOSTS_FILE} illisible ({exc})", file=sys.stderr)
        return []
    try:
        data = json.loads(raw)
    except ValueError:
        backup = HOSTS_FILE.with_name(
            f"ssh-hosts.corrupt-{int(time.time())}.json"
        )
        try:
            HOSTS_FILE.replace(backup)
            print(f"gablue-manager : registre illisible, sauvegardé dans {backup}",
                  file=sys.stderr)
        except OSError:
            pass
        return []
    hosts = data.get("hosts") if isinstance(data, dict) else data
    if not isinstance(hosts, list):
        return []
    cleaned = []
    seen = set()
    for item in hosts:
        host = normalize_record(item)
        if host and host["id"] not in seen:
            seen.add(host["id"])
            cleaned.append(host)
    return cleaned


def save_hosts(hosts: list[dict]) -> None:
    """Écriture atomique et privée (le registre contient des adresses)."""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(CONFIG_DIR, 0o700)
    except OSError:
        pass
    payload = json.dumps(
        {"version": 1, "hosts": hosts}, ensure_ascii=False, indent=2
    ) + "\n"
    fd, tmp = tempfile.mkstemp(dir=str(CONFIG_DIR), prefix=".ssh-hosts-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(payload)
        os.chmod(tmp, 0o600)
        os.replace(tmp, HOSTS_FILE)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def ensure_local_key() -> tuple[bool, str]:
    """Crée ~/.ssh/id_ed25519 (sans passphrase) si elle manque."""
    if PRIVATE_KEY.exists() and PUBLIC_KEY.exists():
        return True, ""
    try:
        SSH_DIR.mkdir(parents=True, exist_ok=True)
        os.chmod(SSH_DIR, 0o700)
    except OSError as exc:
        return False, f"~/.ssh inaccessible ({exc})"
    try:
        result = subprocess.run(
            [SSH_KEYGEN, "-t", "ed25519", "-N", "", "-q",
             "-C", f"{getpass.getuser()}@{socket.gethostname()}",
             "-f", str(PRIVATE_KEY)],
            capture_output=True, text=True, timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return False, f"ssh-keygen a échoué ({exc})"
    if result.returncode != 0 or not PUBLIC_KEY.exists():
        detail = (result.stderr or result.stdout or "").strip()
        return False, f"création de la clé impossible : {detail}"
    return True, ""


def _ssh_opts(host: dict, batch: bool = True,
              accept_new: bool = False) -> list[str]:
    """Options communes : on teste exactement LA clé gérée par Gablue."""
    check = "accept-new" if accept_new else "yes"
    opts = [
        "-T",
        "-i", str(PRIVATE_KEY),
        "-o", "IdentitiesOnly=yes",
        "-o", "ConnectTimeout=4",
        "-o", "ConnectionAttempts=1",
        "-o", f"StrictHostKeyChecking={check}",
        "-p", str(host["port"]),
    ]
    if batch:
        opts += ["-o", "BatchMode=yes"]
    return opts


def _sudo_run(argv: list[str]) -> tuple[bool, str]:
    """Exécute une commande privilégiée sans jamais demander de mot de passe."""
    try:
        result = subprocess.run(
            ["sudo", "-n", *argv], capture_output=True, text=True, timeout=25,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return False, str(exc)
    if result.returncode == 0:
        return True, ""
    lines = (result.stderr or result.stdout or "").strip().splitlines()
    return False, lines[-1] if lines else ""


def set_local_sshd_sudo(enabled: bool) -> tuple[bool, str]:
    """Tentative silencieuse d'activation/coupure du sshd local.

    `sudo -n` ne demande JAMAIS de mot de passe : sur une image Gablue
    (/etc/sudoers.d/nopasswd) c'est immédiat, ailleurs ça échoue en quelques
    millisecondes et l'appelant bascule sur `pkexec` (dialogue PolicyKit).
    """
    action = "enable" if enabled else "disable"
    return _sudo_run([_which("systemctl"), action, "sshd.service", "--now"])


def avahi_publish_state() -> tuple[bool, bool]:
    """(ce poste s'annonce en _ssh._tcp, avahi-daemon est actif)."""
    daemon = False
    try:
        result = subprocess.run(
            ["systemctl", "is-active", "avahi-daemon.service"],
            capture_output=True, text=True, timeout=5,
        )
        daemon = result.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        pass
    return AVAHI_SERVICE_FILE.exists(), daemon


def write_avahi_service_temp() -> str:
    """Écrit le fichier de service dans un temporaire (l'écriture /etc/ passe par sudo)."""
    fd, path = tempfile.mkstemp(prefix="gablue-manager-avahi-", suffix=".service")
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(AVAHI_SERVICE_XML)
    os.chmod(path, 0o644)
    return path


def avahi_publish_args(enabled: bool, temp_path: str) -> list[str]:
    """Commande privilégiée : installer le fichier, ou le retirer."""
    if enabled:
        return ["install", "-m", "644", temp_path, str(AVAHI_SERVICE_FILE)]
    return ["rm", "-f", str(AVAHI_SERVICE_FILE)]


def local_sshd_state() -> tuple[bool, bool]:
    """(actif maintenant, activé au démarrage)."""
    def query(verb: str) -> bool:
        try:
            result = subprocess.run(
                ["systemctl", verb, "sshd.service"],
                capture_output=True, text=True, timeout=5,
            )
        except (OSError, subprocess.TimeoutExpired):
            return False
        return result.returncode == 0

    return query("is-active"), query("is-enabled")


# -- machine courante : mises à jour et options avancées ----------------------
OS_RELEASE = Path("/etc/os-release")
CMDLINE = Path("/proc/cmdline")
KARG_MITIGATIONS_OFF = "mitigations=off"
KARG_BT_ERTM = "bluetooth.disable_ertm=1"


def local_distro() -> str:
    """PRETTY_NAME de /etc/os-release, ou chaîne vide."""
    try:
        for line in OS_RELEASE.read_text(encoding="utf-8").splitlines():
            if line.startswith("PRETTY_NAME="):
                return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return ""


def kernel_cmdline() -> set[str]:
    """Paramètres du noyau en cours (effet réel = après redémarrage)."""
    try:
        return set(CMDLINE.read_text(encoding="utf-8").split())
    except OSError:
        return set()


def privileged_prefix() -> list[str]:
    """`sudo -n` si l'image l'autorise (Gablue), sinon `pkexec` (PolicyKit)."""
    try:
        probe = subprocess.run(
            ["sudo", "-n", "true"], capture_output=True, timeout=5,
        )
        if probe.returncode == 0:
            return ["sudo", "-n"]
    except (OSError, subprocess.TimeoutExpired):
        pass
    return ["pkexec"]


def probe_key(host: dict, accept_new: bool = False) -> tuple[bool, str]:
    """La connexion sans mot de passe avec notre clé fonctionne-t-elle ?

    `accept_new` n'est utilisé que par l'installation : l'utilisateur demande
    explicitement à déposer la clé, on peut donc accepter l'empreinte d'hôte au
    premier contact (TOFU), comme le fait ssh-copy-id. La vérification
    périodique, elle, reste stricte et n'écrit jamais dans known_hosts.
    """
    if not (PRIVATE_KEY.exists() and PUBLIC_KEY.exists()):
        return False, "aucune clé locale"
    try:
        result = subprocess.run(
            [SSH, *_ssh_opts(host, accept_new=accept_new),
             ssh_target(host), "true"],
            capture_output=True, text=True, timeout=12,
        )
    except subprocess.TimeoutExpired:
        return False, "délai dépassé"
    except OSError as exc:
        return False, f"ssh introuvable ({exc})"
    if result.returncode == 0:
        return True, ""
    detail = (result.stderr or "").strip().splitlines()
    return False, detail[-1] if detail else f"ssh a retourné {result.returncode}"


def _fingerprints(keys_text: str) -> list[str]:
    """Empreintes SHA256 lisibles à partir d'une sortie ssh-keyscan/-F."""
    if not keys_text.strip():
        return []
    try:
        result = subprocess.run(
            [SSH_KEYGEN, "-lf", "-"], input=keys_text,
            capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return []
    prints = []
    for line in result.stdout.splitlines():
        parts = line.split()
        if len(parts) < 2:
            continue
        kind = line.rsplit("(", 1)[1].rstrip(")") if "(" in line else "clé"
        prints.append(f"{kind:<10} {parts[1]}")
    return prints


def host_key_info(host: dict) -> tuple[str, list[str], list[str], str]:
    """Empreintes de l'hôte : « known », « unknown », « changed » ou « unreachable ».

    `ssh-keyscan` ne s'authentifie pas et n'écrit rien : il annonce simplement
    les clés publiques de la machine. On les compare à `~/.ssh/known_hosts`
    pour distinguer un premier contact (à faire valider) d'une empreinte qui a
    CHANGÉ (possible attaque de l'homme du milieu : on refuse). Le texte brut
    est renvoyé pour pouvoir ÉPINGLER exactement les clés montrées à
    l'utilisateur, sans repasser par le réseau.
    """
    names = [host["host"]]
    if host["port"] != 22:
        names = [f'[{host["host"]}]:{host["port"]}']
    else:
        names.append(f'[{host["host"]}]:22')

    stored: list[str] = []
    for name in names:
        try:
            result = subprocess.run(
                [SSH_KEYGEN, "-F", name, "-f", str(KNOWN_HOSTS)],
                capture_output=True, text=True, timeout=10,
            )
        except (OSError, subprocess.TimeoutExpired):
            continue
        if result.returncode == 0:
            stored.extend(_fingerprints(result.stdout))
    stored = sorted(set(stored))

    raw = ""
    scanned: list[str] = []
    try:
        result = subprocess.run(
            [SSH_KEYSCAN, "-T", "5", "-p", str(host["port"]), host["host"]],
            capture_output=True, text=True, timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired):
        result = None
    if result is not None and result.returncode == 0:
        raw = "\n".join(
            line for line in result.stdout.splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        )
        scanned = sorted(set(_fingerprints(raw)))

    if stored and scanned:
        if set(stored) & set(scanned):
            return "known", scanned, stored, raw
        return "changed", scanned, stored, raw
    if stored:
        return "known", stored, stored, ""
    if scanned:
        return "unknown", scanned, stored, raw
    return "unreachable", [], stored, ""


def trust_host_key(raw_keys: str) -> bool:
    """Épingle dans known_hosts les lignes ssh-keyscan acceptées par l'utilisateur.

    On écrit les clés EXACTES qui ont été affichées (pas celles d'une nouvelle
    connexion) : si une autre clé se présente ensuite, ssh la refuse. C'est ce
    qui évite le `accept-new` silencieux et sa fenêtre d'attaque.
    """
    lines = [
        line.strip() for line in raw_keys.splitlines()
        if line.strip() and not line.lstrip().startswith("#")
    ]
    if not lines:
        return False
    try:
        SSH_DIR.mkdir(parents=True, exist_ok=True)
        os.chmod(SSH_DIR, 0o700)
        mode = "a" if KNOWN_HOSTS.exists() else "w"
        with open(KNOWN_HOSTS, mode, encoding="utf-8") as handle:
            if mode == "a" and KNOWN_HOSTS.stat().st_size:
                handle.write("\n")
            handle.write("\n".join(lines) + "\n")
        os.chmod(KNOWN_HOSTS, 0o600)
    except OSError:
        return False
    return True


def check_host(host: dict, stop: threading.Event) -> tuple[str, str, float, str]:
    """État d'un poste, sans bloquer la GUI.

    Retourne (état, détail, latence ms, MAC détectée). La latence est le temps
    du handshake SSH complet (connexion + authentification) : c'est la seule
    mesure sans ouvrir une connexion TCP supplémentaire à chaque vérification.
    """
    if not (PRIVATE_KEY.exists() and PUBLIC_KEY.exists()):
        return "nokey", "la clé locale sera créée à l'installation", 0.0, ""

    command = [
        SSH, *_ssh_opts(host),
        ssh_target(host), "true",
    ]
    started = time.monotonic()
    try:
        proc = subprocess.Popen(
            command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
        )
    except OSError as exc:
        return "error", f"ssh introuvable ({exc})", 0.0, ""

    deadline = time.monotonic() + CHECK_DEADLINE
    while proc.poll() is None:
        if stop.is_set():
            proc.kill()
            proc.wait()
            return "unknown", "", 0.0, ""
        if time.monotonic() > deadline:
            proc.kill()
            try:
                proc.communicate(timeout=2)
            except subprocess.TimeoutExpired:
                pass
            return "timeout", "délai dépassé", 0.0, ""
        time.sleep(0.08)

    try:
        _, err = proc.communicate(timeout=2)
    except subprocess.TimeoutExpired:
        proc.kill()
        _, err = proc.communicate()
    latency = (time.monotonic() - started) * 1000.0
    if proc.returncode == 0:
        mac = ""
        if not host.get("mac"):
            mac = detect_mac(host) or detect_mac_remote(host)
        return "online", "", latency, mac

    text = (err or "").strip()
    low = text.lower()
    if "host key verification failed" in low:
        return "hostkey", "empreinte inconnue ou changée", 0.0, ""
    if "permission denied" in low:
        return "auth", "clé refusée", 0.0, ""
    if "connection refused" in low:
        return "refused", "connexion refusée", 0.0, ""
    if "no route to host" in low:
        return "noroute", "réseau injoignable", 0.0, ""
    if "could not resolve" in low or "name or service not known" in low:
        return "dns", "nom introuvable", 0.0, ""
    if "timed out" in low or "timeout" in low:
        return "timeout", "délai dépassé", 0.0, ""
    first = text.splitlines()[0] if text else f"code {proc.returncode}"
    return "error", first, 0.0, ""


def _kill_group(proc: subprocess.Popen) -> None:
    try:
        os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
    except OSError:
        return
    try:
        proc.wait(timeout=3)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
        except OSError:
            pass


def _run_with_password(command: list[str], password: str,
                       log, cancel: threading.Event | None = None) -> tuple[int, str]:
    """Lance une commande interactive dans un pty et répond aux invites.

    ssh-copy-id demande le mot de passe sur le terminal : on lui donne un vrai
    pty (session + terminal de contrôle) et on écrit le secret dès qu'une invite
    « password: » apparaît. Mot de passe jamais dans argv, donc invisible dans ps.
    """
    master, slave = pty.openpty()

    def _attach_tty() -> None:
        os.setsid()
        try:
            fcntl.ioctl(0, termios.TIOCSCTTY, 0)
        except OSError:
            pass

    try:
        proc = subprocess.Popen(
            command, stdin=slave, stdout=slave, stderr=slave,
            preexec_fn=_attach_tty, close_fds=True,
            env={**os.environ, "TERM": "dumb"},
        )
    except OSError as exc:
        os.close(master)
        os.close(slave)
        return 127, f"{command[0]} introuvable ({exc})"
    os.close(slave)

    output = ""
    answered_at = -1
    deadline = time.monotonic() + 60
    try:
        while True:
            if cancel is not None and cancel.is_set():
                _kill_group(proc)
                output += "\n[annulé]\n"
                break
            if time.monotonic() > deadline:
                _kill_group(proc)
                output += "\n[délai dépassé]\n"
                break
            ready, _, _ = select.select([master], [], [], 0.2)
            if ready:
                try:
                    chunk = os.read(master, 4096)
                except OSError:
                    chunk = b""
                if not chunk:
                    break
                text = chunk.decode("utf-8", "replace")
                output += text
                log(text)
                tail = output[-8192:]
                matches = list(PASSWORD_RE.finditer(tail))
                if matches:
                    end = len(output) - len(tail) + matches[-1].end()
                    if end > answered_at:
                        os.write(master, (password + "\n").encode())
                        answered_at = end
            elif proc.poll() is not None:
                while True:
                    more, _, _ = select.select([master], [], [], 0)
                    if not more:
                        break
                    try:
                        chunk = os.read(master, 4096)
                    except OSError:
                        chunk = b""
                    if not chunk:
                        break
                    text = chunk.decode("utf-8", "replace")
                    output += text
                    log(text)
                break
    finally:
        try:
            os.close(master)
        except OSError:
            pass

    try:
        code = proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        _kill_group(proc)
        code = proc.returncode if proc.returncode is not None else 1
    return code, output


def install_key(host: dict, password: str, log, cancel=None,
                ask_trust=None) -> tuple[bool, str]:
    """Crée la clé si besoin, la copie avec ssh-copy-id, puis vérifie.

    `ask_trust(empreintes)` est appelé au premier contact : la GUI affiche les
    empreintes et attend l'accord de l'utilisateur. Une empreinte qui a CHANGÉ
    n'est jamais acceptée ici, même si l'appelant dirait oui : c'est le signe
    classique d'une attaque de l'homme du milieu.
    """
    ok, error = ensure_local_key()
    if not ok:
        return False, error
    log(f"Clé locale : {PRIVATE_KEY}\n")

    state, scanned, stored, raw = host_key_info(host)
    if state == "changed":
        log("Empreinte d'hôte DIFFÉRENTE de celle enregistrée.\n")
        log("  connue   : " + (", ".join(stored) or "?") + "\n")
        log("  annoncée : " + (", ".join(scanned) or "?") + "\n")
        return False, ("l'empreinte de l'hôte a changé — possible attaque ; "
                       "vérifiez la machine avant de continuer")
    if state == "unknown":
        log("Premier contact : empreintes annoncées par l'hôte\n")
        for item in scanned:
            log(f"  {item}\n")
        if ask_trust is None:
            return False, "empreinte d'hôte inconnue : acceptation explicite requise"
        if not ask_trust(scanned):
            return False, "empreinte refusée"
        if not trust_host_key(raw):
            return False, "impossible d'enregistrer l'empreinte dans ~/.ssh/known_hosts"
        log("Empreinte acceptée et enregistrée dans known_hosts.\n")
    elif state == "unreachable":
        log("Empreinte d'hôte indisponible (ssh-keyscan).\n")
        return False, ("empreinte d'hôte indisponible — poste injoignable, "
                       "réessayez dans un instant")

    ok, _ = probe_key(host)
    if ok:
        log("Cette clé est déjà acceptée par le poste.\n")
        return True, "clé déjà installée"

    if not password:
        return False, "mot de passe requis pour copier la clé"

    log(f"Copie de {PUBLIC_KEY.name} vers {address_text(host)}…\n")
    command = [
        SSH_COPY_ID,
        "-i", str(PUBLIC_KEY),
        "-p", str(host["port"]),
        "-o", "StrictHostKeyChecking=yes",
        "-o", "ConnectTimeout=10",
        "-o", "NumberOfPasswordPrompts=2",
        ssh_target(host),
    ]
    code, _ = _run_with_password(command, password, log, cancel)

    ok, detail = probe_key(host)
    if ok:
        return True, "clé installée, connexion sans mot de passe vérifiée"
    if detail:
        return False, f"la clé n'est pas acceptée après la copie ({detail})"
    return False, f"ssh-copy-id a échoué (code {code})"


# =============================================================================
# SECTION 3 : TRAVAILLEURS (threads)
# =============================================================================

class CheckWorker(QThread):
    """Vérifie tous les postes en parallèle, un signal par résultat."""

    result = Signal(str, str, str, float, str)   # id, état, détail, ms, MAC
    finished_all = Signal()

    def __init__(self, hosts: list[dict], parent=None):
        super().__init__(parent)
        self._hosts = [dict(host) for host in hosts]
        self._stop = threading.Event()

    def stop(self) -> None:
        self._stop.set()

    def run(self) -> None:
        if not self._hosts:
            self.finished_all.emit()
            return
        workers = max(1, min(6, len(self._hosts)))
        with ThreadPoolExecutor(max_workers=workers) as pool:
            futures = {
                pool.submit(check_host, host, self._stop): host["id"]
                for host in self._hosts
            }
            for future in as_completed(futures):
                host_id = futures[future]
                try:
                    state, detail, latency, mac = future.result()
                except Exception as exc:  # jamais laisser un poste sans état
                    state, detail, latency, mac = "error", str(exc), 0.0, ""
                if self._stop.is_set():
                    continue
                self.result.emit(host_id, state, detail, latency, mac)
        self.finished_all.emit()


class KeyInstallWorker(QThread):
    """Copie la clé dans un thread : la fenêtre reste réactive."""

    log = Signal(str)
    confirm_host_key = Signal(str, object)   # nom affiché, [empreintes]
    done = Signal(bool, str)

    def __init__(self, host: dict, password: str, parent=None):
        super().__init__(parent)
        self._host = dict(host)
        self._password = password
        self.cancel = threading.Event()
        self.trust_event = threading.Event()
        self.trust_answer = False

    def _ask_trust(self, fingerprints: list[str]) -> bool:
        """Pose la question dans la GUI puis attend sa réponse."""
        self.trust_answer = False
        self.trust_event.clear()
        self.confirm_host_key.emit(display_name(self._host), fingerprints)
        while not self.trust_event.wait(0.2):
            if self.cancel.is_set():
                return False
        return self.trust_answer

    def run(self) -> None:
        try:
            ok, message = install_key(
                self._host, self._password, self.log.emit, self.cancel,
                self._ask_trust,
            )
        except Exception as exc:
            ok, message = False, str(exc)
        finally:
            self._password = ""
        self.done.emit(ok, message)


class SshTaskWorker(QThread):
    """Exécute une commande distante en streaming (arrêt, redémarrage, mise à jour)."""

    log = Signal(str)
    done = Signal(int)

    def __init__(self, host: dict, command: str, parent=None,
                 password: str = ""):
        super().__init__(parent)
        self._host = dict(host)
        self._command = command
        # Mot de passe sudo éventuel : écrit sur stdin (jamais en argv, donc
        # invisible dans `ps`), utilisé une seule fois par `sudo -S -v`.
        self._password = password
        self.cancel = threading.Event()

    def run(self) -> None:
        argv = [
            SSH, *_ssh_opts(self._host), ssh_target(self._host), self._command,
        ]
        try:
            proc = subprocess.Popen(
                argv,
                stdin=subprocess.PIPE if self._password else subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT, start_new_session=True,
            )
        except OSError as exc:
            self.log.emit(f"ssh introuvable ({exc})\n")
            self.done.emit(127)
            return
        if self._password and proc.stdin is not None:
            try:
                proc.stdin.write((self._password + "\n").encode("utf-8"))
                proc.stdin.flush()
                proc.stdin.close()
            except OSError:
                pass
        assert proc.stdout is not None
        fd = proc.stdout.fileno()
        try:
            while True:
                if self.cancel.is_set():
                    _kill_group(proc)
                    self.log.emit("\n[annulé]\n")
                    break
                try:
                    ready, _, _ = select.select([fd], [], [], 0.2)
                except (OSError, ValueError):
                    break
                if ready:
                    try:
                        chunk = os.read(fd, 4096)
                    except OSError:
                        chunk = b""
                    if not chunk:
                        break
                    self.log.emit(chunk.decode("utf-8", "replace"))
                elif proc.poll() is not None:
                    break
        finally:
            proc.stdout.close()
        try:
            code = proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            _kill_group(proc)
            code = proc.returncode if proc.returncode is not None else 1
        self.done.emit(code)


