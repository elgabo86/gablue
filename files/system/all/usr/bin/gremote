#!/usr/bin/bash

# gremote — bureau Plasma distant d'un poste Gablue, par RDP tunnelisé en SSH
#
# Expose la session graphique de l'hôte (existante, ou créée virtuelle) dans une
# fenêtre du poste local : image et entrée par RDP, son par un tunnel PipeWire en
# SSH. Rien n'est exposé sur le réseau — RDP est derrière un -L local, l'audio
# derrière un -R, et le mot de passe RDP est tiré au hasard à chaque session.
#
# Si l'hôte n'a aucune session graphique pour ce compte, gremote en crée une
# VIRTUELLE (hors écran, sans VT ni DRM) : plusieurs comptes peuvent travailler
# en parallèle et l'écran physique n'est pas pris.
#
# Usage :
#   gremote utilisateur@hôte
#   gremote --no-start utilisateur@hôte    # échouer si aucune session
#
# Mode serveur (appelé par le client via SSH, ne pas lancer à la main) :
#   gremote --serve --rdp                  (mot de passe lu sur stdin)

set -euo pipefail

# =============================================================================
# SECTION 1 : VALEURS PAR DÉFAUT
# =============================================================================

TARGET=""
AUDIO=1               # 1 = tunnel des sockets Pulse/PipeWire locaux (défaut)
DEBUG=0               # 1 = journal côté hôte (filtré, plafonné)
DRY_RUN=0
SERVE=0
RDP=1                 # 1 = RDP (seul mode depuis le retrait de waypipe)
RDP_PORT=13389        # port LOCAL du -L ; le port distant dépend du compte
RDP_LAUNCH=1          # 1 = lancer xfreerdp automatiquement s'il est présent
NOSTART=0             # 1 = ne pas créer de session si l'hôte n'en a pas

# =============================================================================
# SECTION 2 : AIDE
# =============================================================================

usage() {
    cat <<'EOF'
gremote — bureau Plasma distant d'un poste Gablue (RDP tunnelisé en SSH)

Usage :
  gremote [options] utilisateur@hôte

Expose la session Plasma de l'hôte dans une fenêtre : image et entrée par RDP,
son par un tunnel PipeWire, le tout dans SSH. Aucun port n'est exposé sur le
réseau et le mot de passe RDP est éphémère. Si l'hôte n'a pas de session pour ce
compte, gremote en crée une VIRTUELLE (hors écran, sans VT ni DRM).

Options :
      --rdp-port N   port LOCAL du tunnel RDP (défaut : 13389)
      --no-launch    ne pas lancer xfreerdp (affiche la commande)
      --no-start     ne pas créer de session si l'hôte n'en a pas
      --audio        transférer le son par SSH (défaut)
      --no-audio     couper l'audio
      --debug        journal côté hôte (filtré, plafonné à 1 Mio)
  -n, --dry-run      afficher la commande sans l'exécuter
  -h, --help         cette aide

L'ancien mode waypipe (compositeur imbriqué, -a, -s, --video, --codec,
--quality, --bpf, --compress, --no-gpu, --clean) a été retiré le 02/11/2026.
EOF
}

# Port d'écoute propre au COMPTE, dérivé de son nom : deux utilisateurs peuvent
# avoir chacun leur session en même temps (chacun son ssh, son krdpserver sur la
# même machine) sans se disputer 127.0.0.1:3389. Le client calcule le même port à
# partir du nom de compte, donc aucune négociation et aucun tunnel à rouvrir.
rdp_remote_port() {
    local u="${1:-$USER}" h=0 i c
    for (( i = 0; i < ${#u}; i++ )); do
        c="${u:i:1}"
        h=$(( (h * 31 + $(printf '%d' "'$c")) % 200 ))
    done
    printf '%d\n' $(( 3400 + h ))
}

die() {
    printf 'gremote : %s\n' "$*" >&2
    exit 1
}

# =============================================================================
# SECTION 3 : ARGUMENTS
# =============================================================================

while [ $# -gt 0 ]; do
    case "$1" in
        --audio)
            AUDIO=1
            shift
            ;;
        --no-audio)
            AUDIO=0
            shift
            ;;
        --debug)
            DEBUG=1
            shift
            ;;
        -n|--dry-run)
            DRY_RUN=1
            shift
            ;;
        --serve)
            SERVE=1
            shift
            ;;
        --rdp)
            RDP=1
            shift
            ;;
        --rdp-port)
            [ $# -ge 2 ] || die "--rdp-port attend un numéro de port"
            RDP_PORT="$2"
            shift 2
            ;;
        --rdp-port=*)
            [ -n "${1#*=}" ] || die "--rdp-port attend un numéro de port"
            RDP_PORT="${1#*=}"
            shift
            ;;
        --no-launch)
            RDP_LAUNCH=0
            shift
            ;;
        --no-start)
            NOSTART=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            die "option inconnue : $1 (voir --help)"
            ;;
        *)
            [ -z "$TARGET" ] || die "cible déjà donnée : $TARGET"
            TARGET="$1"
            shift
            ;;
    esac
done

# =============================================================================
# SECTION 4 bis : MODE SERVEUR RDP (sur l'hôte, dans la session graphique)
# =============================================================================

if [ "$SERVE" -eq 1 ] && [ "$RDP" -eq 1 ]; then
    run_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

    # Le mot de passe arrive par stdin : absent d'argv, donc invisible dans ps.
    IFS= read -r rdp_pass || die "RDP : mot de passe manquant sur stdin"
    [ -n "$rdp_pass" ] || die "RDP : mot de passe vide"

    # Compositeur : on veut un KWin (il expose org_kde_plasma_shell), pas un
    # autre compositeur qui traînerait dans le même XDG_RUNTIME_DIR.
    compositor=""
    find_compositor() {
        compositor=""
        # Le socket de notre unité d'abord : un KWin en expose plusieurs
        # (`gremote-session` plus des wayland-N internes), et le glob ne voit
        # que les seconds — on choisissait donc un socket qui n'est pas celui
        # qu'on croit (vécu 02/11/2026).
        if [ -S "$run_dir/gremote-session" ]; then
            compositor="gremote-session"
            return 0
        fi
        if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$run_dir/$WAYLAND_DISPLAY" ]; then
            compositor="$WAYLAND_DISPLAY"
            return 0
        fi
        for sock in "$run_dir"/wayland-*; do
            [ -S "$sock" ] || continue
            if command -v wayland-info >/dev/null 2>&1; then
                # Capture puis comparaison : un `wayland-info | grep -q` ferme le
                # tube au premier succès, wayland-info prend SIGPIPE et `pipefail`
                # rendrait le test faux.
                globals="$(WAYLAND_DISPLAY="$(basename "$sock")" timeout 3 wayland-info 2>/dev/null || true)"
                case "$globals" in
                    *org_kde_plasma_shell*) ;;
                    *) continue ;;
                esac
            fi
            compositor="$(basename "$sock")"
            return 0
        done
        return 1
    }

    # Règle de choix du mode, sans exception : s'il existe DÉJÀ une session
    # graphique pour ce compte — locale (siège, DRM) ou distante — on s'y
    # attache ; sinon on en crée une VIRTUELLE (hors écran, sans VT ni DRM).
    # C'est ce qui permet de travailler à côté d'une session physique sans la
    # déranger, et de ne jamais avoir à en ouvrir une quand on ne travaille
    # qu'à distance. Conséquence : une session physique déjà ouverte sera
    # PARTAGÉE (l'écran du serveur montre la même chose que le client).
    if ! find_compositor; then
        # Personne n'est connecté : on crée la session au lieu d'échouer.
        # L'unité tourne sous CET utilisateur avec PAMName=login (vraie session
        # logind sur VT3) et la règle polkit 50-gremote-session.rules autorise
        # chacun à démarrer la sienne : ni mot de passe, ni sudo, ni NOPASSWD.
        if [ "${GREMOTE_NO_START:-0}" != 1 ] && command -v systemctl >/dev/null 2>&1; then
            # --no-block : `systemctl start` sans lui attend la fin de
            # l'ExecStartPost de l'unité (boucle de déverrouillage, jusqu'à 30 s)
            # alors que le compositeur est déjà prêt bien avant. On attend nous-
            # mêmes l'apparition du socket, ce qui est le seul critère utile.
            systemctl start --no-block "gremote-session@${USER}.service" 2>/dev/null || true
            for _ in $(seq 1 400); do
                find_compositor && break
                sleep 0.2
            done
            # Un démarrage refusé (compositeur résiduel, VT occupée…) laissait
            # gremote continuer sur une session morte : le client recevait du
            # noir sans explication. On s'arrête net avec le motif.
            if [ -z "$compositor" ]; then
                die "la session ${USER} n'a pas démarré : $(systemctl show "gremote-session@${USER}.service" -p Result --value 2>/dev/null). Détail : journalctl -u gremote-session@${USER}"
            fi
        fi
    fi
    [ -n "$compositor" ] ||
        die "aucune session graphique sur $run_dir, et gremote-session@${USER} n'a pas démarré (systemctl status gremote-session@${USER}, journalctl -u gremote-session@${USER})"

    export WAYLAND_DISPLAY="$compositor"
    export XDG_RUNTIME_DIR="$run_dir"
    export DBUS_SESSION_BUS_ADDRESS="unix:path=${run_dir}/bus"

    # Sans sortie (wl_output), KRdp diffuse du noir sans la moindre erreur.
    # Mieux vaut refuser que livrer une fenêtre noire qui laisse croire à un bug
    # du client.
    if command -v wayland-info >/dev/null 2>&1; then
        _globals="$(timeout 5 wayland-info 2>/dev/null || true)"
        case "$_globals" in
            *"interface: 'wl_output'"*) ;;
            *) die "le compositeur ${compositor} n'a aucune sortie (VT inactive ?) — corrige avec : systemctl restart gremote-session@${USER}" ;;
        esac
    fi
    # L'appelant a pu hériter d'un PULSE_SERVER : ici on veut le démon LOCAL,
    # sinon le puits tunnel se créerait sur le poste client.
    unset DISPLAY PULSE_SERVER PIPEWIRE_REMOTE

    # Certificat auto-signé : krdpserver refuse de démarrer sans, et l'erreur
    # part dans une logging category muette (d'où l'exit 255 silencieux).
    cert_dir="$HOME/.local/share/krdp"
    mkdir -p "$cert_dir"
    if [ ! -f "$cert_dir/cert.pem" ] || [ ! -f "$cert_dir/key.pem" ]; then
        command -v openssl >/dev/null 2>&1 ||
            die "openssl requis pour générer le certificat RDP"
        openssl req -x509 -newkey rsa:2048 -keyout "$cert_dir/key.pem" \
            -out "$cert_dir/cert.pem" -days 365 -nodes \
            -subj "/CN=$(hostname)" >/dev/null 2>&1 ||
            die "génération du certificat RDP impossible"
    fi

    # Son : le Socket Pulse local du client arrive par un -R. On crée un puits
    # qui pointe dessus et on le met par défaut : tout ce que joue la session
    # part chez le client, RDP ne transporte que l'image et l'entrée.
    audio_mod=""
    prev_sink=""
    cleanup_rdp() {
        [ -n "$audio_mod" ] && pactl unload-module "$audio_mod" >/dev/null 2>&1 || true
        [ -n "$prev_sink" ] && pactl set-default-sink "$prev_sink" >/dev/null 2>&1 || true
    }
    if [ -n "${GREMOTE_AUDIO_SOCK:-}" ] && [ -S "${GREMOTE_AUDIO_SOCK:-/nonexistent}" ] &&
        command -v pactl >/dev/null 2>&1; then
        prev_sink="$(pactl get-default-sink 2>/dev/null || true)"
        audio_mod="$(pactl load-module module-tunnel-sink \
            server="unix:$GREMOTE_AUDIO_SOCK" sink_name=gremote 2>/dev/null || true)"
        if [ -n "$audio_mod" ]; then
            # Le puits est enregistré de façon asynchrone : un set-default-sink
            # immédiat échoue en « Aucune entité de ce type » — et comme on
            # avale stderr, la session restait sans son (vécu 02/11/2026).
            sock_ok=0
            for _ in $(seq 1 40); do
                if pactl list short sinks 2>/dev/null |
                    awk -v n=gremote '$2 == n { found = 1 } END { exit !found }'; then
                    if pactl set-default-sink gremote >/dev/null 2>&1 &&
                        [ "$(pactl get-default-sink 2>/dev/null)" = gremote ]; then
                        sock_ok=1
                        break
                    fi
                fi
                sleep 0.25
            done
            [ "$sock_ok" -eq 1 ] ||
                printf 'gremote : le puits audio « gremote » n'"'"'a pas pu être mis par défaut\n' >&2
        else
            audio_mod=""
            printf 'gremote : puits audio tunnel indisponible, son local\n' >&2
        fi
    fi

    # Mode RDP. RemoteAccess fabrique un écran virtuel et bascule le siège sur le
    # greeter : parfait pour une session physique, mais sur la session que
    # gremote crée lui-même (VT3, souvent inactive) la création de ce moniteur
    # virtuel **échoue** et KRdp referme la connexion aussitôt — le client voit
    # « connection reset by peer » après l'authentification (vécu 02/11/2026).
    # SharedAccess capture la sortie réelle des fenêtres de session : c'est ce
    # qu'on veut ici, et il streame effectivement (VA-API actif pendant le test).
    # SharedAccess capture la sortie réelle du compositeur. RemoteAccess fabrique
    # un moniteur virtuel : sur une session hors écran il n'est jamais rempli et
    # le client reçoit du noir, voire un reset (mesuré 02/11/2026 : SharedAccess
    # encode, RemoteAccess non).
    rdp_mode=SharedAccess

    command -v krdpserver >/dev/null 2>&1 ||
        die "krdpserver absent sur l'hôte (paquet krdp)"

    rdp_listen_port="${GREMOTE_RDP_REMOTE_PORT:-$(rdp_remote_port "$(id -un)")}"

    # Un krdpserver survivant d'une connexion précédente garde son port : le
    # nouveau ne peut pas s'y lier, et le client se connecte à l'ANCIEN avec le
    # mot de passe neuf — d'où un ERRCONNECT_LOGON_FAILURE à la deuxième
    # connexion alors que tout semble normal (vécu 02/11/2026). On le remplace.
    for pid in $(pgrep -x -u "$(id -un)" krdpserver 2>/dev/null || true); do
        kill "$pid" 2>/dev/null || true
    done

    for _ in $(seq 1 50); do
        (exec 3<>/dev/tcp/127.0.0.1/"$rdp_listen_port") 2>/dev/null || break
        sleep 0.1
    done

    krdpserver --address 127.0.0.1 --port "$rdp_listen_port" \
        --username "${GREMOTE_RDP_USER:-$USER}" --password "$rdp_pass" \
        --mode "$rdp_mode" --plasma \
        --certificate "$cert_dir/cert.pem" \
        --certificate-key "$cert_dir/key.pem" &
    srv_pid=$!
    trap 'kill "$srv_pid" 2>/dev/null || true; cleanup_rdp' EXIT INT TERM

    # Poignée de main : le client attend cette ligne avant de lancer son client
    # RDP. Un test de port côté client ne prouve RIEN : un -L ssh accepte la
    # connexion TCP puis échoue en « channel 2: open failed: Connection refused »
    # quand le distant n'écoute pas encore (vécu 02/11/2026).
    up=0
    for _ in $(seq 1 150); do
        if (exec 3<>/dev/tcp/127.0.0.1/"$rdp_listen_port") 2>/dev/null; then
            up=1
            break
        fi
        kill -0 "$srv_pid" 2>/dev/null || break
        sleep 0.2
    done
    [ "$up" -eq 1 ] ||
        die "krdpserver n'écoute pas sur 127.0.0.1:${rdp_listen_port} (port déjà pris par un autre service ?)"
    printf 'GREMOTE-RDP-READY %s\n' "$rdp_listen_port"
    wait "$srv_pid"
    exit 0
fi

# =============================================================================
# SECTION 5 : MODE CLIENT — VÉRIFICATIONS LOCALES
# =============================================================================

[ -n "$TARGET" ] || { usage; exit 1; }

command -v ssh >/dev/null 2>&1 || die "ssh absent sur ce poste"

# =============================================================================
# SECTION 7 : MODE CLIENT — LANCEMENT
# =============================================================================

# Audio : KRdp ne transporte pas le son. On transfère donc par SSH les sockets
# PipeWire/Pulse de CE poste vers l'hôte : les applications distantes jouent
# directement sur les haut-parleurs d'ici, sans port ouvert ni service en plus.
# Deux -R : Pulse (cas normal, pipewire-pulse) et PipeWire natif (clients qui
# parlent le protocole natif). Condition côté sshd distant :
# AllowStreamLocalForwarding.
# Le chemin local des sockets n'existe pas sur l'hôte : on transfère vers un
# socket neuf sous /tmp, dont le nom porte l'uid et le PID du client.
ssh_args=()
audio_env=()
[ "$DEBUG" -eq 1 ] && audio_env+=("GREMOTE_DEBUG=1")
if [ "$AUDIO" -eq 1 ]; then
    run_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    if [ -S "$run_dir/pulse/native" ]; then
        # Nom unique (uid + PID) : sshd laisse le socket en place à la
        # déconnexion, et refuse de réécouter sur un chemin existant — « remote
        # port forwarding failed », donc plus de son à la 2e session avec un
        # chemin fixe (vécu 01/11/2026). L'option -o StreamLocalBindUnlink ne
        # règle rien ici : pour un -R c'est le sshd distant qui décide.
        pulse_sock="/tmp/gremote-pulse-$(id -u)-$$.sock"
        ssh_args+=(-R "${pulse_sock}:${run_dir}/pulse/native")
        audio_env+=("PULSE_SERVER=unix:${pulse_sock}")
        if [ -S "$run_dir/pipewire-0" ]; then
            pw_sock="/tmp/gremote-pw-$(id -u)-$$.sock"
            ssh_args+=(-R "${pw_sock}:${run_dir}/pipewire-0")
            audio_env+=("PIPEWIRE_REMOTE=${pw_sock}")
        fi
    else
        printf 'gremote : aucun PipeWire local (%s/pulse/native), audio désactivé\n' \
            "$run_dir" >&2
    fi
fi

# ---------------------------------------------------------------------------
# Mode RDP : tout passe par SSH. Le -L n'expose RDP que sur 127.0.0.1 du poste
# local, le -R porte le son du poste vers l'hôte, et le mot de passe RDP est
# tiré au hasard à chaque session puis jeté. Aucun port ouvert sur le réseau.
# ---------------------------------------------------------------------------
if [ "$RDP" -eq 1 ]; then
    rdp_user="${TARGET%%@*}"
    rdp_pass="$(head -c 200 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | cut -c1-20)"
    [ -n "$rdp_pass" ] || die "génération du mot de passe RDP impossible"

    rdp_remote_port_num="$(rdp_remote_port "$rdp_user")"
    ssh_args+=(-o ExitOnForwardFailure=yes -L "127.0.0.1:${RDP_PORT}:127.0.0.1:${rdp_remote_port_num}")
    remote_cmd=(env "GREMOTE_AUDIO_SOCK=${pulse_sock:-}" "GREMOTE_RDP_USER=${rdp_user}")
    if [ "$NOSTART" -eq 1 ]; then
        remote_cmd+=("GREMOTE_NO_START=1")
    fi
    remote_cmd+=(gremote --serve --rdp)

    if [ "$DRY_RUN" -eq 1 ]; then
        printf 'ssh'
        for arg in ${ssh_args[@]+"${ssh_args[@]}"}; do printf ' %s' "$arg"; done
        printf ' %s' "$TARGET"
        for arg in "${remote_cmd[@]}"; do printf ' %s' "$arg"; done
        printf '   (mot de passe RDP sur stdin)\n'
        exit 0
    fi

    # La sortie du ssh sert de canal de contrôle : le serveur y écrit
    # GREMOTE-RDP-READY quand krdpserver écoute vraiment (le certificat est
    # créé au premier lancement, ça prend une à deux secondes).
    rdp_log="$(mktemp "${TMPDIR:-/tmp}/gremote-rdp.XXXXXX")"
    printf '%s\n' "$rdp_pass" |
        ssh ${ssh_args[@]+"${ssh_args[@]}"} "$TARGET" "${remote_cmd[@]}" >"$rdp_log" 2>&1 &
    ssh_pid=$!
    trap 'kill "$ssh_pid" 2>/dev/null || true; rm -f "$rdp_log"' EXIT INT TERM

    ready=0
    for _ in $(seq 1 300); do
        if grep -q '^GREMOTE-RDP-READY' "$rdp_log" 2>/dev/null; then
            ready=1
            break
        fi
        kill -0 "$ssh_pid" 2>/dev/null || break
        sleep 0.2
    done
    if [ "$ready" -ne 1 ]; then
        sed -n '1,12p' "$rdp_log" >&2 2>/dev/null || true
        die "le serveur RDP de $TARGET n'a pas démarré (voir ci-dessus)"
    fi

    if [ "$RDP_LAUNCH" -eq 1 ] && command -v xfreerdp >/dev/null 2>&1; then
        printf 'gremote : RDP tunnelisé sur 127.0.0.1:%s (utilisateur %s)\n' \
            "$RDP_PORT" "$rdp_user"
        # Pas de /network:<type> explicite : TOUT type explicite (lan, wan,
        # broadband, modem) fait cesser le client d'annoncer le pipeline
        # graphique exigé par KRdp, qui répond alors par un DEACTIVATE_ALL
        # immédiat — mesuré 02/11/2026 : explicit = rc 147, défaut = connecté.
        # Le profil est donc laissé en autodétection.
        xfreerdp /v:127.0.0.1:"$RDP_PORT" /u:"$rdp_user" /p:"$rdp_pass" \
            /cert:ignore +clipboard /dynamic-resolution
    else
        printf 'gremote : connecte-toi avec\n  xfreerdp /v:127.0.0.1:%s /u:%s /p:%s /cert:ignore\n' \
            "$RDP_PORT" "$rdp_user" "$rdp_pass"
        wait "$ssh_pid"
    fi
    exit 0
fi
