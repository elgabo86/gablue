#!/usr/bin/bash

# gremote — bureau Plasma distant d'un poste Gablue, par RDP tunnelisé en SSH
#
# Expose la session graphique de l'hôte (existante, ou créée virtuelle) dans une
# fenêtre du poste local : image et entrée par RDP, son par un tunnel PipeWire en
# SSH (sur sa propre connexion, pour ne pas subir les rafales vidéo). Rien n'est
# exposé sur le réseau — RDP est derrière un -L local, l'audio derrière un -R,
# et le mot de passe RDP est tiré au hasard à chaque session.
#
# Si l'hôte n'a aucune session graphique pour ce compte, gremote en crée une
# VIRTUELLE (hors écran, sans VT ni DRM) : plusieurs comptes peuvent travailler
# en parallèle et l'écran physique n'est pas pris.
#
# Usage :
#   gremote utilisateur@hôte
#   gremote --no-start utilisateur@hôte    # échouer si aucune session
#
# Mode serveur (appelé par le client via SSH, ne pas lancer à la main) :
#   gremote --serve --rdp                  (mot de passe lu sur stdin)

set -euo pipefail

# =============================================================================
# SECTION 1 : VALEURS PAR DÉFAUT
# =============================================================================

TARGET=""
AUDIO=1               # 1 = tunnel des sockets Pulse/PipeWire locaux (défaut)
# Tampon du puits tunnel audio. `latency_msec` est bien pris par PipeWire
# (module-protocol-pulse, `latency_msec=<fixed latency in ms>`), mais PAS au
# sens littéral : mesuré 13/11/2026 sur PipeWire 1.6.11, `node.latency` vaut
# valeur × 6 échantillons (soit /8 en ms) et plafonne à 8192 échantillons
# (`default.clock.quantum-limit`), donc ~171 ms à 48 kHz. 1500 sature le
# plafond ; au-delà aucun effet. Quirk de version : revérifier avant de s'y fier.
AUDIO_LATENCY_MSEC="${GREMOTE_AUDIO_LATENCY:-1500}"
DEBUG=0               # 1 = journal côté hôte (filtré, plafonné)
DRY_RUN=0
SERVE=0
RDP=1                 # 1 = RDP (seul mode depuis le retrait de waypipe)
RDP_PORT=13389        # port LOCAL du -L ; le port distant dépend du compte
RDP_PORT_SET=0        # 1 si --rdp-port a été donné (sinon : premier libre)
SSH_PORT=""           # port SSH (défaut : ~/.ssh/config, sinon 22)
SSH_PORT_SET=0        # 1 si -p/--port ou « hôte:port » a fixé le port
RDP_LAUNCH=1          # 1 = lancer sdl-freerdp automatiquement s'il est présent
NOSTART=0             # 1 = ne pas créer de session si l'hôte n'en a pas
QUALITY=75            # qualité d'encodage KRdp (0-100) ; sert de borne en adaptatif
# Mode de qualité : « auto » (défaut) = adaptatif sur une session PHYSIQUE,
# épinglé sur une VIRTUELLE. Le choix est fait par le SERVEUR, seul à connaître
# le type de session : un bureau réel en 1440p ne tient pas à qualité fixe, un
# bureau virtuel suit la fenêtre et une image qui varie s'y voit (constaté
# 04/11/2026). --adaptive / --static-quality forcent l'un ou l'autre.
QUALITY_MODE="auto"

# =============================================================================
# SECTION 2 : AIDE
# =============================================================================

usage() {
    cat <<'EOF'
gremote — bureau Plasma distant d'un poste Gablue (RDP tunnelisé en SSH)

Usage :
  gremote [options] utilisateur@hôte[:port]

Expose la session Plasma de l'hôte dans une fenêtre : image et entrée par RDP,
son par un tunnel PipeWire, le tout dans SSH. Aucun port n'est exposé sur le
réseau et le mot de passe RDP est éphémère. Si l'hôte n'a pas de session pour ce
compte, gremote en crée une VIRTUELLE (hors écran, sans VT ni DRM).

Options :
  -p, --port N   port SSH de l'hôte (défaut : ~/.ssh/config, sinon 22)
      --rdp-port N   port LOCAL du tunnel RDP (défaut : 13389)
      --no-launch    ne pas lancer le client RDP (affiche la commande)
      --no-start     ne pas créer de session si l'hôte n'en a pas
      --quality N    qualité d'encodage 0-100, borne haute en adaptatif (défaut : 75)
      --adaptive     laisser KRdp baisser la qualité selon le débit (défaut sur
                     une session PHYSIQUE)
      --static-quality  épingler la qualité (défaut sur une session VIRTUELLE)
      --audio        transférer le son par SSH (défaut), sur une connexion
                     dédiée : une rafale vidéo ne le bloque plus derrière elle
      --no-audio     couper l'audio — le son du poste distant reste sur SES
                     haut-parleurs (aucun puits tunnel n'est créé)
      --debug        journal côté hôte (filtré, plafonné à 1 Mio)
  -n, --dry-run      afficher la commande sans l'exécuter
  -h, --help         cette aide

Client RDP : sdl-freerdp (SDL3, Wayland natif), quelle que soit la session. Une
session VIRTUELLE (créée hors écran par gremote) suit la fenêtre
(+dynamic-resolution) : rien de physique n'est redimensionné, l'image reste
nette. Une session PHYSIQUE (bureau réel déjà ouvert) ne peut pas changer de
résolution — ce serait l'écran du poste — donc l'image est affichée à sa
résolution réelle, sans mise à l'échelle : une fenêtre de la taille de l'écran
distant. Le type est annoncé par l'hôte, qui reconnaît sa session hors écran à
sa sortie virtuelle (« Virtual-0 ») ; un hôte d'une image antérieure ne
l'annonce pas : gremote le lui demande alors sur une seconde connexion SSH
(socket `gremote-session` = virtuelle, sinon physique) ; sans réponse, physique.

L'ancien mode waypipe (compositeur imbriqué, -a, -s, --video, --codec,
--quality, --bpf, --compress, --no-gpu, --clean) a été retiré le 02/11/2026.
EOF
}

# Port d'écoute propre au COMPTE, dérivé de son nom : deux utilisateurs peuvent
# avoir chacun leur session en même temps (chacun son ssh, son krdpserver sur la
# même machine) sans se disputer 127.0.0.1:3389. Le client calcule le même port à
# partir du nom de compte, donc aucune négociation et aucun tunnel à rouvrir.
rdp_remote_port() {
    local u="${1:-$USER}" h=0 i c
    for (( i = 0; i < ${#u}; i++ )); do
        c="${u:i:1}"
        h=$(( (h * 31 + $(printf '%d' "'$c")) % 200 ))
    done
    printf '%d\n' $(( 3400 + h ))
}

die() {
    printf 'gremote : %s\n' "$*" >&2
    exit 1
}

# Noms des sorties (wl_output) de la sortie de `wayland-info`, une par ligne.
# Le backend VIRTUEL de KWin nomme ses sorties « Virtual-0 », « Virtual-1 »… :
# c'est le seul marqueur de session hors écran qui reste depuis que le
# compositeur est lancé par son unité utilisateur (le socket s'appelle alors
# `wayland-N`, plus le `gremote-session` de l'ancienne conception, et le nom du
# socket ne dit donc plus rien du type de session). Constaté sur kwin 6.8.2 le
# 13/11/2026 — revérifier à chaque montée de version de KWin.
output_names() {
    local line inout=0
    while IFS= read -r line; do
        case "$line" in
            "interface: "*)
                if [[ "$line" == *"'wl_output'"* ]]; then
                    inout=1
                else
                    inout=0
                fi
                continue
                ;;
        esac
        [ "$inout" -eq 1 ] || continue
        if [[ "$line" =~ ^[[:space:]]*name:\ (.+)$ ]]; then
            printf '%s\n' "${BASH_REMATCH[1]}"
        fi
    done
}

# =============================================================================
# SECTION 3 : ARGUMENTS
# =============================================================================

while [ $# -gt 0 ]; do
    case "$1" in
        --audio)
            AUDIO=1
            shift
            ;;
        --no-audio)
            AUDIO=0
            shift
            ;;
        --debug)
            DEBUG=1
            shift
            ;;
        -n|--dry-run)
            DRY_RUN=1
            shift
            ;;
        --serve)
            SERVE=1
            shift
            ;;
        --rdp)
            RDP=1
            shift
            ;;
        -p|--port)
            [ $# -ge 2 ] || die "--port attend un numéro de port"
            [ "$SSH_PORT_SET" -eq 0 ] || die "port SSH déjà donné"
            SSH_PORT="$2"
            SSH_PORT_SET=1
            shift 2
            ;;
        --port=*)
            [ -n "${1#*=}" ] || die "--port attend un numéro de port"
            [ "$SSH_PORT_SET" -eq 0 ] || die "port SSH déjà donné"
            SSH_PORT="${1#*=}"
            SSH_PORT_SET=1
            shift
            ;;
        --rdp-port)
            [ $# -ge 2 ] || die "--rdp-port attend un numéro de port"
            RDP_PORT="$2"
            RDP_PORT_SET=1
            shift 2
            ;;
        --rdp-port=*)
            [ -n "${1#*=}" ] || die "--rdp-port attend un numéro de port"
            RDP_PORT="${1#*=}"
            RDP_PORT_SET=1
            shift
            ;;
        --no-launch)
            RDP_LAUNCH=0
            shift
            ;;
        --quality)
            [ $# -ge 2 ] || die "--quality attend une valeur (0-100)"
            QUALITY="$2"
            shift 2
            ;;
        --quality=*)
            [ -n "${1#*=}" ] || die "--quality attend une valeur (0-100)"
            QUALITY="${1#*=}"
            shift
            ;;
        --adaptive)
            QUALITY_MODE="adaptive"
            shift
            ;;
        --static-quality)
            QUALITY_MODE="static"
            shift
            ;;
        --no-start)
            NOSTART=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            die "option inconnue : $1 (voir --help)"
            ;;
        *)
            [ -z "$TARGET" ] || die "cible déjà donnée : $TARGET"
            TARGET="$1"
            shift
            ;;
    esac
done

# Port dans la cible : « [user@]hôte[:port] », comme ssh-key-add. Une IPv6 nue
# contient plusieurs « : » et ne peut donc pas être confondue avec un suffixe
# de port ; une IPv6 avec port s'écrit entre crochets ([adresse]:port).
if [ -n "$TARGET" ]; then
    userpart=""
    rest="$TARGET"
    if [[ "$rest" == *@* ]]; then
        userpart="${rest%@*}@"
        rest="${rest##*@}"
    fi
    addr_port=""
    if [[ "$rest" =~ ^\[([^]]+)\](:([0-9]+))?$ ]]; then
        hostpart="${BASH_REMATCH[1]}"
        addr_port="${BASH_REMATCH[3]}"
    elif [[ "$rest" =~ ^([^:]+):([0-9]+)$ ]]; then
        hostpart="${BASH_REMATCH[1]}"
        addr_port="${BASH_REMATCH[2]}"
    else
        hostpart="$rest"
    fi
    if [ -n "$addr_port" ]; then
        [ "$SSH_PORT_SET" -eq 0 ] ||
            die "port SSH fourni deux fois (-p et « $TARGET »)"
        SSH_PORT="$addr_port"
        SSH_PORT_SET=1
    fi
    TARGET="${userpart}${hostpart}"
fi

if [ -n "$SSH_PORT" ]; then
    [[ "$SSH_PORT" =~ ^[0-9]+$ ]] || die "port SSH invalide : « $SSH_PORT »"
    [ "$SSH_PORT" -ge 1 ] && [ "$SSH_PORT" -le 65535 ] ||
        die "port SSH hors plage (1-65535) : $SSH_PORT"
fi

# Qualité d'encodage, construite ICI (et pas dans la section serveur) : le client
# doit la TRANSMETTRE à la commande distante, sinon --quality/--adaptive sont
# parsés puis ignorés et le serveur garde ses valeurs par défaut (constaté
# 04/11/2026 : « --adaptive --quality 100 » lançait un krdpserver en 60 épinglé).
# Mode « auto » (défaut) : on n'ajoute AUCUN drapeau à la ligne distante, c'est
# le serveur qui tranche — seul à connaître le type de session AVANT de lancer
# krdpserver. Adaptatif par défaut sur une session physique (un bureau réel en
# 1440p ne tient pas à qualité épinglée sur un lien modeste), épinglé sur une
# virtuelle (image stable ; rien à adapter puisque la résolution suit la
# fenêtre). Un hôte d'une image antérieure garde son défaut (épinglé), sans
# dégât : il ignore simplement qu'on aurait préféré l'adaptatif.
# Courbe de kpipewire en encodage MATÉRIEL :
#   global_quality (QP) = 87 − 0,87 × qualité  →  100 → QP 1, 90 → QP ≈ 9,
#   75 (défaut) → QP ≈ 22, 60 → QP ≈ 35 (mou sur du texte), 10 → QP ≈ 78.
#   En logiciel libx264 ignore cet indice et garde son CRF.
# Deux vocabulaires, à ne pas confondre : `rdp_quality_args` part tel quel dans
# la ligne de `krdpserver` (--adaptive-quality), `rdp_remote_quality_args` part
# vers `gremote --serve` (--adaptive). Envoyer le premier au second échouait sur
# « option inconnue : --adaptive-quality » (vécu 04/11/2026).
rdp_quality_args=()
rdp_remote_quality_args=()
if [ -n "$QUALITY" ]; then
    rdp_remote_quality_args+=(--quality "$QUALITY")
fi
case "$QUALITY_MODE" in
    adaptive) rdp_remote_quality_args+=(--adaptive) ;;
    static) rdp_remote_quality_args+=(--static-quality) ;;
esac

# =============================================================================
# SECTION 4 bis : MODE SERVEUR RDP (sur l'hôte, dans la session graphique)
# =============================================================================

if [ "$SERVE" -eq 1 ] && [ "$RDP" -eq 1 ]; then
    run_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

    # Le mot de passe arrive par stdin : absent d'argv, donc invisible dans ps.
    IFS= read -r rdp_pass || die "RDP : mot de passe manquant sur stdin"
    [ -n "$rdp_pass" ] || die "RDP : mot de passe vide"

    # Compositeur : on veut un KWin (il expose org_kde_plasma_shell), pas un
    # autre compositeur qui traînerait dans le même XDG_RUNTIME_DIR.
    compositor=""
    find_compositor() {
        compositor=""
        # Socket de l'ancienne conception (gremote lançait lui-même le
        # compositeur avec ce nom) : gardé en tête au cas où il existerait
        # encore. Depuis Plasma 6.8 le compositeur est lancé par son unité
        # utilisateur et `kwin_wayland_wrapper` lui impose `wayland-N` : le type
        # de session ne se déduit donc plus du nom du socket (voir plus bas).
        if [ -S "$run_dir/gremote-session" ]; then
            compositor="gremote-session"
            return 0
        fi
        if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$run_dir/$WAYLAND_DISPLAY" ]; then
            compositor="$WAYLAND_DISPLAY"
            return 0
        fi
        for sock in "$run_dir"/wayland-*; do
            [ -S "$sock" ] || continue
            if command -v wayland-info >/dev/null 2>&1; then
                # Capture puis comparaison : un `wayland-info | grep -q` ferme le
                # tube au premier succès, wayland-info prend SIGPIPE et `pipefail`
                # rendrait le test faux.
                globals="$(WAYLAND_DISPLAY="$(basename "$sock")" timeout 3 wayland-info 2>/dev/null || true)"
                case "$globals" in
                    *org_kde_plasma_shell*) ;;
                    *) continue ;;
                esac
            fi
            compositor="$(basename "$sock")"
            return 0
        done
        return 1
    }

    # Règle de choix du mode, sans exception : s'il existe DÉJÀ une session
    # graphique pour ce compte — locale (siège, DRM) ou distante — on s'y
    # attache ; sinon on en crée une VIRTUELLE (hors écran, sans VT ni DRM).
    # C'est ce qui permet de travailler à côté d'une session physique sans la
    # déranger, et de ne jamais avoir à en ouvrir une quand on ne travaille
    # qu'à distance. Conséquence : une session physique déjà ouverte sera
    # PARTAGÉE (l'écran du serveur montre la même chose que le client).
    if ! find_compositor; then
        # Personne n'est connecté : on crée la session au lieu d'échouer.
        # L'unité tourne sous CET utilisateur avec PAMName=login (vraie session
        # logind sur VT3) et la règle polkit 50-gremote-session.rules autorise
        # chacun à démarrer la sienne : ni mot de passe, ni sudo, ni NOPASSWD.
        if [ "${GREMOTE_NO_START:-0}" != 1 ] && command -v systemctl >/dev/null 2>&1; then
            # --no-block : `systemctl start` sans lui attend la fin de
            # l'ExecStartPost de l'unité (boucle de déverrouillage, jusqu'à 30 s)
            # alors que le compositeur est déjà prêt bien avant. On attend nous-
            # mêmes l'apparition du socket, ce qui est le seul critère utile.
            systemctl start --no-block "gremote-session@${USER}.service" 2>/dev/null || true
            for _ in $(seq 1 400); do
                find_compositor && break
                sleep 0.2
            done
            # Un démarrage refusé (compositeur résiduel, VT occupée…) laissait
            # gremote continuer sur une session morte : le client recevait du
            # noir sans explication. On s'arrête net avec le motif.
            if [ -z "$compositor" ]; then
                die "la session ${USER} n'a pas démarré : $(systemctl show "gremote-session@${USER}.service" -p Result --value 2>/dev/null). Détail : journalctl -u gremote-session@${USER}"
            fi
        fi
    fi
    [ -n "$compositor" ] ||
        die "aucune session graphique sur $run_dir, et gremote-session@${USER} n'a pas démarré (systemctl status gremote-session@${USER}, journalctl -u gremote-session@${USER})"

    export WAYLAND_DISPLAY="$compositor"
    export XDG_RUNTIME_DIR="$run_dir"
    export DBUS_SESSION_BUS_ADDRESS="unix:path=${run_dir}/bus"

    # Sans sortie (wl_output), KRdp diffuse du noir sans la moindre erreur.
    # Mieux vaut refuser que livrer une fenêtre noire qui laisse croire à un bug
    # du client.
    virtual_output=0
    if command -v wayland-info >/dev/null 2>&1; then
        _globals="$(timeout 5 wayland-info 2>/dev/null || true)"
        case "$_globals" in
            *"interface: 'wl_output'"*) ;;
            *) die "le compositeur ${compositor} n'a aucune sortie (VT inactive ?) — corrige avec : systemctl restart gremote-session@${USER}" ;;
        esac
        # Sortie « Virtual-N » = backend virtuel de KWin (voir output_names).
        _names="$(printf '%s\n' "$_globals" | output_names || true)"
        while IFS= read -r _name; do
            case "$_name" in
                Virtual*) virtual_output=1 ;;
            esac
        done <<<"$_names"
    fi

    # Type de session, transmis au client dans la ligne de poignée de main.
    # VIRTUELLE = celle que notre unité crée hors écran : la seule dont la
    # sortie est celle du backend virtuel de KWin. On ne teste plus le nom du
    # socket : depuis Plasma 6.8 le compositeur est lancé par son unité
    # utilisateur, `kwin_wayland_wrapper` lui impose `wayland-N`, et le socket
    # `gremote-session` de l'ancienne conception n'existe donc plus — toute
    # session virtuelle était annoncée PHYSIQUE (constaté 13/11/2026 : fenêtre
    # figée à la résolution du moniteur virtuel et qualité adaptative au lieu du
    # suivi de fenêtre). Le nom `gremote-session` reste accepté pour un hôte
    # d'une image antérieure.
    # La distinction commande les options du client RDP : une session physique ne
    # peut pas changer de résolution (ce serait le moniteur du poste), une
    # session virtuelle suit la fenêtre (+dynamic-resolution).
    if [ "$compositor" = "gremote-session" ] || [ "$virtual_output" -eq 1 ]; then
        session_kind=virtual
    else
        session_kind=physical
    fi

    # Qualité d'encodage pour krdpserver. C'est ICI que « auto » se tranche : le
    # serveur est le seul à connaître le type de session avant de démarrer RDP.
    # Qualité par défaut (75) = borne haute en adaptatif ; adaptive-quality est
    # le défaut de krdpserver mais on l'écrit, une configuration du poste peut
    # l'avoir coupé.
    rdp_quality_args=()
    if [ -n "$QUALITY" ]; then
        rdp_quality_args+=(--quality "$QUALITY")
    fi
    if [ "$QUALITY_MODE" = "adaptive" ] ||
        { [ "$QUALITY_MODE" = "auto" ] && [ "$session_kind" = "physical" ]; }; then
        rdp_quality_args+=(--adaptive-quality)
    else
        rdp_quality_args+=(--static-quality)
    fi
    # L'appelant a pu hériter d'un PULSE_SERVER : ici on veut le démon LOCAL,
    # sinon le puits tunnel se créerait sur le poste client.
    unset DISPLAY PULSE_SERVER PIPEWIRE_REMOTE

    # Certificat auto-signé : krdpserver refuse de démarrer sans, et l'erreur
    # part dans une logging category muette (d'où l'exit 255 silencieux).
    cert_dir="$HOME/.local/share/krdp"
    mkdir -p "$cert_dir"
    if [ ! -f "$cert_dir/cert.pem" ] || [ ! -f "$cert_dir/key.pem" ]; then
        command -v openssl >/dev/null 2>&1 ||
            die "openssl requis pour générer le certificat RDP"
        openssl req -x509 -newkey rsa:2048 -keyout "$cert_dir/key.pem" \
            -out "$cert_dir/cert.pem" -days 365 -nodes \
            -subj "/CN=$(hostname)" >/dev/null 2>&1 ||
            die "génération du certificat RDP impossible"
    fi

    # Son : le Socket Pulse local du client arrive par un -R. On crée un puits
    # qui pointe dessus et on le met par défaut : tout ce que joue la session
    # part chez le client, RDP ne transporte que l'image et l'entrée.
    audio_mod=""
    prev_sink=""
    # Nom de puits PROPRE à cette connexion. Avec un nom fixe (« gremote »), la
    # reconnexion sur une session déjà ouverte n'avait plus de son : l'ancien
    # serveur restait vivant avec son puits par défaut, et son nettoyage
    # (déclenché quand le nouveau serveur tue son krdpserver) remettait le puits
    # LOCAL par défaut — juste après que la nouvelle connexion avait fait le
    # sien. Deux connexions se disputaient donc le même nom et le même défaut
    # (vécu 02/11/2026 : fermer la fenêtre puis se reconnecter = silence).
    sink_name="gremote-$$"
    # Puits tunnel orphelins d'une session précédente : leur socket a disparu
    # avec le -R du client, et s'ils restent par défaut tout le son de la
    # session part dans le vide. Nettoyage INCONDITIONNEL (même sans audio
    # demandé) : c'est ce qui rend le son au poste quand on se connecte en
    # « sans son » (--no-audio) — le puits de la session d'avant ne doit pas
    # rester le défaut, sinon le poste distant serait muet.
    drop_stale_tunnels() {
        pactl list short modules 2>/dev/null |
            awk '$2 == "module-tunnel-sink" && $0 ~ /sink_name=gremote/ { print $1 }' |
            while read -r _m; do pactl unload-module "$_m" >/dev/null 2>&1 || true; done
    }
    # Après le retrait, le défaut peut désigner un puits disparu (silence) :
    # on reprend le premier puits LOCAL, jamais un gremote-* (celui d'un pair).
    ensure_local_sink() {
        local cur local_sink
        cur="$(pactl get-default-sink 2>/dev/null || true)"
        case "$cur" in
            ""|gremote-*) ;;
            *)
                pactl list short sinks 2>/dev/null |
                    awk -v n="$cur" '$2 == n { found = 1 } END { exit !found }' &&
                    return 0
                ;;
        esac
        local_sink="$(pactl list short sinks 2>/dev/null |
            awk '$2 !~ /^gremote-/ { print $2; exit }')"
        [ -n "$local_sink" ] &&
            pactl set-default-sink "$local_sink" >/dev/null 2>&1 || true
    }
    cleanup_rdp() {
        # Ne décharger que si cet identifiant désigne ENCORE notre puits : PipeWire
        # réattribue les identifiants de module (536870916 observé deux fois), donc
        # un `unload-module` tardif supprimait le puits d'une connexion PLUS RÉCENTE
        # — le son disparaissait à chaque reprise de session (vécu 03/11/2026).
        if [ -n "$audio_mod" ] &&
            pactl list short modules 2>/dev/null |
                awk -v id="$audio_mod" -v n="$sink_name" \
                    '$1 == id && $0 ~ ("sink_name=" n) { found = 1 } END { exit !found }'; then
            pactl unload-module "$audio_mod" >/dev/null 2>&1 || true
        fi
        # Ne restaurer le défaut que s'il est ENCORE le nôtre : sinon on écraserait
        # celui d'une connexion plus récente (c'était exactement le bug du son).
        if [ -n "$prev_sink" ] &&
            [ "$(pactl get-default-sink 2>/dev/null)" = "$sink_name" ]; then
            pactl set-default-sink "$prev_sink" >/dev/null 2>&1 || true
        fi
    }
    if command -v pactl >/dev/null 2>&1; then
        # Le défaut AVANT tout, sinon on mémoriserait le puits orphelin qu'on
        # s'apprête à retirer et on le restaurerait à la sortie.
        prev_sink="$(pactl get-default-sink 2>/dev/null || true)"
        drop_stale_tunnels
        # Un gremote-* (même le nôtre) n'est jamais un défaut à restaurer.
        case "$prev_sink" in gremote-*) prev_sink="" ;; esac
        ensure_local_sink
    fi
    if [ -n "${GREMOTE_AUDIO_SOCK:-}" ] && command -v pactl >/dev/null 2>&1; then
        # Le -R vit sur une connexion SSH SÉPARÉE de celle du tunnel RDP : à
        # l'instant où cette commande démarre, le socket peut ne pas encore
        # exister ici. On l'attend (5 s) — module-tunnel-sink échoue net sur un
        # socket absent (« Connexion refusée ») et la session restait muette.
        for _ in $(seq 1 50); do
            [ -S "$GREMOTE_AUDIO_SOCK" ] && break
            sleep 0.1
        done
    fi
    if [ -n "${GREMOTE_AUDIO_SOCK:-}" ] && [ -S "${GREMOTE_AUDIO_SOCK:-/nonexistent}" ] &&
        command -v pactl >/dev/null 2>&1; then
        audio_mod="$(pactl load-module module-tunnel-sink \
            server="unix:$GREMOTE_AUDIO_SOCK" sink_name="$sink_name" \
            latency_msec="$AUDIO_LATENCY_MSEC" 2>/dev/null || true)"
        # PipeWire d'une image antérieure dont le module ignore `latency_msec` :
        # mieux vaut un son saccadé qu'aucun son, on recharge sans le tampon.
        if [ -z "$audio_mod" ]; then
            audio_mod="$(pactl load-module module-tunnel-sink \
                server="unix:$GREMOTE_AUDIO_SOCK" sink_name="$sink_name" 2>/dev/null || true)"
        fi
        if [ -n "$audio_mod" ]; then
            # Le puits est enregistré de façon asynchrone : un set-default-sink
            # immédiat échoue en « Aucune entité de ce type » — et comme on
            # avale stderr, la session restait sans son (vécu 02/11/2026).
            sock_ok=0
            for _ in $(seq 1 40); do
                if pactl list short sinks 2>/dev/null |
                    awk -v n="$sink_name" '$2 == n { found = 1 } END { exit !found }'; then
                    if pactl set-default-sink "$sink_name" >/dev/null 2>&1 &&
                        [ "$(pactl get-default-sink 2>/dev/null)" = "$sink_name" ]; then
                        sock_ok=1
                        break
                    fi
                fi
                sleep 0.25
            done
            [ "$sock_ok" -eq 1 ] ||
                printf 'gremote : le puits audio « %s » n'"'"'a pas pu être mis par défaut\n' \
                    "$sink_name" >&2
        else
            audio_mod=""
            printf 'gremote : puits audio tunnel indisponible, son local\n' >&2
        fi
    fi

    # Mode RDP. RemoteAccess fabrique un écran virtuel et bascule le siège sur le
    # greeter : parfait pour une session physique, mais sur la session que
    # gremote crée lui-même (VT3, souvent inactive) la création de ce moniteur
    # virtuel **échoue** et KRdp referme la connexion aussitôt — le client voit
    # « connection reset by peer » après l'authentification (vécu 02/11/2026).
    # SharedAccess capture la sortie réelle des fenêtres de session : c'est ce
    # qu'on veut ici, et il streame effectivement (VA-API actif pendant le test).
    # SharedAccess capture la sortie réelle du compositeur. RemoteAccess fabrique
    # un moniteur virtuel : sur une session hors écran il n'est jamais rempli et
    # le client reçoit du noir, voire un reset (mesuré 02/11/2026 : SharedAccess
    # encode, RemoteAccess non).
    rdp_mode=SharedAccess

    command -v krdpserver >/dev/null 2>&1 ||
        die "krdpserver absent sur l'hôte (paquet krdp)"

    # Réparation du shell Plasma avant de streamer. Quand la session est
    # redémarrée alors que le gestionnaire utilisateur persiste, celui-ci n'a pas
    # WAYLAND_DISPLAY : plasmashell cherche wayland-0, KWin expose wayland-1,
    # il abandonne (« Failed to create wl_display ») et le client reçoit un bureau
    # noir alors que KWin, lui, tourne (vécu 02/11/2026). On remet la variable et
    # on relance le shell s'il a échoué.
    if command -v systemctl >/dev/null 2>&1; then
        _sock="$(ls "$run_dir" 2>/dev/null | grep -m1 -E '^wayland-[0-9]+$' || true)"
        if [ -n "$_sock" ]; then
            _uctl() {
                DBUS_SESSION_BUS_ADDRESS="unix:path=$run_dir/bus" \
                    systemctl --user "$@" >/dev/null 2>&1
            }
            _uctl set-environment WAYLAND_DISPLAY="$_sock" || true
            if [ "$(DBUS_SESSION_BUS_ADDRESS="unix:path=$run_dir/bus" \
                    systemctl --user is-active plasma-plasmashell 2>/dev/null)" != active ] &&
                [ "$(DBUS_SESSION_BUS_ADDRESS="unix:path=$run_dir/bus" \
                    systemctl --user is-failed plasma-plasmashell 2>/dev/null)" = failed ]; then
                _uctl reset-failed plasma-plasmashell || true
                _uctl start plasma-plasmashell || true
                printf 'gremote : plasmashell relancé (WAYLAND_DISPLAY=%s)\n' "$_sock" >&2
            fi
        fi
    fi

    rdp_listen_port="${GREMOTE_RDP_REMOTE_PORT:-$(rdp_remote_port "$(id -un)")}"

    # Un krdpserver survivant d'une connexion précédente garde son port : le
    # nouveau ne peut pas s'y lier, et le client se connecte à l'ANCIEN avec le
    # mot de passe neuf — d'où un ERRCONNECT_LOGON_FAILURE à la deuxième
    # connexion alors que tout semble normal (vécu 02/11/2026). On le remplace :
    # ouvrir une deuxième connexion coupe donc la première, volontairement.
    replaced=0
    for pid in $(pgrep -x -u "$(id -un)" krdpserver 2>/dev/null || true); do
        kill "$pid" 2>/dev/null || true
        replaced=$((replaced + 1))
    done
    if [ "$replaced" -gt 0 ]; then
        printf 'gremote : connexion précédente coupée (serveur RDP remplacé)\n' >&2
    fi

    for _ in $(seq 1 50); do
        (exec 3<>/dev/tcp/127.0.0.1/"$rdp_listen_port") 2>/dev/null || break
        sleep 0.1
    done

    krdpserver --address 127.0.0.1 --port "$rdp_listen_port" \
        --username "${GREMOTE_RDP_USER:-$USER}" --password "$rdp_pass" \
        --mode "$rdp_mode" --plasma \
        "${rdp_quality_args[@]}" \
        --certificate "$cert_dir/cert.pem" \
        --certificate-key "$cert_dir/key.pem" &
    srv_pid=$!
    trap 'kill "$srv_pid" 2>/dev/null || true; cleanup_rdp' EXIT INT TERM

    # Poignée de main : le client attend cette ligne avant de lancer son client
    # RDP. Un test de port côté client ne prouve RIEN : un -L ssh accepte la
    # connexion TCP puis échoue en « channel 2: open failed: Connection refused »
    # quand le distant n'écoute pas encore (vécu 02/11/2026).
    up=0
    for _ in $(seq 1 150); do
        if (exec 3<>/dev/tcp/127.0.0.1/"$rdp_listen_port") 2>/dev/null; then
            up=1
            break
        fi
        kill -0 "$srv_pid" 2>/dev/null || break
        sleep 0.2
    done
    [ "$up" -eq 1 ] ||
        die "krdpserver n'écoute pas sur 127.0.0.1:${rdp_listen_port} (port déjà pris par un autre service ?)"
    printf 'GREMOTE-RDP-READY %s %s\n' "$rdp_listen_port" "$session_kind"
    wait "$srv_pid"
    exit 0
fi

# =============================================================================
# SECTION 5 : MODE CLIENT — VÉRIFICATIONS LOCALES
# =============================================================================

[ -n "$TARGET" ] || { usage; exit 1; }

command -v ssh >/dev/null 2>&1 || die "ssh absent sur ce poste"

# =============================================================================
# SECTION 7 : MODE CLIENT — LANCEMENT
# =============================================================================

# Audio : KRdp ne transporte pas le son. On transfère donc par SSH les sockets
# PipeWire/Pulse de CE poste vers l'hôte : les applications distantes jouent
# directement sur les haut-parleurs d'ici, sans port ouvert ni service en plus.
# Deux -R : Pulse (cas normal, pipewire-pulse) et PipeWire natif (clients qui
# parlent le protocole natif). Condition côté sshd distant :
# AllowStreamLocalForwarding.
# Le chemin local des sockets n'existe pas sur l'hôte : on transfère vers un
# socket neuf sous /tmp, dont le nom porte l'uid et le PID du client. Ces -R
# vivent sur leur PROPRE connexion SSH (voir plus bas), pas sur celle du -L.
ssh_args=()
# Port SSH explicite (-p ou « hôte:port »). Sans lui on ne passe RIEN : ssh
# applique ~/.ssh/config puis 22, alors qu'un « -p 22 » écraserait un Port
# déjà défini pour cet hôte.
if [ -n "$SSH_PORT" ]; then
    ssh_args+=(-p "$SSH_PORT")
fi
audio_args=()
audio_env=()
[ "$DEBUG" -eq 1 ] && audio_env+=("GREMOTE_DEBUG=1")
if [ "$AUDIO" -eq 1 ]; then
    run_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    if [ -S "$run_dir/pulse/native" ]; then
        # Nom unique (uid + PID) : sshd laisse le socket en place à la
        # déconnexion, et refuse de réécouter sur un chemin existant — « remote
        # port forwarding failed », donc plus de son à la 2e session avec un
        # chemin fixe (vécu 01/11/2026). L'option -o StreamLocalBindUnlink ne
        # règle rien ici : pour un -R c'est le sshd distant qui décide.
        pulse_sock="/tmp/gremote-pulse-$(id -u)-$$.sock"
        audio_args+=(-R "${pulse_sock}:${run_dir}/pulse/native")
        audio_env+=("PULSE_SERVER=unix:${pulse_sock}")
        if [ -S "$run_dir/pipewire-0" ]; then
            pw_sock="/tmp/gremote-pw-$(id -u)-$$.sock"
            audio_args+=(-R "${pw_sock}:${run_dir}/pipewire-0")
            audio_env+=("PIPEWIRE_REMOTE=${pw_sock}")
        fi
    else
        printf 'gremote : aucun PipeWire local (%s/pulse/native), audio désactivé\n' \
            "$run_dir" >&2
    fi
fi
# Le son a SA PROPRE connexion SSH (au lieu de partager celle du -L RDP) : dans
# un seul TCP, chaque rafale d'image bloque le PCM derrière elle et chaque
# segment perdu retarde l'audio d'un aller-retour — d'où les saccades sur un
# lien qui jitte (mesuré 13/11/2026 : RTT 58 ms, pics à 197 ms sur le Wi-Fi de
# l'hôte, tampon du tunnel 25 ms). `-C` compresse le PCM (~1,3-1,5×, CPU
# négligeable) et reste réservé à cette connexion : zlib ne gagne rien sur le
# H.264 du tunnel RDP.

# ---------------------------------------------------------------------------
# Mode RDP : tout passe par SSH. Le -L n'expose RDP que sur 127.0.0.1 du poste
# local, le -R porte le son du poste vers l'hôte (sur sa connexion dédiée), et
# le mot de passe RDP est tiré au hasard à chaque session puis jeté. Aucun port
# ouvert sur le réseau.
# ---------------------------------------------------------------------------
if [ "$RDP" -eq 1 ]; then
    rdp_user="${TARGET%%@*}"
    # Cible sans « @ » (ex. `gremote sucina:2323`) : ssh se connecte avec le nom
    # local, donc l'utilisateur RDP est le même — sans ce repli, krdpserver
    # recevait « sucina » comme nom de compte et refusait la connexion.
    [[ "$TARGET" == *@* ]] || rdp_user="${USER:-$(id -un)}"
    rdp_pass="$(head -c 200 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | cut -c1-20)"
    [ -n "$rdp_pass" ] || die "génération du mot de passe RDP impossible"

    rdp_remote_port_num="$(rdp_remote_port "$rdp_user")"

    # Port LOCAL du tunnel : 13389 est un défaut, pas une contrainte. Deux
    # sessions en parallèle depuis le même poste (deux comptes « côte à côte »)
    # se disputaient 13389 et la deuxième échouait sur « bind [127.0.0.1]:13389:
    # Address already in use » avant même d'atteindre l'hôte (vécu 02/11/2026).
    # On prend le premier port libre à partir du défaut ; --rdp-port reste
    # prioritaire quand il est donné.
    if [ "$RDP_PORT_SET" -eq 0 ]; then
        for _p in $(seq "$RDP_PORT" $((RDP_PORT + 20))); do
            if ! (exec 3<>"/dev/tcp/127.0.0.1/$_p") 2>/dev/null; then
                RDP_PORT="$_p"
                break
            fi
        done
    fi
    ssh_args+=(-o ExitOnForwardFailure=yes -L "127.0.0.1:${RDP_PORT}:127.0.0.1:${rdp_remote_port_num}")
    remote_cmd=(env "GREMOTE_AUDIO_SOCK=${pulse_sock:-}" "GREMOTE_RDP_USER=${rdp_user}")
    if [ "$NOSTART" -eq 1 ]; then
        remote_cmd+=("GREMOTE_NO_START=1")
    fi
    # GREMOTE_REMOTE_BIN : chemin ABSOLU d'un gremote plus récent sur l'hôte.
    # Sert à tester avant que l'image ne soit construite et déployée : un ssh non
    # interactif ne lit pas /etc/profile.d, donc il résout `gremote` vers
    # /usr/bin/gremote de l'image, qui peut être en retard. Sans cette variable,
    # le comportement est inchangé (résolution par le PATH de sshd).
    remote_cmd+=("${GREMOTE_REMOTE_BIN:-gremote}" --serve --rdp "${rdp_remote_quality_args[@]}")

    # Une seule sortie pour tout : la connexion audio vit déjà au moment où le
    # client RDP démarre.
    client_cleanup() {
        if [ -n "${ssh_pid:-}" ]; then kill "$ssh_pid" 2>/dev/null || true; fi
        if [ -n "${audio_ssh_pid:-}" ]; then kill "$audio_ssh_pid" 2>/dev/null || true; fi
        if [ -n "${rdp_log:-}" ]; then rm -f "$rdp_log"; fi
        if [ -n "${audio_log:-}" ]; then rm -f "$audio_log"; fi
        return 0
    }

    if [ "$DRY_RUN" -eq 1 ]; then
        if [ "${#audio_args[@]}" -gt 0 ]; then
            printf 'ssh -N -C -o ExitOnForwardFailure=yes'
            if [ -n "$SSH_PORT" ]; then printf ' -p %s' "$SSH_PORT"; fi
            for arg in "${audio_args[@]}"; do printf ' %s' "$arg"; done
            printf ' %s\n' "$TARGET"
        fi
        printf 'ssh'
        for arg in ${ssh_args[@]+"${ssh_args[@]}"}; do printf ' %s' "$arg"; done
        printf ' %s' "$TARGET"
        for arg in "${remote_cmd[@]}"; do printf ' %s' "$arg"; done
        printf '   (mot de passe RDP sur stdin)\n'
        exit 0
    fi

    # Tunnel audio : connexion SSH dédiée, montée AVANT la principale pour que
    # le socket existe quand le serveur crée son puits (il l'attend 5 s de son
    # côté). stdin sur /dev/null : le mot de passe RDP passe par celui du ssh
    # principal. `-N` : aucune commande distante, seulement les -R.
    audio_ssh_pid=""
    audio_log=""
    if [ "${#audio_args[@]}" -gt 0 ]; then
        audio_ssh_opts=(-N -C -o ExitOnForwardFailure=yes)
        if [ -n "$SSH_PORT" ]; then
            audio_ssh_opts+=(-p "$SSH_PORT")
        fi
        audio_log="$(mktemp "${TMPDIR:-/tmp}/gremote-audio.XXXXXX")"
        ssh "${audio_ssh_opts[@]}" "${audio_args[@]}" "$TARGET" \
            </dev/null >"$audio_log" 2>&1 &
        audio_ssh_pid=$!
    fi
    trap client_cleanup EXIT INT TERM HUP

    # La sortie du ssh sert de canal de contrôle : le serveur y écrit
    # GREMOTE-RDP-READY quand krdpserver écoute vraiment (le certificat est
    # créé au premier lancement, ça prend une à deux secondes).
    rdp_log="$(mktemp "${TMPDIR:-/tmp}/gremote-rdp.XXXXXX")"
    printf '%s\n' "$rdp_pass" |
        ssh ${ssh_args[@]+"${ssh_args[@]}"} "$TARGET" "${remote_cmd[@]}" >"$rdp_log" 2>&1 &
    ssh_pid=$!

    ready=0
    for _ in $(seq 1 300); do
        if grep -q '^GREMOTE-RDP-READY' "$rdp_log" 2>/dev/null; then
            ready=1
            break
        fi
        kill -0 "$ssh_pid" 2>/dev/null || break
        sleep 0.2
    done
    if [ "$ready" -ne 1 ]; then
        sed -n '1,12p' "$rdp_log" >&2 2>/dev/null || true
        die "le serveur RDP de $TARGET n'a pas démarré (voir ci-dessus)"
    fi

    # Tunnel audio mort tout de suite (clé refusée, forwarding de socket
    # interdit par le sshd distant) : l'hôte a attendu le socket puis joué en
    # local, et le client n'en savait rien. On le dit, une fois.
    if [ -n "$audio_ssh_pid" ] && ! kill -0 "$audio_ssh_pid" 2>/dev/null; then
        printf 'gremote : tunnel audio interrompu — le son reste sur %s\n' "$TARGET" >&2
        sed -n '1,3p' "$audio_log" >&2 2>/dev/null || true
        audio_ssh_pid=""
    fi


    # Type de session annoncé par l'hôte (3e champ de la poignée de main) :
    # « physical » = bureau réel déjà ouvert, « virtual » = session créée hors
    # écran par gremote (l'hôte le sait par la sortie virtuelle de KWin). Un
    # hôte d'une image antérieure n'envoie que le port : le type est alors
    # DÉDUIT d'une seconde connexion SSH (une seule, et seulement dans ce cas) —
    # c'est la règle de CETTE image-là (socket `gremote-session`), reproduite
    # telle quelle plutôt qu'une autre inventée ici ; à cet instant krdpserver
    # écoute déjà, donc la session est en place. Deviner « physique » à
    # l'aveugle privait un bureau virtuel du suivi de fenêtre (vécu 09/11/2026 :
    # hôte encore en 20261106) ; deviner « virtuelle » coupait
    # un bureau physique (06/11/2026). Réponse impossible (pas de clé SSH non
    # interactive, réseau) → physique : un bureau entier en petit vaut mieux
    # qu'un bureau coupé.
    rdp_kind="$(awk '/^GREMOTE-RDP-READY/ { print $3; exit }' "$rdp_log" 2>/dev/null || true)"
    case "$rdp_kind" in
        physical|virtual) ;;
        *)
            rdp_kind=physical
            kind_probe_args=(-o BatchMode=yes -o ConnectTimeout=5)
            if [ -n "$SSH_PORT" ]; then
                kind_probe_args+=(-p "$SSH_PORT")
            fi
            # XDG_RUNTIME_DIR est celui de la session PAM de l'utilisateur ;
            # son absence (compte sans session) ne peut pas arriver ici, le
            # serveur vient de trouver un compositeur.
            kind_probe="$(ssh "${kind_probe_args[@]}" "$TARGET" \
                'if [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gremote-session" ]; then echo virtual; else echo physical; fi' \
                </dev/null 2>/dev/null || true)"
            case "$kind_probe" in
                virtual|physical) rdp_kind="$kind_probe" ;;
            esac
            ;;
    esac

    # Client RDP local : sdl-freerdp (SDL3, Wayland natif), quelle que soit la
    # session. +dynamic-resolution n'est demandé que sur une session VIRTUELLE :
    # là, la résolution du bureau distant peut suivre la fenêtre sans rien
    # casser et le texte reste net. Sur une session PHYSIQUE, la demander ferait
    # changer la résolution de l'écran réel ; le client affiche donc la sortie à
    # sa résolution, sans mise à l'échelle (fenêtre de la taille de l'écran
    # distant). L'échelle automatique et le recalage au ratio essayés avec
    # xfreerdp (+smart-sizing, xdotool/xev) ont été retirés le 14/11/2026 : la
    # fenêtre se battait contre le gestionnaire de fenêtres.
    # wlfreerdp n'est PAS utilisé : déprécié en amont (« nobody is actively
    # working on this », FreeRDP 3.32.2) au profit du client SDL3.
    # Le type est toujours connu ici (annoncé, sinon demandé à l'hôte).
    rdp_client=""
    rdp_args=()
    if command -v sdl-freerdp >/dev/null 2>&1; then
        rdp_client=sdl-freerdp
        rdp_args+=(+clipboard)
        if [ "$rdp_kind" = "virtual" ]; then
            rdp_args+=(+dynamic-resolution)
        fi
    fi

    if [ "$rdp_kind" = "virtual" ]; then
        session_label="virtuelle"
    else
        session_label="physique"
    fi

    if [ "$RDP_LAUNCH" -eq 1 ] && [ -n "$rdp_client" ]; then
        printf 'gremote : RDP tunnelisé sur 127.0.0.1:%s (utilisateur %s, session %s, client %s)\n' \
            "$RDP_PORT" "$rdp_user" "$session_label" "$rdp_client"
        # Pas de /network:<type> explicite : TOUT type explicite (lan, wan,
        # broadband, modem) fait cesser le client d'annoncer le pipeline
        # graphique exigé par KRdp, qui répond alors par un DEACTIVATE_ALL
        # immédiat — mesuré 02/11/2026 : explicit = rc 147, défaut = connecté.
        # Le profil est donc laissé en autodétection.
        #
        # Mot de passe par stdin (/from-stdin:force), jamais dans argv : la ligne
        # de commande est lisible par TOUT utilisateur local (ps), donc /p:<mdp>
        # exposait le secret pendant toute la session. Le :force fait demander le
        # mot de passe AVANT la connexion (sinon c'est le serveur qui le réclame,
        # plus tard et moins prévisible). Vérifié 02/11/2026 sur sdl-freerdp :
        # connexion complète (Remote framebuffer BGRA32, rdpgfx) sans tty.
        #
        # Le code retour du CLIENT n'est pas un échec de gremote : fermer la
        # fenêtre (ou une coupure réseau) termine la session, et sdl-freerdp
        # sort alors en 131. Sans ce `|| true`, `set -e` propageait 131 et une
        # GUI le lisait comme un plantage (vécu 04/11/2026 : dialogue d'erreur
        # à chaque fermeture d'une session pourtant réussie).
        printf '%s\n' "$rdp_pass" |
            "$rdp_client" /v:127.0.0.1:"$RDP_PORT" /u:"$rdp_user" \
                /cert:ignore /from-stdin:force "${rdp_args[@]}" &
        rdp_pid=$!
        wait "$rdp_pid" || true
    else
        # --no-launch (ou aucun client installé) : la commande affichée est
        # EXACTEMENT celle qui aurait été lancée, client et options compris.
        printf 'gremote : connecte-toi avec\n'
        printf "  printf '%%s\\\\n' '%s' | %s /v:127.0.0.1:%s /u:%s /cert:ignore /from-stdin:force" \
            "$rdp_pass" "${rdp_client:-sdl-freerdp}" "$RDP_PORT" "$rdp_user"
        for _arg in ${rdp_args[@]+"${rdp_args[@]}"}; do printf ' %s' "$_arg"; done
        printf '\n'
        wait "$ssh_pid"
    fi
    exit 0
fi
