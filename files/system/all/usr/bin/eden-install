#!/bin/bash

# Eden — coquille de compatibilité.
#
# Le téléchargement (reprise, anti-cale, contrôle ELF) et l'intégration
# GearLever vivent dans le moteur `/usr/libexec/gablue-apps`, décrit par
# `/usr/share/ublue-os/gablue/apps.toml`. Eden publie sur une instance Gitea
# (API `releases/latest`, assets `Eden-Linux-<version>-amd64-clang-pgo.AppImage`)
# et non sur GitHub : le moteur gère les deux. Ce nom reste : CLI documentée,
# sonde d'état de Gablue Manager, habitude des utilisateurs.

set -e
exec /usr/libexec/gablue-apps install eden "$@"
