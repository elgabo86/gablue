#!/usr/bin/bash

# gablue-clean — nettoyage système (partie privilégiée)
#
# Appelé par Gablue Manager avec `sudo -n` (règle sudoers exacte). Un seul
# domaine touche un magasin root :
#
#   flatpak     retire les Flatpaks système inutilisés
#
# La partie utilisateur (Podman, formules et cache Homebrew, Flatpaks du
# compte) reste au manager : ce sont d'AUTRES magasins, sur lesquels root
# n'aurait pas la main (images rootless, préfixe brew de l'utilisateur).
#
# Usage : gablue-clean flatpak

set -euo pipefail

usage() {
    echo "Usage : gablue-clean flatpak" >&2
    exit 2
}

case "${1:-}" in
    flatpak)
        echo "→ Flatpaks système inutilisés…"
        # Rien à retirer n'est pas une erreur : le code 0 est conservé.
        flatpak uninstall --unused --system -y || true
        ;;
    *)
        usage
        ;;
esac
