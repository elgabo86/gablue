#!/usr/bin/bash

# gablue-gaming-session — session « console » Gablue : KWin nu + glauncher.
#
# Lancée par plasmalogin via /usr/share/wayland-sessions/gablue-gaming.desktop.
# Pas de plasmashell : ni panneaux, ni notifications, ni Discover — l'écran
# n'appartient qu'au launcher. Les rares services de la coquille qui restent
# utiles sont démarrés ici au mieux : un service absent ne doit pas tuer la
# session.
#
# Sortie : le launcher rend la main avec le code 0 → KWin s'arrête et la
# session se termine. Un plantage est relancé par gablue-gaming-launcher.

set -uo pipefail   # jamais -e : un service absent n'est pas une panne

log() { printf 'gablue-gaming: %s\n' "$*" >&2; }

# Identité de session. Le greeter pose déjà ces variables depuis
# `DesktopNames`, on les garantit ici pour deux raisons : xdg-desktop-portal
# choisit son backend sur XDG_CURRENT_DESKTOP (sans « KDE », plus de partage
# d'écran dans les jeux), et le launcher s'en sert pour son mode console
# (lancé depuis un VT, sans greeter, il doit quand même se savoir en console).
: "${XDG_SESSION_TYPE:=wayland}"
: "${XDG_SESSION_DESKTOP:=GablueGaming}"
: "${XDG_CURRENT_DESKTOP:=GablueGaming:KDE}"
export XDG_SESSION_TYPE XDG_SESSION_DESKTOP XDG_CURRENT_DESKTOP

# Bouton power, veille, DPMS : sans powerdevil, logind applique son défaut
# (HandlePowerKey=poweroff) et le bouton ÉTEINT la machine au lieu de la
# mettre en veille. Lancé comme unité utilisateur : c'est ainsi que Plasma le
# démarre, et il a besoin de la session systemd, pas d'un fork nu.
systemctl --user start plasma-powerdevil.service 2>/dev/null \
    || log "powerdevil indisponible (bouton power au défaut de logind)"

# Curseur : il doit disparaître tout seul quand on ne touche plus rien, y
# compris sur un jeu (le launcher masque le sien, mais dans un jeu c'est le
# compositeur qui tient le pointeur). KWin embarque l'effet `hidecursor`, mais
# il n'est pas chargé par défaut : on le charge à chaud, SANS écrire `kwinrc`
# (vérifié sur 6.8.3 : `loadEffect` répond true, `unloadEffect` le retire ;
# la config de l'utilisateur n'est donc jamais modifiée). Le délai est celui
# de l'effet (~5 s) tant qu'on ne décide pas de le régler.
QDBUS=$(command -v qdbus6 || command -v qdbus || true)
if [ -n "$QDBUS" ]; then
    (
        for _ in $(seq 1 150); do   # 30 s au plus, KWin démarre en ~1 s
            "$QDBUS" org.kde.KWin /Effects >/dev/null 2>&1 && break
            sleep 0.2
        done
        "$QDBUS" org.kde.KWin /Effects \
            org.kde.kwin.Effects.loadEffect hidecursor >/dev/null 2>&1 \
            || log "effet hidecursor non chargé (curseur visible au repos)"
    ) &
else
    log "qdbus absent : curseur non masqué au repos"
fi

# Veille : en session console, elle est DÉSACTIVÉE dans tous les cas (demandé
# le 23/11) — on n'est pas devant un bureau, une console ne s'endort pas au
# milieu d'un film. Deux inhibiteurs complémentaires, tenus tant que la session
# vit (ils meurent avec elle) :
#  - logind `idle` + `handle-lid-switch` : aucune action d'inactivité, aucun
#    endormissement à la fermeture du capot ;
#  - `org.freedesktop.ScreenSaver` (le mécanisme que PowerDevil et KWin
#    écoutent, déjà utilisé par `gpad-inhibit` pour les manettes) : ni
#    extinction d'écran, ni verrouillage, ni veille automatique.
# On n'inhibe PAS `sleep` : l'entrée « MISE EN VEILLE » du menu Home doit
# rester possible (un blocage `sleep` ferait refuser `systemctl suspend`).
systemd-inhibit --what=idle:handle-lid-switch --mode=block \
    --who=gablue-gaming --why="Session console : pas de veille" \
    sleep infinity >/dev/null 2>&1 &
GPAD_INHIBIT_TOUJOURS=1 /usr/bin/gpad-inhibit >/dev/null 2>&1 &

# Overlay manette : `gablue-pad.service` est `WantedBy=graphical-session.target`,
# cible que Plasma démarre et qu'une session KWin nue NE démarre pas. Sans ce
# bloc il n'y a AUCUNE manette dans la session : pas de menu Home, donc aucune
# sortie propre (le launcher n'en expose pas en console) — seul un autre VT
# resterait. On démarre donc l'unité explicitement, avec DEUX précautions :
#
#  - un socket Wayland au nom fixe (`--socket`), pour que l'unité sache à quel
#    compositeur se connecter — sinon KWin choisit wayland-0/1 et le service
#    hérite d'un `WAYLAND_DISPLAY` absent (il ne tourne pas dans notre arbre) ;
#  - l'environnement copié dans le gestionnaire utilisateur
#    (`set-environment`), parce qu'une unité n'hérite pas du shell : c'est le
#    seul moyen de lui donner le socket et l'identité de session.
GABLUE_SOCKET=${GABLUE_SOCKET:-gablue-gaming}
export WAYLAND_DISPLAY="$GABLUE_SOCKET"
systemctl --user set-environment \
    WAYLAND_DISPLAY="$GABLUE_SOCKET" \
    XDG_CURRENT_DESKTOP="$XDG_CURRENT_DESKTOP" \
    XDG_SESSION_DESKTOP="$XDG_SESSION_DESKTOP" \
    XDG_SESSION_TYPE="$XDG_SESSION_TYPE" 2>/dev/null \
    || log "environnement de session non transmis au gestionnaire utilisateur"
(
    # KWin crée le socket en ~1 s ; 30 s au plus avant d'abandonner
    for _ in $(seq 1 150); do
        [ -S "$XDG_RUNTIME_DIR/$GABLUE_SOCKET" ] && break
        sleep 0.2
    done
    systemctl --user start gablue-pad.service 2>/dev/null \
        || log "overlay manette indisponible (aucun menu manette dans la session)"
) &

# KWin seul, en DRM, avec XWayland (beaucoup de jeux .wgp/.lgp en dépendent).
# --exit-with-session : la session meurt avec le launcher, aucun compositeur
# orphelin laissé devant un écran noir.
exec kwin_wayland --drm --xwayland --socket "$GABLUE_SOCKET" \
    --exit-with-session /usr/libexec/gablue-gaming-launcher
