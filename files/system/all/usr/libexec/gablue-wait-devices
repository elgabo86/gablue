#!/usr/bin/bash
# Attend qu'au moins un connecteur d'écran soit détecté comme connecté
# et que les périphériques d'entrée soient prêts, puis laisse un court
# délai pour les docks/HID lents. Les écrans supplémentaires arrivant
# ensuite sont gérés en hotplug par KWin. Sans écran (headless), on
# sort au timeout comme avant.
#
# TEMPORAIRE : a supprimer quand Fedora/KDE corrige le plasmalogin
# pour ne plus utiliser un settle udev aveugle de 10 secondes.
# Voir invent.kde.org/plasma/plasma-login-manager/-/commit/a8c752fe
set -e
TIMEOUT=5

for ((i=0; i<TIMEOUT*10; i++)); do
    gpu_ready=0
    for status in /sys/class/drm/card*-*/status; do
        if [ -f "$status" ] && [ "$(cat "$status")" = "connected" ]; then
            gpu_ready=1
            break
        fi
    done
    if [ "$gpu_ready" -eq 1 ] && compgen -G "/dev/input/event*" > /dev/null; then
        sleep 1
        exit 0
    fi
    sleep 0.1
done
exit 0
