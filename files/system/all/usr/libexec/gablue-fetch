#!/bin/bash

# Téléchargement d'une AppImage, avec tentatives, anti-cale et progression.
#
# Enveloppe du moteur `/usr/libexec/gablue-apps download` : les scripts restés
# en bash (esde-install, opencode2-install) gardent leur propre logique, mais
# il n'y a plus **deux** téléchargeurs. C'est ce qui donne un pourcentage réel
# à l'AppImage d'ES-DE et à celle d'OpenCode Desktop (~245 Mio) : `curl` n'a
# jamais su le fournir (fenêtres figées à « 0 % » constatées les 08/11 et
# 09/11/2026), alors que le moteur lit les octets et publie `::gablue:percent`.
#
# Pas de reprise entre deux exécutions : la destination a un nom fixe, une
# reprise pourrait coller un morceau d'une version à une autre. On la retire
# donc avant de télécharger (la reprise *dans* un même run, elle, existe dans le
# moteur). Le moteur range ses partiels à côté de la destination.
#
# Usage : gablue-fetch <url> <destination> [libellé]

set -eu

URL="$1"
DEST="$2"
LABEL="${3:-$(basename "$DEST")}"

if [ -z "$URL" ] || [ -z "$DEST" ]; then
    echo "Usage : gablue-fetch <url> <destination> [libellé]" >&2
    exit 2
fi

mkdir -p "$(dirname "$DEST")"
rm -f "$DEST" "$DEST.part"
echo "Téléchargement de $LABEL..."

exec /usr/libexec/gablue-apps download "$URL" "$DEST" --label "$LABEL"
