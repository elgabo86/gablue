#!/usr/bin/bash

# Veille radio Wi-Fi (power save) des interfaces sans fil
#
#   gablue-wifi-powersave status   état (clé=valeur, lisible sans modifier)
#   gablue-wifi-powersave off      désactiver : latence stable et gigue faible
#   gablue-wifi-powersave on       revenir au réglage par défaut (activée)
#
# Le réglage à chaud (`iw dev <iface> set power_save off`) ne survit ni au
# rechargement du pilote ni à une réactivation de connexion par NetworkManager :
# c'est donc un drop-in NM qui porte le choix (appliqué à chaque activation),
# doublé d'une application immédiate pour que l'effet soit visible tout de suite.
#
# Mesuré sur le Wi-Fi 5 GHz de gen1 (13/11/2026, signal −49 dBm) : veille active
# → RTT moyen 22-60 ms avec des pics à 197 ms et 38-43 ms de gigue ; veille
# coupée → 2,2 ms de moyenne, 2,9 ms de maximum, 0,43 ms de gigue. C'est ce qui
# faisait saccader le son de gremote (tampon du tunnel : 25 ms).

set -euo pipefail

CONF=/etc/NetworkManager/conf.d/99-gablue-wifi-powersave.conf

usage() {
    printf 'usage : gablue-wifi-powersave on|off|status\n' >&2
    exit 2
}

# Interfaces sans fil : `phy80211` (cfg80211, noyaux récents) ou `wireless`.
wireless_ifaces() {
    local dir
    for dir in /sys/class/net/*; do
        [ -e "$dir/phy80211" ] || [ -e "$dir/wireless" ] || continue
        basename "$dir"
    done
}

apply_runtime() {
    local value="$1" iface
    command -v iw >/dev/null 2>&1 || return 0
    for iface in $(wireless_ifaces); do
        iw dev "$iface" set power_save "$value" >/dev/null 2>&1 || true
    done
}

write_conf() {
    local comment="$1" value="$2"
    install -d -m 0755 /etc/NetworkManager/conf.d
    printf '# Gablue : %s (gablue-wifi-powersave)\n[connection]\nwifi.powersave = %s\n' \
        "$comment" "$value" > "$CONF.tmp"
    chmod 0644 "$CONF.tmp"
    mv -f "$CONF.tmp" "$CONF"
    # `reload conf` relit les fichiers sans couper les connexions ; le runtime
    # est déjà posé par `iw`, NM réappliquera le sien à la prochaine activation.
    if command -v nmcli >/dev/null 2>&1; then
        nmcli general reload conf >/dev/null 2>&1 || true
    fi
}

case "${1:-}" in
    status)
        config=default
        if [ -r "$CONF" ]; then
            case "$(awk -F= '/^[[:space:]]*wifi\.powersave[[:space:]]*=/ {
                    gsub(/[[:space:]]/, "", $2); print $2; exit }' "$CONF")" in
                2) config=off ;;
                3) config=on ;;
            esac
        fi
        printf 'config=%s\n' "$config"
        for iface in $(wireless_ifaces); do
            printf 'iface=%s:%s\n' "$iface" \
                "$(iw dev "$iface" get power_save 2>/dev/null | awk '{ print $3 }')"
        done
        ;;
    off)
        write_conf "veille radio désactivée — latence stable" 2
        apply_runtime off
        printf 'Veille Wi-Fi désactivée.\n'
        ;;
    on)
        write_conf "veille radio au réglage par défaut (activée)" 3
        apply_runtime on
        printf 'Veille Wi-Fi activée.\n'
        ;;
    *)
        usage
        ;;
esac
