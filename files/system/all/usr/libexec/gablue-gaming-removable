#!/usr/bin/bash

# gablue-gaming-removable — monte les disques externes de la session de jeu.
#
# Sur le bureau, plasma monte les périphériques amovibles par son propre
# service (module KDED `solid_device_automounter`) : une session console n'a
# que KWin, donc rien ne les montait. Ici : un balayage idempotent (déjà monté
# = on passe) au démarrage, puis à chaque branchement.
#
# `udisksctl monitor` est un CLIENT D-Bus (aucun privilège) : pas besoin d'être
# root, et on ne dépend pas de `udevadm monitor` (root) pour voir arriver un
# disque. `--no-user-interaction` est obligatoire : sans plasmashell il n'y a
# AUCUN agent PolicyKit dans la session, une demande d'authentification
# resterait sans réponse et le montage échouerait sans explication. Le montage
# lui-même n'en demande pas : `org.freedesktop.udisks2.filesystem-mount` a
# `allow_active=yes`, et la session console est la session active du siège.
#
# Seuls les périphériques AMOVIBLES ou HOTPLUG sont montés : un disque de
# données SATA interne (RM=0, HOTPLUG=0) n'apparaît jamais tout seul.

set -uo pipefail

log() { printf 'gablue-gaming: %s\n' "$*" >&2; }
# Surchargeables pour le banc : les stubs remplacent les vrais outils.
UDISKSCTL=${GABLUE_UDISKSCTL:-/usr/bin/udisksctl}
LSBLK=${GABLUE_LSBLK:-/usr/bin/lsblk}

# Une seule instance par session : le launcher est relancé après un plantage,
# et deux moniteurs monteraient et se disputeraient les mêmes périphériques.
RUNTIME=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
mkdir -p "$RUNTIME/gablue" 2>/dev/null
exec 9>"$RUNTIME/gablue/removable.lock" || exit 0
flock -n 9 || exit 0

monter() {
    if "$UDISKSCTL" mount -b "$1" --no-user-interaction >/dev/null 2>&1; then
        log "disque monté : $1"
    else
        log "disque non monté : $1 (système de fichiers non reconnu ou occupé ?)"
    fi
}

# Monte tout ce qui est montable : amovible/hotplug, avec un système de
# fichiers connu, pas déjà monté.
balayer() {
    local dev rm hot type fstype point
    while read -r dev rm hot type fstype point; do
        [ -n "${dev:-}" ] && [ -n "${fstype:-}" ] && [ -z "${point:-}" ] || continue
        case "$type" in part|disk) ;; *) continue ;; esac
        [ "$rm" = "1" ] || [ "$hot" = "1" ] || continue
        case "$fstype" in
            # rien à monter sans intervention : chiffrement (mot de passe),
            # swap, agrégats (RAID/LVM/ZFS) gérés par leur propre pile
            crypto_LUKS|swap|zfs_member|LVM2_member|linux_raid_member)
                log "disque ignoré ($fstype) : $dev"
                continue ;;
        esac
        monter "$dev"
    done < <("$LSBLK" -lnpo NAME,RM,HOTPLUG,TYPE,FSTYPE,MOUNTPOINT)
}

balayer

# Client D-Bus : chaque ajout de périphérique déclenche un balayage. `read`
# bloque sans coût CPU, donc le service ne réveille rien inutilement.
"$UDISKSCTL" monitor 2>/dev/null | while read -r ligne; do
    case "$ligne" in
        *"Added /org/freedesktop/UDisks2/block_devices/"*) balayer ;;
    esac
done
