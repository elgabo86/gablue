#!/usr/bin/bash

# Compilation de l'overlay manette (Rust) dans l'étape "gpad-build". Le binaire
# est déposé dans /out : l'étape finale le copie par COPY --from, donc la
# toolchain Rust (~300 Mo) n'entre jamais dans l'image.

set -eoux pipefail

# libxkbcommon-devel : en-tête/symlink de link pour la crate `xkbcommon` (table
# du clavier virtuel dérivée du keymap de la session). Le runtime de l'image
# fournit déjà libxkbcommon.so.0 (dépendance de KWin). Le nom exact est
# `libxkbcommon-devel` : `xkbcommon-devel` n'existe pas et faisait échouer
# l'étape (« No match for argument »), build GH du 20/11/2026.
dnf5 -y install cargo rust gcc libxkbcommon-devel

# --locked : Cargo.lock est dans le dépôt, la résolution ne bouge pas.
cargo build --release --locked --manifest-path /build/Cargo.toml

install -Dm755 /build/target/release/gpad /out/gpad

echo "gpad compilé : $(stat -c %s /out/gpad) octets"
