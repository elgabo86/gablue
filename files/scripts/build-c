#!/usr/bin/bash

# Script de compilation des sources C du projet
# Compile et installe les binaires C natifs pour remplacer les scripts Python gourmands en RAM
# ECHEC DU BUILD si une source est absente ou si un binaire manque apres compilation

set -eoux pipefail

# =============================================================================
# COMPILATION DES SOURCES C
# =============================================================================

# Dépendances de compilation. gcc/binutils/glibc-devel sont DÉJÀ dans l'image :
# cpuid-fault compile un module noyau avant cette étape, donc l'install est un
# no-op idempotent. Elles restent dans l'image finale, assumé : les retirer
# libère ~45 Mo compressés (gcc + en-têtes) mais supprime `gcc`/`cc` du poste
# (brew depuis source, extensions pip, modules noyau à la main) — décision du
# 14/11/2026. Ne jamais ajouter pkgconf-pkg-config à une liste de retrait :
# kmod (donc systemd-udev) exige /usr/bin/pkg-config, la transaction échoue.
# zlib-ng-compat-devel, pas zlib-devel : sur fc45 `zlib-devel` n'est qu'un nom
# virtuel fourni par zlib-ng-compat-devel, mais terra-extras publie désormais un
# vrai zlib-devel (zlib 1.4) déclaré en conflit avec zlib-ng-compat déjà présent.
# Terra étant en priority 3, dnf5 le choisit et refuse la transaction
# (« conflicting requests », build du 21/11/2026 : 5 images, gpad-shot ne
# compilait plus). Le nom explicite résout toujours vers fedora, terra ou pas ;
# l'exclusion `zlib-devel*` est aussi posée côté dépôts (files/scripts/copr).
# libjpeg-turbo-devel : `gpad-shot` encode les captures en JPEG nativement
# (qualité réglable depuis l'overlay et Gablue Manager). La bibliothèque
# d'exécution est déjà dans l'image (dépendance de ffmpeg/Qt) ; seul l'en-tête
# manquait. Un convertisseur externe aurait coûté un processus par capture.
dnf5 -y install gcc dbus-devel hidapi-devel zlib-ng-compat-devel libjpeg-turbo-devel pkgconf-pkg-config

# Fonction de build securisee : compile et verifie le binaire final
build_and_verify() {
    local src_dir="$1"
    local binary="$2"
    local name="$3"

    if [ ! -d "$src_dir" ]; then
        echo "ERREUR FATALE : sources C '$name' absentes dans $src_dir" >&2
        exit 1
    fi

    make -C "$src_dir" install DESTDIR=
    rm -rf "$src_dir"

    if [ ! -f "/usr/bin/$binary" ]; then
        echo "ERREUR FATALE : binaire '$binary' absent apres compilation de $name" >&2
        exit 1
    fi
    echo "OK : $binary compile et installe"
}

# gablue-pad : declencheur Home, clavier virtuel, mode souris, inhibition ecran,
# vibration, pointeur de l'ecran de connexion (gpad-login), capture d'ecran
# (gpad-shot : appel direct a KWin ScreenShot2, libdbus + zlib). L'overlay Rust (gpad)
# et le gate BPF sont compiles dans leurs propres
# etapes du Containerfile (toolchains lourdes, jamais dans l'image finale) ; le
# Makefile installe aussi l'arborescence de donnees (scripts, sons, kwin) et le
# pont du greeter (login-bridge.sh).
build_and_verify "/src/gablue-pad" "gpad-trigger" "gablue-pad"
for b in gpad-mouse gpad-inhibit gpad-rumble gpad-login gpad-shot; do
    if [ ! -f "/usr/bin/$b" ]; then
        echo "ERREUR FATALE : binaire '$b' absent apres compilation de gablue-pad" >&2
        exit 1
    fi
done
if [ ! -x "/usr/libexec/gablue-pad/login-bridge.sh" ]; then
    echo "ERREUR FATALE : /usr/libexec/gablue-pad/login-bridge.sh absent" >&2
    exit 1
fi
# Scripts de donnees = la liste DATA du Makefile de gablue-pad. Un fichier
# ajoute la-bas mais oublie dans les COPY explicites du Containerfile fait
# echouer `make install` sur un `cp: cannot stat` ; ici le manquant est nomme.
for s in recorder.sh replay.sh screenshot.sh vrr.sh mangohud.sh booster.sh \
         session-start.sh; do
    if [ ! -x "/usr/libexec/gablue-pad/${s}" ]; then
        echo "ERREUR FATALE : /usr/libexec/gablue-pad/${s} absent apres compilation de gablue-pad" >&2
        exit 1
    fi
done
if [ ! -d "/usr/libexec/gablue-pad/kwin" ]; then
    echo "ERREUR FATALE : donnees de gablue-pad absentes de /usr/libexec/gablue-pad" >&2
    exit 1
fi
echo "OK : gablue-pad (7 binaires + scripts/sons/kwin)"

build_and_verify "/src/ds2xbox" "ds2xbox" "ds2xbox"
build_and_verify "/src/gablue-dualsense" "gablue-dualsense-ctl" "gablue-dualsense"
build_and_verify "/src/gablue-isomount" "gablue-isomount" "gablue-isomount"

# Compilation du hook composefs-fix (correction espace libre Dolphin)
# Necessite gcc, présent dans l'image (voir l'install ci-dessus)
if [ -d /src/composefs-fix ]; then
    make -C /src/composefs-fix install
    rm -rf /src/composefs-fix
    if [ ! -f /usr/lib64/gablue-composefs-fix.so ]; then
        echo "ERREUR FATALE : echec de compilation de gablue-composefs-fix.so" >&2
        exit 1
    fi
fi

# Nettoyage du repertoire sources si vide
rmdir /src 2>/dev/null || true
