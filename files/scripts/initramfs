#!/usr/bin/bash

# Tell this script to exit if there are any errors.
# You should have this in every custom script, to ensure that your completed
# builds actually ran successfully without any errors!
set -ouex pipefail

echo "::group::Executing initramfs"

if [[ "${KERNEL_FLAVOR:-}" == "surface" ]]; then
    KERNEL_SUFFIX="surface"
else
    KERNEL_SUFFIX=""
fi

# Find the kernel version we just installed using dnf5 repoquery (Bazzite pattern)
QUALIFIED_KERNEL="$(dnf5 repoquery --installed --queryformat='%{evr}.%{arch}' "kernel${KERNEL_SUFFIX:+-${KERNEL_SUFFIX}}")"
INITRAMFS="/usr/lib/modules/${QUALIFIED_KERNEL}/initramfs.img"

# Initramfs reproductible (Bazzite 0339b418, repris d'Aurora) : dracut embarque
# /usr/lib/os-release, dont VERSION/OSTREE_VERSION portent la date du build et
# PRETTY_NAME le numéro de build Gablue (`Gablue 45.20261122.23`) → l'initramfs
# changeait à CHAQUE build, donc chaque mise à jour réécrivait cette couche
# (~50 Mo) même sans nouveau kernel. Les clés sont retirées le temps de dracut
# puis restaurées via une copie temporaire (préserve les permissions).
# DRACUT_NO_XATTR : les xattrs du build n'entrent pas dans l'archive.
OS_RELEASE="/usr/lib/os-release"
TMP_OS_RELEASE=$(mktemp --tmpdir 'os-release-XXXXXXXXXX')
cp "${OS_RELEASE}" "${TMP_OS_RELEASE}"
sed -Ei -e '/^((OSTREE_)?(IMAGE_)?VERSION|PRETTY_NAME|BUILD_ID)=/d' "${OS_RELEASE}"

DRACUT_NO_XATTR=1 /usr/bin/dracut --no-hostonly --kver "$QUALIFIED_KERNEL" --reproducible --zstd -v --add ostree --add fido2 -f "${INITRAMFS}"

cp "${TMP_OS_RELEASE}" "${OS_RELEASE}"
rm "${TMP_OS_RELEASE}"

chmod 0600 "${INITRAMFS}"

echo "::endgroup::"
