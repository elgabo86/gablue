#!/usr/bin/bash

set -eoux pipefail

dnf5 config-manager setopt keepcache=0
rm -rf /tmp/* || true
find /var/* -maxdepth 0 -type d \! -name cache -exec rm -fr {} \;
mkdir -p /var/tmp
chmod -R 1777 /var/tmp

# Migration des entrées de /etc/{passwd,group} vers /usr/lib/{passwd,group}
# (aligné Bazzite commit 5b1a399 — fix "plugdev" : nettoie aussi shadow/gshadow
# et fait échouer le build si une entrée n'a pas persisté)
relocate_accounts() {
    local etc="$1" lib="$2" shadow="$3" keep="$4" reset="$5"
    local out line name

    [ -f "$etc" ] || return 0
    out=$(grep -vE -- "$keep" "$etc") || true
    [ -n "$out" ] || return 0

    echo
    echo "Déplacement des entrées suivantes de ${etc} vers ${lib}"
    echo "$out"

    { cat "$lib" 2>/dev/null || true; echo "$out"; } > "${lib}.new"
    mv -f "${lib}.new" "$lib"

    # Fail the build rather than ship an image where these went missing.
    while IFS= read -r line; do
        if ! grep -qxF -- "$line" "$lib"; then
            echo "ERROR: '${line}' n'a pas persisté dans ${lib}" >&2
            return 1
        fi
    done <<< "$out"

    printf '%s\n' "$reset" > "$etc"

    if [ -f "$shadow" ]; then
        while IFS= read -r line; do
            name="${line%%:*}"
            sed -i "/^${name}:/d" "$shadow"
        done <<< "$out"
    fi
}

relocate_accounts /etc/passwd /usr/lib/passwd /etc/shadow \
    'root' 'root:x:0:0:root:/root:/bin/bash'
relocate_accounts /etc/group /usr/lib/group /etc/gshadow \
    'root|wheel' 'root:x:0:
wheel:x:10:'

# Supprimer les fichiers de verrou créés par les processus conteneurs
rm -rf \
    /etc/.pwd.lock \
    /etc/passwd- \
    /etc/group- \
    /etc/shadow- \
    /etc/gshadow- \
    /etc/subuid- \
    /etc/subgid-

# Nettoyage /usr/etc créé par les paquets ublue-os-* (refusé par bootc lint)
test -f /usr/etc/containers/policy.json && \
    mv /usr/etc/containers/policy.json /etc/containers/policy.json || true
rm -rf /usr/etc
