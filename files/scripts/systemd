#!/usr/bin/bash

# Activation des services systemd pour Gablue

set -eoux pipefail

# =============================================================================
# SERVICES DE BASE
# =============================================================================

# Désactivation de services potentiellement absents de la base image :
# displaylink n'y est plus installé depuis le rebuild libevdi akmods-extra
# 1.15.1-3 (10/2026), qui ne tire plus la dépendance depuis fedora-multimedia.
# Pattern Bazzite (titanoboa_hook_postrootfs) : disable seulement si l'unité
# existe — un disable sous set -e sur une unité absente casse le build.
for svc in scx_loader.service tailscaled.service displaylink.service; do
    if systemctl list-unit-files "$svc" > /dev/null 2>&1; then
        systemctl disable -f "$svc"
    fi
done
mkdir -p /etc/systemd/system/NetworkManager-wait-online.service.d
cat > /etc/systemd/system/NetworkManager-wait-online.service.d/override.conf << 'EOF'
[Service]
Type=oneshot
ExecStart=
ExecStart=/bin/true
EOF

systemctl mask systemd-remount-fs.service

# Empecher la réactivation du remote Fedora Flatpak (ajoute au premier boot
# ce que le kickstart Anaconda a supprime pendant l'install)
systemctl mask flatpak-add-fedora-repos.service

# Mises à jour automatiques DÉSACTIVÉES par défaut : c'est l'utilisateur qui
# choisit, dans Gablue Manager, les domaines (image, Flatpaks, brew) et le
# rythme (quotidien / hebdomadaire). La base Fedora active les timers par
# preset ; on retire explicitement les liens pour que l'image livrée n'en
# active aucun. `gablue-auto-update` les rebranche à la demande.
for timer in rpm-ostreed-automatic.timer flatpak-system-update.timer \
             brew-update.timer brew-upgrade.timer; do
    if systemctl list-unit-files "$timer" > /dev/null 2>&1; then
        systemctl disable "$timer"
    fi
done
if systemctl list-unit-files flatpak-user-update.timer > /dev/null 2>&1; then
    systemctl --global disable flatpak-user-update.timer
fi

# Optimisation réseau automatique via eBPF (aligné Bazzite c9494204)
systemctl enable bpftune.service

# Services supplémentaires pour le mode DX
if [ "${DX_MODE:-false}" == "true" ]; then
    systemctl enable -f ublue-os-libvirt-workarounds.service
    systemctl enable -f gablue-dx-groups.service
    systemctl enable -f incus-workaround.service
fi

# Brew : activation du service d'extraction du tarball embarqué
# (/usr/share/homebrew.tar.zst -> /home/linuxbrew, ConditionPathExists=!/etc/.linuxbrew)
# (les timers brew, eux, sont livrés désactivés comme les autres mises à jour
# automatiques ; voir le bloc plus haut).
# Le preset 01-homebrew.preset (enable brew-setup.service) n'est PAS appliqué
# aux déploiements bootc/ostree (les presets systemd ne sont évalués qu'à
# l'installation de RPMs, pas au déploiement d'une image container) : sans cet
# enable explicite, brew n'est jamais extrait au premier boot et tout script
# dépendant de brew (opencode2-install...) échoue sur les installations
# fraîches (même bug Bazzite #3788/#3817, corrigé de la même façon upstream).
systemctl enable brew-setup.service

# Services HDMI-CEC pour contrôle TV
systemctl enable cec-poweroff-tv.service
systemctl enable cec-active-source.timer

# Mémoire et CPU : activation des services dmemcg-booster
systemctl enable dmemcg-booster-system.service
systemctl --global enable dmemcg-booster-user.service
